index a61aa32965d..9ae00d88064 100644
--- a/src/panfrost/libpan/draw_helper.cl
+++ b/src/panfrost/libpan/draw_helper.cl
@@ -71,6 +71,94 @@ panlib_update_prims_generated_query_indirect(
