+#if PAN_ARCH == 9
+/* On Valhall behind the Job Manager, an indirect draw is a MALLOC_VERTEX job
+ * that this kernel patches with the parameters read from the indirect
+ * buffer before the job runs. When there is nothing to draw, the job becomes
+ * a NULL job.
+ *
+ * cmd is a VkDrawIndirectCommand, or a VkDrawIndexedIndirectCommand when
+ * index_size is not zero. The first instance is folded into the offset of the
+ * instance-rate attributes listed in instance_attribs: attrib_info holds the
+ * (offset, binding stride) pair of each attribute, and the offset is
+ * recomputed from it so that running the same job again gives the same
+ * result. Sysvals the shader doesn't use point to the memory sink.
+ */
+KERNEL(1)
+panlib_patch_malloc_vertex_job(global uint8_t *job, constant uint32_t *cmd,
+                               uint64_t index_buffer,
+                               global struct mali_attribute_packed *attribs,
+                               constant uint32_t *attrib_info,
+                               global int32_t *first_vertex_sysval,
+                               global uint32_t *base_instance_sysval,
+                               uint32_t instance_attribs, uint32_t index_size)
+{
+   const bool indexed = index_size != 0;
+   const uint32_t count = cmd[0];
+   const uint32_t instance_count = cmd[1];
+   const uint32_t first_index = indexed ? cmd[2] : 0;
+   const int32_t vertex_offset = indexed ? (int32_t)cmd[3] : (int32_t)cmd[2];
+   const uint32_t first_instance = indexed ? cmd[4] : cmd[3];
+   const bool is_null = count == 0 || instance_count == 0;
+
+   global struct mali_job_header_packed *header =
+      (global struct mali_job_header_packed *)job;
+   pan_unpack(header, JOB_HEADER, unpacked_header)
+      ;
+   pan_pack(header, JOB_HEADER, cfg) {
+      memcpy(&cfg, &unpacked_header, sizeof(cfg));
+      cfg.type = is_null ? MALI_JOB_TYPE_NULL : MALI_JOB_TYPE_MALLOC_VERTEX;
+   }
+
+   if (is_null)
+      return;
+
+   global struct mali_primitive_packed *prim =
+      (global struct mali_primitive_packed *)(job +
+                                              pan_section_offset(
+                                                 MALLOC_VERTEX_JOB, PRIMITIVE));
+   pan_unpack(prim, PRIMITIVE, unpacked_prim)
+      ;
+   pan_pack(prim, PRIMITIVE, cfg) {
+      memcpy(&cfg, &unpacked_prim, sizeof(cfg));
+      cfg.index_count = count;
+      cfg.base_vertex_offset = vertex_offset;
+   }
+
+   pan_pack((global struct mali_count_packed *)(job + pan_section_offset(
+                                                         MALLOC_VERTEX_JOB,
+                                                         INSTANCE_COUNT)),
+            COUNT, cfg) {
+      cfg.count = instance_count;
+   }
+
+   if (indexed) {
+      pan_pack((global struct mali_indices_packed *)(job + pan_section_offset(
+                                                              MALLOC_VERTEX_JOB,
+                                                              INDICES)),
+               INDICES, cfg) {
+         cfg.address = index_buffer + (uint64_t)first_index * index_size;
+      }
+   }
+
+   *first_vertex_sysval = vertex_offset;
+   *base_instance_sysval = first_instance;
+
+   uint32_t attrib_count = util_last_bit(instance_attribs);
+   for (uint32_t i = 0; i < attrib_count; i++) {
+      if (!(instance_attribs & BITFIELD_BIT(i)))
+         continue;
+
+      pan_unpack(&attribs[i], ATTRIBUTE, unpacked_attrib)
+         ;
+      pan_pack(&attribs[i], ATTRIBUTE, cfg) {
+         memcpy(&cfg, &unpacked_attrib, sizeof(cfg));
+         cfg.offset = attrib_info[2 * i] + first_instance * attrib_info[2 * i + 1];
+      }
+   }
+}
+#endif
+
