# Forked from Alpine for a local patch (Nura on the Pixel 6): Mint Mobile
# SIMs report operator ID 310240, which the Mint entry lacked, so mmsd-tng
# could not find its MMSC. 9999 keeps Alpine from replacing it; rebase by
# hand when Alpine moves on.
# Contributor: Francesco Colista <fcolista@alpinelinux.org>
maintainer="Achill Gilgenast <achill@achill.org>"
pkgname=mobile-broadband-provider-info
_pkgver=20251101
pkgver=9999$_pkgver
pkgrel=1
pkgdesc="Mobile broadband settings for various service providers"
url="https://gitlab.gnome.org/GNOME/mobile-broadband-provider-info/"
arch="noarch"
license="CC-PDDC"
makedepends="libxml2-utils libxslt meson"
# not using the CI release process: https://gitlab.gnome.org/GNOME/mobile-broadband-provider-info/-/merge_requests/139
source="https://gitlab.gnome.org/GNOME/mobile-broadband-provider-info/-/archive/$_pkgver/mobile-broadband-provider-info-$_pkgver.tar.gz
	0001-us-Mint-Mobile-add-310-240.patch
	0002-us-Verizon-drop-vzwims-from-the-internet-APNs.patch
	"
builddir="$srcdir/mobile-broadband-provider-info-$_pkgver"
#source="https://download.gnome.org/sources/mobile-broadband-provider-info/$pkgver/mobile-broadband-provider-info-$pkgver.tar.xz"

build() {
	abuild-meson . output
	meson compile -C output
}

check() {
	meson test -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

