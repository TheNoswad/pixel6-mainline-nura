# Forked from Alpine for a local patch (Nura on the Pixel 6): match the
# MMS APN case-insensitively in the provider database lookup, so carriers
# whose modem reports e.g. "Wholesale" get their MMSC configured. 9999 keeps
# Alpine from replacing it; rebase by hand when Alpine moves on.
# Contributor: Julian P Samaroo <jpsamaroo@jpsamaroo.me>
# Maintainer: Clayton Craft <clayton@craftyguy.net>
pkgname=mmsd-tng
_pkgver=2.6.4
pkgver=9999$_pkgver
pkgrel=0
pkgdesc="daemon for receiving and managing GSM MMS messages"
url="https://gitlab.com/kop316/mmsd"
arch="aarch64"
license="GPL-2.0-only"
# upstream was renamed mmsd-->mmsd-tng
provides="mmsd=$pkgver-r$pkgrel"
replaces="mmsd"
depends="mobile-broadband-provider-info"
makedepends="
	c-ares-dev
	dbus-dev
	glib-dev
	json-c-dev
	libphonenumber-dev
	libsoup3-dev
	mobile-broadband-provider-info
	meson
	modemmanager-dev
	"
source="
	$pkgname-$_pkgver.tar.gz::https://gitlab.com/kop316/mmsd/-/archive/$_pkgver/mmsd-$_pkgver.tar.gz
	mmsd.desktop
	systemd-service.patch
	mmsd-tng.initd
	0001-service-providers-match-the-APN-case-insensitively.patch
	"
subpackages="$pkgname-tools $pkgname-systemd $pkgname-openrc"
builddir="$srcdir/${pkgname%%-tng}-$_pkgver"

build() {
	abuild-meson \
		-Db_lto=true \
		-Dbuild-mmsctl=true \
		. output
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
	install -Dm644 "$srcdir"/mmsd.desktop \
		"$pkgdir"/etc/xdg/autostart/mmsd.desktop

	install -Dm755 \
		output/tools/create-hex-array \
		output/tools/decode-mms \
		-t "$pkgdir"/usr/bin/
	install -Dm755 "$srcdir"/mmsd-tng.initd "$pkgdir"/etc/user/init.d/mmsd-tng
}

tools() {
	pkgdesc="$pkgdesc (tools)"

	amove usr/bin/create-hex-array
	amove usr/bin/decode-mms
}

