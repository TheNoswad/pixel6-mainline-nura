+static void
+mm_broadband_modem_shannon_init (MMBroadbandModemShannon *self)
+{
+    self->priv = G_TYPE_INSTANCE_GET_PRIVATE (self, MM_TYPE_BROADBAND_MODEM_SHANNON,
+                                              MMBroadbandModemShannonPrivate);
+    self->priv->attach_pdp = SIT_PDP_IPV4V6;
+}
+
+static void
+dispose (GObject *object)
+{
+    MMBroadbandModemShannon *self = MM_BROADBAND_MODEM_SHANNON (object);
+
+    if (self->priv->registration_check_id) {
+        g_source_remove (self->priv->registration_check_id);
+        self->priv->registration_check_id = 0;
+    }
+    if (self->priv->carrier_timeout_id) {
+        g_source_remove (self->priv->carrier_timeout_id);
+        self->priv->carrier_timeout_id = 0;
+    }
+    if (self->priv->watchdog_id) {
+        g_source_remove (self->priv->watchdog_id);
+        self->priv->watchdog_id = 0;
+    }
+    if (self->priv->call_list_retry_id) {
+        g_source_remove (self->priv->call_list_retry_id);
+        self->priv->call_list_retry_id = 0;
+    }
+    g_clear_pointer (&self->priv->ims, mm_shannon_ims_free);
+    if (self->priv->carrier_task) {
+        GTask *task = g_steal_pointer (&self->priv->carrier_task);
+
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_ABORTED, "modem disposed");
+        g_object_unref (task);
+    }
+    if (self->priv->sit) {
+        if (self->priv->indication_id) {
+            g_signal_handler_disconnect (self->priv->sit, self->priv->indication_id);
+            self->priv->indication_id = 0;
+        }
+        if (self->priv->failed_id) {
+            g_signal_handler_disconnect (self->priv->sit, self->priv->failed_id);
+            self->priv->failed_id = 0;
+        }
+        mm_port_sit_close (self->priv->sit);
+        g_clear_object (&self->priv->sit);
+    }
+    G_OBJECT_CLASS (mm_broadband_modem_shannon_parent_class)->dispose (object);
+}
+
+static void
+finalize (GObject *object)
+{
+    MMBroadbandModemShannon *self = MM_BROADBAND_MODEM_SHANNON (object);
+
+    g_free (self->priv->attach_apn);
+    g_free (self->priv->ims_apn);
+    g_free (self->priv->carrier_name);
+    g_free (self->priv->carrier_path);
+    g_free (self->priv->carrier_db);
+    if (self->priv->smsc)
+        g_byte_array_unref (self->priv->smsc);
+    if (self->priv->carrier_manifest)
+        g_byte_array_unref (self->priv->carrier_manifest);
+    G_OBJECT_CLASS (mm_broadband_modem_shannon_parent_class)->finalize (object);
+}
