+GByteArray *
+mm_broadband_modem_shannon_peek_smsc (MMBroadbandModemShannon *self)
+{
+    return self->priv->smsc;
+}
+
+static void
+smsc_ready (MMBroadbandModemShannon *self,
+            GAsyncResult            *res,
+            GTask                   *task)
+{
+    g_autoptr(GBytes)  payload = NULL;
+    g_autoptr(GError)  error = NULL;
+    g_autofree gchar  *hex = NULL;
+    const guint8      *d;
+    gsize              len;
+    guint8             n;
+
+    payload = SIT_FINISH (self, res, &error);
+    d = payload ? g_bytes_get_data (payload, &len) : NULL;
+    /* RSP: u8 len + address bytes (at most 12) */
+    if (!d || len < 2 || d[0] == 0 || d[0] > SIT_SMS_SMSC_MAX || len < 1 + (gsize) d[0]) {
+        mm_obj_warn (self, "couldn't read the SMSC address: %s",
+                     error ? error->message : "empty or invalid response");
+    } else {
+        n = d[0];
+        if (self->priv->smsc)
+            g_byte_array_unref (self->priv->smsc);
+        self->priv->smsc = g_byte_array_sized_new (n + 1);
+        /* use it as is if it already carries its length byte (07 91 ...),
+         * otherwise (91 ...) prepend one */
+        if (d[1] != n - 1) {
+            if (n + 1 > SIT_SMS_SMSC_MAX) {
+                g_clear_pointer (&self->priv->smsc, g_byte_array_unref);
+                mm_obj_warn (self, "SMSC address too long");
+                goto out;
+            }
+            g_byte_array_append (self->priv->smsc, &n, 1);
+        }
+        g_byte_array_append (self->priv->smsc, d + 1, n);
+        hex = mm_utils_bin2hexstr (self->priv->smsc->data, self->priv->smsc->len);
+        mm_obj_info (self, "SMSC address: %s", hex);
+    }
+out:
+    self->priv->messaging_events_enabled = TRUE;
+    g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+sms_mem_status_ready (MMBroadbandModemShannon *self,
+                      GAsyncResult            *res,
+                      GTask                   *task)
+{
+    g_autoptr(GBytes) payload = NULL;
+    g_autoptr(GError) error = NULL;
+
+    payload = SIT_FINISH (self, res, &error);
+    if (!payload)
+        mm_obj_dbg (self, "SMS memory status not accepted: %s", error->message);
+    mm_broadband_modem_shannon_command (self, SIT_GET_SMSC_ADDR, NULL, 0, 10,
+                                        (GAsyncReadyCallback) smsc_ready, task);
+}
+
+static void
+messaging_enable_unsolicited_events (MMIfaceModemMessaging *_self,
+                                     GAsyncReadyCallback    callback,
+                                     gpointer               user_data)
+{
+    MMBroadbandModemShannon *self = MM_BROADBAND_MODEM_SHANNON (_self);
+    GTask                   *task;
+    /* SEND_SMS_MEM_STATUS: u32 1 = memory available (the RIL sends it at
+     * start), so the CP delivers anything it is holding */
+    static const guint8      req[4] = { 1, 0, 0, 0 };
+
+    task = g_task_new (self, NULL, callback, user_data);
+    mm_broadband_modem_shannon_command (self, SIT_SEND_SMS_MEM_STATUS, req, sizeof (req), 10,
+                                        (GAsyncReadyCallback) sms_mem_status_ready, task);
+}
+
+static void
+messaging_disable_unsolicited_events (MMIfaceModemMessaging *_self,
+                                      GAsyncReadyCallback    callback,
+                                      gpointer               user_data)
+{
+    MMBroadbandModemShannon *self = MM_BROADBAND_MODEM_SHANNON (_self);
+
+    self->priv->messaging_events_enabled = FALSE;
+    messaging_events_noop (_self, callback, user_data);
+}
