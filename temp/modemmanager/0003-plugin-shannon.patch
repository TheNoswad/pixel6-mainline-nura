+/*****************************************************************************/
+/* Messaging: SMS-DELIVER / STATUS-REPORT arrive in IND 0x010c / 0x010d and
+ * must be acked with SEND_SMS_ACK (tpid from the IND), or the CP keeps them
+ * and delivers them again. Nothing is stored on the device. */
+
+static void
+sms_ack_ready (MMBroadbandModemShannon *self,
+               GAsyncResult            *res)
+{
+    g_autoptr(GBytes) payload = NULL;
+    g_autoptr(GError) error = NULL;
+
+    payload = SIT_FINISH (self, res, &error);
+    if (!payload)
+        mm_obj_warn (self, "SMS ack failed: %s", error->message);
+}
+
+/* acked on the path the SMS came in: SIT, or AIMS for SMS over IMS */
+static void
+sms_ack (MMBroadbandModemShannon *self,
+         guint                    ind_id,
+         guint8                   tpid,
+         gboolean                 success,
+         guint8                   cause)
+{
+    guint8 req[MAX (SIT_SMS_ACK_PAYLOAD_LEN, SIT_AIMS_SMS_ACK_PAYLOAD_LEN)] = { 0 };
+
+    req[0] = success ? 1 : 0;
+    req[4] = tpid;
+    req[5] = success ? 0 : cause;
+    if (ind_id == SIT_IND_AIMS_NEW_SMS || ind_id == SIT_IND_AIMS_NEW_SMS_STATUS_REPORT)
+        mm_broadband_modem_shannon_command (self, SIT_AIMS_SEND_SMS_ACK, req, SIT_AIMS_SMS_ACK_PAYLOAD_LEN, 10,
+                                            (GAsyncReadyCallback) sms_ack_ready, NULL);
+    else
+        mm_broadband_modem_shannon_command (self, SIT_SEND_SMS_ACK, req, SIT_SMS_ACK_PAYLOAD_LEN, 10,
+                                            (GAsyncReadyCallback) sms_ack_ready, NULL);
+}
+
+static MMSmsPart *
+sms_part_from_ind_pdu (MMBroadbandModemShannon  *self,
+                       const guint8             *pdu,
+                       gsize                     len,
+                       GError                  **error)
+{
+    MMSmsPart          *part;
+    g_autofree guint8  *with_smsc = NULL;
+
+    /* the PDU starts with the SMSC address like the RIL's NEW_SMS one; if it
+     * does not parse that way, try it as a bare TPDU */
+    part = mm_sms_part_3gpp_new_from_binary_pdu (SMS_PART_INVALID_INDEX, pdu, len, self, FALSE, NULL);
+    if (part)
+        return part;
+    with_smsc = g_malloc (len + 1);
+    with_smsc[0] = 0;
+    memcpy (with_smsc + 1, pdu, len);
+    part = mm_sms_part_3gpp_new_from_binary_pdu (SMS_PART_INVALID_INDEX, with_smsc, len + 1, self, FALSE, error);
+    if (part)
+        mm_obj_dbg (self, "SMS PDU has no SMSC prefix");
+    return part;
+}
+
+static void
+sms_received (MMBroadbandModemShannon *self,
+              guint                    id,
+              GBytes                  *payload)
+{
+    const guint8      *d;
+    gsize              len;
+    guint8             tpid;
+    guint8             pdu_len;
+    MMSmsPart         *part;
+    g_autofree gchar  *hex = NULL;
+    g_autoptr(GError)  error = NULL;
+
+    d = g_bytes_get_data (payload, &len);
+    if (len < 2) {
+        mm_obj_warn (self, "short new SMS IND 0x%04x (%" G_GSIZE_FORMAT " bytes)", id, len);
+        return;
+    }
+    tpid = d[0];
+    pdu_len = d[1];
+    hex = mm_utils_bin2hexstr (d + 2, MIN ((gsize) pdu_len, len - 2));
+    mm_obj_dbg (self, "new SMS IND 0x%04x tpid %u len %u: %s", id, tpid, pdu_len, hex);
+
+    if (!self->priv->messaging_events_enabled) {
+        mm_obj_dbg (self, "messaging not enabled yet: leaving SMS tpid %u to the CP", tpid);
+        return;
+    }
+    if (pdu_len == 0 || len < 2 + (gsize) pdu_len) {
+        mm_obj_warn (self, "truncated new SMS IND (pdu %u, payload %" G_GSIZE_FORMAT ")", pdu_len, len);
+        sms_ack (self, id, tpid, FALSE, 0xff);
+        return;
+    }
+
+    part = sms_part_from_ind_pdu (self, d + 2, pdu_len, &error);
+    if (!part) {
+        /* TP-FCS 0xff: unspecified error */
+        mm_obj_warn (self, "couldn't parse SMS PDU %s: %s", hex, error->message);
+        sms_ack (self, id, tpid, FALSE, 0xff);
+        return;
+    }
+
+    mm_obj_info (self, "received SMS (tpid %u)", tpid);
+    if (!mm_iface_modem_messaging_take_part (MM_IFACE_MODEM_MESSAGING (self),
+                                             mm_broadband_modem_create_sms (MM_BROADBAND_MODEM (self)),
+                                             part,
+                                             MM_SMS_STATE_RECEIVED,
+                                             MM_SMS_STORAGE_MT,
+                                             &error))
+        mm_obj_warn (self, "couldn't take SMS part: %s", error->message);
+    /* acked even if the part was a duplicate or unwanted: a nack only makes
+     * the network send it again */
+    sms_ack (self, id, tpid, TRUE, 0);
+}
