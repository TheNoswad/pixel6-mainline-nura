+/*****************************************************************************/
+/* SIM status: unlock required / retries */
+
+static void sim_status_ready (MMBroadbandModemShannon *self,
+                              GAsyncResult            *res,
+                              GTask                   *task);
+
+/* Right after the CP boots the card is present but its applications are not
+ * read yet for up to ~30 s, and right after the slot map (0x0250) the card
+ * itself reads as absent (card state 0) for a while; MM's own unlock retries
+ * give up sooner, so poll here (attempt count in the task data's upper bits).
+ * A really missing SIM is reported after SIM_WAIT_ATTEMPTS. */
+#define SIM_WAIT_ATTEMPTS 45
+
+static gboolean
+sim_status_retry_cb (GTask *task)
+{
+    SIT_CMD (g_task_get_source_object (task), SIT_GET_SIM_STATUS, NULL, 0, 10, sim_status_ready, task);
+    return G_SOURCE_REMOVE;
+}
+
+static void
+sim_status_ready (MMBroadbandModemShannon *self,
+                  GAsyncResult            *res,
+                  GTask                   *task)
+{
+    g_autoptr(GBytes) payload = NULL;
+    GError           *error = NULL;
+    MMSitSimStatus    st;
+    guint             data = GPOINTER_TO_UINT (g_task_get_task_data (task));
+    gboolean          want_retries = data & 1;
+    guint             attempt = data >> 1;
+
+    payload = SIT_FINISH (self, res, &error);
+    if (!payload || !mm_sit_parse_sim_status (payload, &st)) {
+        g_task_return_error (task, error ? error :
+                             g_error_new (MM_CORE_ERROR, MM_CORE_ERROR_FAILED, "Invalid SIM status"));
+        g_object_unref (task);
+        return;
+    }
+
+    mm_obj_dbg (self, "SIM status: card %u, apps %u, app type %u state %u, pin1 state %u, "
+                "pin1 retries %u, puk1 retries %u",
+                st.card_state, st.n_apps, st.app_type, st.app_state, st.pin1_state,
+                st.pin1_retries, st.puk1_retries);
+
+    if (want_retries) {
+        MMUnlockRetries *retries = mm_unlock_retries_new ();
+
+        if (st.n_apps) {
+            mm_unlock_retries_set (retries, MM_MODEM_LOCK_SIM_PIN, st.pin1_retries);
+            mm_unlock_retries_set (retries, MM_MODEM_LOCK_SIM_PUK, st.puk1_retries);
+        }
+        g_task_return_pointer (task, retries, g_object_unref);
+        g_object_unref (task);
+        return;
+    }
+
+    if ((st.card_state == 0 || (st.card_state == 1 && !st.n_apps)) &&
+        attempt < SIM_WAIT_ATTEMPTS) {
+        /* card not detected yet after the slot map, or not read yet */
+        g_task_set_task_data (task, GUINT_TO_POINTER (((attempt + 1) << 1) | (data & 1)), NULL);
+        g_timeout_add_seconds (1, (GSourceFunc) sim_status_retry_cb, task);
+        return;
+    } else if (st.card_state != 1) {
+        g_task_return_new_error (task, MM_MOBILE_EQUIPMENT_ERROR,
+                                 st.card_state == 0 ? MM_MOBILE_EQUIPMENT_ERROR_SIM_NOT_INSERTED :
+                                                      MM_MOBILE_EQUIPMENT_ERROR_SIM_FAILURE,
+                                 "SIM card state %u", st.card_state);
+    } else if (!st.n_apps) {
+        g_task_return_new_error (task, MM_MOBILE_EQUIPMENT_ERROR, MM_MOBILE_EQUIPMENT_ERROR_SIM_BUSY,
+                                 "SIM applications not ready");
+    } else if (st.app_state == 2) {
+        g_task_return_int (task, MM_MODEM_LOCK_SIM_PIN);
+    } else if (st.app_state == 3) {
+        g_task_return_int (task, MM_MODEM_LOCK_SIM_PUK);
+    } else
+        g_task_return_int (task, MM_MODEM_LOCK_NONE);
+    g_object_unref (task);
+}
+
+static MMModemLock
+load_unlock_required_finish (MMIfaceModem  *self,
+                             GAsyncResult  *res,
+                             GError       **error)
+{
+    GError *inner = NULL;
+    gssize  v;
+
+    v = g_task_propagate_int (G_TASK (res), &inner);
+    if (inner) {
+        g_propagate_error (error, inner);
+        return MM_MODEM_LOCK_UNKNOWN;
+    }
+    return (MMModemLock) v;
+}
+
+static void
+load_unlock_required (MMIfaceModem        *self,
+                      gboolean             last_attempt,
+                      GCancellable        *cancellable,
+                      GAsyncReadyCallback  callback,
+                      gpointer             user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, cancellable, callback, user_data);
+    g_task_set_task_data (task, GUINT_TO_POINTER (FALSE), NULL);
+    SIT_CMD (self, SIT_GET_SIM_STATUS, NULL, 0, 10, sim_status_ready, task);
+}
+
+static MMUnlockRetries *
+load_unlock_retries_finish (MMIfaceModem  *self,
+                            GAsyncResult  *res,
+                            GError       **error)
+{
+    return g_task_propagate_pointer (G_TASK (res), error);
+}
+
+static void
+load_unlock_retries (MMIfaceModem        *self,
+                     GAsyncReadyCallback  callback,
