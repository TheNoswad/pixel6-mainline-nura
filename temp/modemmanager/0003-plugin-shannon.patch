diff --git a/src/plugins/shannon/77-mm-shannon.rules b/src/plugins/shannon/77-mm-shannon.rules
new file mode 100644
index 00000000..c56b35aa
--- /dev/null
+++ b/src/plugins/shannon/77-mm-shannon.rules
@@ -0,0 +1,31 @@
+# do not edit this file, it will be overwritten on update
+# Samsung Shannon modem over cpif (Google Pixel 6), local plugin "shannon"
+
+ACTION!="add|change|move|bind", GOTO="mm_shannon_end"
+
+# SIT control port of the first logical slot (tray SIM)
+SUBSYSTEM=="cpif", KERNEL=="umts_ipc0", GOTO="mm_shannon_sit"
+# rmnetN = PDP context N+1 (cpif CH_EXTENSION channels)
+SUBSYSTEM=="net", KERNEL=="rmnet[0-9]*", DEVPATH=="/devices/virtual/net/*", GOTO="mm_shannon_net"
+GOTO="mm_shannon_end"
+
+LABEL="mm_shannon_sit"
+ENV{ID_MM_SHANNON}="1"
+ENV{ID_MM_PHYSDEV_UID}="shannon-cp"
+ENV{ID_MM_PORT_TYPE_SIT}="1"
+# The node exists as soon as cpif is loaded, but the CP is booted later from
+# userspace (tinycbd); the boot service creates this flag once the CP is up
+# (and removes it on stop) and re-triggers cpif, so ModemManager only sees
+# the port while the CP can answer.
+TEST=="/run/shannon-cp-online", ENV{ID_MM_CANDIDATE}="1"
+GOTO="mm_shannon_end"
+
+LABEL="mm_shannon_net"
+ENV{ID_MM_SHANNON}="1"
+ENV{ID_MM_PHYSDEV_UID}="shannon-cp"
+# Same gate for the data ports (80-mm-candidate.rules makes every net device
+# a candidate, so hide them instead): if MM saw rmnet before umts_ipc0 it
+# would give up on the device and later build a modem without data ports.
+TEST!="/run/shannon-cp-online", ENV{ID_MM_DEVICE_IGNORE}="1"
+
+LABEL="mm_shannon_end"
diff --git a/src/plugins/shannon/mm-bearer-shannon.c b/src/plugins/shannon/mm-bearer-shannon.c
new file mode 100644
index 00000000..88431eb8
--- /dev/null
+++ b/src/plugins/shannon/mm-bearer-shannon.c
@@ -0,0 +1,488 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * Data bearer of a Shannon modem (local plugin).
+ *
+ * One bearer = one SIT data call on cid 1, carried by rmnet<cid-1> (cpif
+ * maps rmnet0 to the first PDP channel). The CP returns static addresses,
+ * DNS and MTU; NetworkManager configures the interface. A call that is
+ * already active on the CP (e.g. left by modemd) is adopted.
+ */
+
+#include <string.h>
+
+#define _LIBMM_INSIDE_MM
+#include <libmm-glib.h>
+
+#include "mm-log-object.h"
+#include "mm-base-modem.h"
+#include "mm-bind.h"
+#include "mm-bearer-shannon.h"
+#include "mm-broadband-modem-shannon.h"
+#include "mm-sit-helpers.h"
+
+G_DEFINE_TYPE (MMBearerShannon, mm_bearer_shannon, MM_TYPE_BASE_BEARER)
+
+#define BEARER_CID 1
+
+struct _MMBearerShannonPrivate {
+    guint8     cid;
+    gboolean   connected;
+    MMPortSit *sit;           /* for the data call IND */
+    gulong     indication_id;
+};
+
+/*****************************************************************************/
+
+static MMBroadbandModemShannon *
+get_modem (MMBearerShannon *self)
+{
+    MMBaseModem *modem = NULL;
+
+    g_object_get (self, MM_BASE_BEARER_MODEM, &modem, NULL);
+    return MM_BROADBAND_MODEM_SHANNON (modem);
+}
+
+static void data_call_list_changed (MMBearerShannon *self);
+
+static void
+indication_cb (MMPortSit       *port,
+               guint            id,
+               GBytes          *payload,
+               MMBearerShannon *self)
+{
+    if (id == SIT_IND_DATA_CALL_LIST_CHANGED && self->priv->connected)
+        data_call_list_changed (self);
+}
+
+static void
+watch_indications (MMBearerShannon         *self,
+                   MMBroadbandModemShannon *modem)
+{
+    MMPortSit *port;
+
+    port = mm_broadband_modem_shannon_peek_port_sit (modem);
+    if (!port || port == self->priv->sit)
+        return;
+    if (self->priv->sit) {
+        if (self->priv->indication_id) {
+            g_signal_handler_disconnect (self->priv->sit, self->priv->indication_id);
+            self->priv->indication_id = 0;
+        }
+        g_clear_object (&self->priv->sit);
+    }
+    self->priv->sit = g_object_ref (port);
+    self->priv->indication_id = g_signal_connect (port, MM_PORT_SIT_SIGNAL_INDICATION,
+                                                  G_CALLBACK (indication_cb), self);
+}
+
+static void
+list_changed_ready (MMBroadbandModemShannon *modem,
+                    GAsyncResult            *res,
+                    MMBearerShannon         *self)
+{
+    g_autoptr(GBytes) list = NULL;
+    g_autoptr(GError) error = NULL;
+    MMSitDataCall     call = { 0 };
+
+    list = mm_broadband_modem_shannon_command_finish (modem, res, &error);
+    if (!list) {
+        mm_obj_dbg (self, "couldn't reload data calls: %s", error->message);
+    } else if (self->priv->connected &&
+               (!mm_sit_find_data_call (list, self->priv->cid, &call) || !call.active)) {
+        mm_obj_info (self, "data call on cid %u went down", self->priv->cid);
+        self->priv->connected = FALSE;
+        mm_base_bearer_report_connection_status (MM_BASE_BEARER (self),
+                                                 MM_BEARER_CONNECTION_STATUS_DISCONNECTED);
+    }
+    if (list)
+        mm_sit_data_call_clear (&call);
+    g_object_unref (self);
+}
+
+static void
+data_call_list_changed (MMBearerShannon *self)
+{
+    g_autoptr(MMBroadbandModemShannon) modem = get_modem (self);
+
+    mm_broadband_modem_shannon_command (modem, SIT_GET_DATA_CALL_LIST, NULL, 0, 10,
+                                        (GAsyncReadyCallback) list_changed_ready,
+                                        g_object_ref (self));
+}
+
+/*****************************************************************************/
+/* Connect */
+
+typedef struct {
+    MMBroadbandModemShannon *modem;
+    MMPort                  *data;
+    gchar                   *apn;
+    guint8                   pdp;
+    gboolean                 retried;
+} ConnectContext;
+
+static void
+connect_context_free (ConnectContext *ctx)
+{
+    g_clear_object (&ctx->modem);
+    g_clear_object (&ctx->data);
+    g_free (ctx->apn);
+    g_slice_free (ConnectContext, ctx);
+}
+
+static MMBearerConnectResult *
+connect_finish (MMBaseBearer  *self,
+                GAsyncResult  *res,
+                GError       **error)
+{
+    return g_task_propagate_pointer (G_TASK (res), error);
+}
+
+static void
+connect_complete (GTask         *task,
+                  MMSitDataCall *call)
+{
+    MMBearerShannon        *self = g_task_get_source_object (task);
+    ConnectContext         *ctx = g_task_get_task_data (task);
+    g_autoptr(MMBearerIpConfig) v4 = NULL;
+    g_autoptr(MMBearerIpConfig) v6 = NULL;
+    GPtrArray              *dns4;
+    GPtrArray              *dns6;
+    guint                   i;
+
+    dns4 = g_ptr_array_new ();
+    dns6 = g_ptr_array_new ();
+    for (i = 0; call->dns[i]; i++)
+        g_ptr_array_add (strchr (call->dns[i], ':') ? dns6 : dns4, call->dns[i]);
+    g_ptr_array_add (dns4, NULL);
+    g_ptr_array_add (dns6, NULL);
+
+    if (call->ipv4) {
+        v4 = mm_bearer_ip_config_new ();
+        mm_bearer_ip_config_set_method (v4, MM_BEARER_IP_METHOD_STATIC);
+        mm_bearer_ip_config_set_address (v4, call->ipv4);
+        mm_bearer_ip_config_set_prefix (v4, 32);
+        mm_bearer_ip_config_set_dns (v4, (const gchar **) dns4->pdata);
+        if (call->mtu)
+            mm_bearer_ip_config_set_mtu (v4, call->mtu);
+    }
+    if (call->ipv6) {
+        v6 = mm_bearer_ip_config_new ();
+        mm_bearer_ip_config_set_method (v6, MM_BEARER_IP_METHOD_STATIC);
+        mm_bearer_ip_config_set_address (v6, call->ipv6);
+        mm_bearer_ip_config_set_prefix (v6, 64);
+        /* rmnet is POINTOPOINT/NOARP, the next hop is never resolved; NM
+         * insists on a gateway for static IPv6, so give it a link-local one */
+        mm_bearer_ip_config_set_gateway (v6, "fe80::1");
+        mm_bearer_ip_config_set_dns (v6, (const gchar **) dns6->pdata);
+        if (call->mtu)
+            mm_bearer_ip_config_set_mtu (v6, call->mtu);
+    }
+    g_ptr_array_unref (dns4);
+    g_ptr_array_unref (dns6);
+
+    mm_obj_info (self, "data call up on cid %u (%s): v4 %s v6 %s mtu %u",
+                 call->cid, mm_port_get_device (ctx->data),
+                 call->ipv4 ? call->ipv4 : "-", call->ipv6 ? call->ipv6 : "-", call->mtu);
+
+    self->priv->connected = TRUE;
+    watch_indications (self, ctx->modem);
+    g_task_return_pointer (task,
+                           mm_bearer_connect_result_new (ctx->data, v4, v6),
+                           (GDestroyNotify) mm_bearer_connect_result_unref);
+    g_object_unref (task);
+}
+
+static void send_setup (MMBroadbandModemShannon *modem, GTask *task);
+
+static void
+setup_retry_deact_ready (MMBroadbandModemShannon *modem,
+                         GAsyncResult            *res,
+                         GTask                   *task)
+{
+    g_autoptr(GBytes) payload = NULL;
+    g_autoptr(GError) error = NULL;
+
+    payload = mm_broadband_modem_shannon_command_finish (modem, res, &error);
+    if (!payload)
+        mm_obj_dbg (g_task_get_source_object (task), "clearing cid: %s", error->message);
+    send_setup (modem, task);
+}
+
+static void
+setup_ready (MMBroadbandModemShannon *modem,
+             GAsyncResult            *res,
+             GTask                   *task)
+{
+    MMBearerShannon  *self = g_task_get_source_object (task);
+    ConnectContext   *ctx = g_task_get_task_data (task);
+    g_autoptr(GBytes) payload = NULL;
+    GError           *error = NULL;
+    MMSitDataCall     call = { 0 };
+    const guint8     *d;
+    gsize             len;
+
+    payload = mm_broadband_modem_shannon_command_finish (modem, res, &error);
+    if (!payload) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+    d = g_bytes_get_data (payload, &len);
+    if (!mm_sit_parse_data_call (d, len, &call) || !call.active) {
+        /* After the network dropped a call, every new setup on that cid
+         * failed with cause 0xffff until ModemManager restarted (2026-10-10):
+         * deactivate the cid once to clear the stale call, then try again. */
+        if (!ctx->retried) {
+            guint8 req[2] = { self->priv->cid, 0 };
+
+            ctx->retried = TRUE;
+            mm_obj_info (self, "data call setup failed (cause 0x%x): deactivating cid %u and retrying",
+                         call.fail_cause, self->priv->cid);
+            mm_sit_data_call_clear (&call);
+            mm_broadband_modem_shannon_command (modem, SIT_DEACT_DATA_CALL, req, sizeof (req), 20,
+                                                (GAsyncReadyCallback) setup_retry_deact_ready, task);
+            return;
+        }
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                 "Data call setup failed (cause 0x%x)", call.fail_cause);
+        mm_sit_data_call_clear (&call);
+        g_object_unref (task);
+        return;
+    }
+    connect_complete (task, &call);
+    mm_sit_data_call_clear (&call);
+}
+
+static void
+list_ready (MMBroadbandModemShannon *modem,
+            GAsyncResult            *res,
+            GTask                   *task)
+{
+    MMBearerShannon       *self = g_task_get_source_object (task);
+    g_autoptr(GBytes)      list = NULL;
+    g_autoptr(GError)      error = NULL;
+    MMSitDataCall          call = { 0 };
+
+    list = mm_broadband_modem_shannon_command_finish (modem, res, &error);
+    if (list && mm_sit_find_data_call (list, self->priv->cid, &call)) {
+        if (call.active) {
+            mm_obj_info (self, "adopting active data call on cid %u", self->priv->cid);
+            connect_complete (task, &call);
+            mm_sit_data_call_clear (&call);
+            return;
+        }
+        mm_sit_data_call_clear (&call);
+    } else if (!list)
+        mm_obj_dbg (self, "couldn't list data calls: %s", error->message);
+
+    send_setup (modem, task);
+}
+
+static void
+send_setup (MMBroadbandModemShannon *modem,
+            GTask                   *task)
+{
+    MMBearerShannon       *self = g_task_get_source_object (task);
+    ConnectContext        *ctx = g_task_get_task_data (task);
+    g_autoptr(GByteArray)  req = NULL;
+
+    mm_obj_info (self, "setting up data call: APN '%s', pdp type %u, cid %u",
+                 ctx->apn ? ctx->apn : "", ctx->pdp, self->priv->cid);
+    req = mm_broadband_modem_shannon_build_setup_data_call (self->priv->cid, ctx->apn, ctx->pdp, 0, 0);
+    mm_broadband_modem_shannon_command (modem, SIT_SETUP_DATA_CALL, req->data, req->len, 40,
+                                        (GAsyncReadyCallback) setup_ready, task);
+}
+
+static void
+_connect (MMBaseBearer        *_self,
+          GCancellable        *cancellable,
+          GAsyncReadyCallback  callback,
+          gpointer             user_data)
+{
+    MMBearerShannon    *self = MM_BEARER_SHANNON (_self);
+    MMBearerProperties *config;
+    ConnectContext     *ctx;
+    GTask              *task;
+    g_autofree gchar   *ifname = NULL;
+    MMPort             *data;
+
+    task = g_task_new (self, cancellable, callback, user_data);
+    ctx = g_slice_new0 (ConnectContext);
+    g_task_set_task_data (task, ctx, (GDestroyNotify) connect_context_free);
+    ctx->modem = get_modem (self);
+
+    ifname = g_strdup_printf ("rmnet%u", self->priv->cid - 1);
+    data = mm_base_modem_peek_port (MM_BASE_MODEM (ctx->modem), ifname);
+    if (!data || mm_port_get_port_type (data) != MM_PORT_TYPE_NET) {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_NOT_FOUND,
+                                 "No net port %s for cid %u", ifname, self->priv->cid);
+        g_object_unref (task);
+        return;
+    }
+    ctx->data = g_object_ref (data);
+
+    config = mm_base_bearer_peek_config (_self);
+    ctx->apn = g_strdup (mm_bearer_properties_get_apn (config));
+    ctx->pdp = mm_broadband_modem_shannon_pdp_type_from_ip_family (mm_bearer_properties_get_ip_type (config));
+
+    mm_broadband_modem_shannon_command (ctx->modem, SIT_GET_DATA_CALL_LIST, NULL, 0, 10,
+                                        (GAsyncReadyCallback) list_ready, task);
+}
+
+/*****************************************************************************/
+/* Disconnect */
+
+static gboolean
+disconnect_finish (MMBaseBearer  *self,
+                   GAsyncResult  *res,
+                   GError       **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void
+deact_ready (MMBroadbandModemShannon *modem,
+             GAsyncResult            *res,
+             GTask                   *task)
+{
+    MMBearerShannon   *self = g_task_get_source_object (task);
+    g_autoptr(GBytes)  payload = NULL;
+    g_autoptr(GError)  error = NULL;
+
+    payload = mm_broadband_modem_shannon_command_finish (modem, res, &error);
+    /* an already inactive call fails with a SIT error: that's fine */
+    if (!payload)
+        mm_obj_dbg (self, "deactivating cid %u: %s", self->priv->cid, error->message);
+    self->priv->connected = FALSE;
+    g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+disconnect (MMBaseBearer        *_self,
+            GAsyncReadyCallback  callback,
+            gpointer             user_data)
+{
+    MMBearerShannon                    *self = MM_BEARER_SHANNON (_self);
+    g_autoptr(MMBroadbandModemShannon)  modem = get_modem (self);
+    GTask                              *task;
+    guint8                              req[2] = { self->priv->cid, 0 };
+
+    task = g_task_new (self, NULL, callback, user_data);
+    mm_broadband_modem_shannon_command (modem, SIT_DEACT_DATA_CALL, req, sizeof (req), 20,
+                                        (GAsyncReadyCallback) deact_ready, task);
+}
+
+/*****************************************************************************/
+/* Connection status polling (backup for the IND) */
+
+static MMBearerConnectionStatus
+load_connection_status_finish (MMBaseBearer  *self,
+                               GAsyncResult  *res,
+                               GError       **error)
+{
+    GError *inner = NULL;
+    gssize  v;
+
+    v = g_task_propagate_int (G_TASK (res), &inner);
+    if (inner) {
+        g_propagate_error (error, inner);
+        return MM_BEARER_CONNECTION_STATUS_UNKNOWN;
+    }
+    return (MMBearerConnectionStatus) v;
+}
+
+static void
+status_ready (MMBroadbandModemShannon *modem,
+              GAsyncResult            *res,
+              GTask                   *task)
+{
+    MMBearerShannon   *self = g_task_get_source_object (task);
+    g_autoptr(GBytes)  list = NULL;
+    GError            *error = NULL;
+    MMSitDataCall      call = { 0 };
+    gboolean           active = FALSE;
+
+    list = mm_broadband_modem_shannon_command_finish (modem, res, &error);
+    if (!list) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+    if (mm_sit_find_data_call (list, self->priv->cid, &call)) {
+        active = call.active;
+        mm_sit_data_call_clear (&call);
+    }
+    g_task_return_int (task, active ? MM_BEARER_CONNECTION_STATUS_CONNECTED :
+                                      MM_BEARER_CONNECTION_STATUS_DISCONNECTED);
+    g_object_unref (task);
+}
+
+static void
+load_connection_status (MMBaseBearer        *self,
+                        GAsyncReadyCallback  callback,
+                        gpointer             user_data)
+{
+    g_autoptr(MMBroadbandModemShannon) modem = get_modem (MM_BEARER_SHANNON (self));
+    GTask                             *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    mm_broadband_modem_shannon_command (modem, SIT_GET_DATA_CALL_LIST, NULL, 0, 10,
+                                        (GAsyncReadyCallback) status_ready, task);
+}
+
+/*****************************************************************************/
+
+MMBaseBearer *
+mm_bearer_shannon_new (MMBroadbandModemShannon *modem,
+                       MMBearerProperties      *config)
+{
+    MMBaseBearer *bearer;
+
+    bearer = g_object_new (MM_TYPE_BEARER_SHANNON,
+                           MM_BASE_BEARER_MODEM,  modem,
+                           MM_BIND_TO,            modem,
+                           MM_BASE_BEARER_CONFIG, config,
+                           NULL);
+    mm_base_bearer_export (bearer);
+    return bearer;
+}
+
+static void
+mm_bearer_shannon_init (MMBearerShannon *self)
+{
+    self->priv = G_TYPE_INSTANCE_GET_PRIVATE (self, MM_TYPE_BEARER_SHANNON, MMBearerShannonPrivate);
+    self->priv->cid = BEARER_CID;
+}
+
+static void
+dispose (GObject *object)
+{
+    MMBearerShannon *self = MM_BEARER_SHANNON (object);
+
+    if (self->priv->sit) {
+        if (self->priv->indication_id) {
+            g_signal_handler_disconnect (self->priv->sit, self->priv->indication_id);
+            self->priv->indication_id = 0;
+        }
+        g_clear_object (&self->priv->sit);
+    }
+    G_OBJECT_CLASS (mm_bearer_shannon_parent_class)->dispose (object);
+}
+
+static void
+mm_bearer_shannon_class_init (MMBearerShannonClass *klass)
+{
+    GObjectClass      *object_class = G_OBJECT_CLASS (klass);
+    MMBaseBearerClass *base_bearer_class = MM_BASE_BEARER_CLASS (klass);
+
+    g_type_class_add_private (object_class, sizeof (MMBearerShannonPrivate));
+    object_class->dispose = dispose;
+
+    base_bearer_class->connect = _connect;
+    base_bearer_class->connect_finish = connect_finish;
+    base_bearer_class->disconnect = disconnect;
+    base_bearer_class->disconnect_finish = disconnect_finish;
+    base_bearer_class->load_connection_status = load_connection_status;
+    base_bearer_class->load_connection_status_finish = load_connection_status_finish;
+}
