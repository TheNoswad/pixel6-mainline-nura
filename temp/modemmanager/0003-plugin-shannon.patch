diff --git a/src/plugins/shannon/mm-sit-helpers.c b/src/plugins/shannon/mm-sit-helpers.c
new file mode 100644
index 00000000..2d682afa
--- /dev/null
+++ b/src/plugins/shannon/mm-sit-helpers.c
@@ -0,0 +1,440 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SIT payload decoders for the Shannon 5123 modem (local plugin).
+ */
+
+#include <string.h>
+#include <arpa/inet.h>
+
+#include "mm-errors-types.h"
+#include "mm-log-object.h"
+#include "mm-modem-helpers.h"
+#include "mm-sit-helpers.h"
+
+/*****************************************************************************/
+
+gchar *
+mm_sit_string_field (const guint8 *p,
+                     gsize         len)
+{
+    gsize  n;
+    gchar *s;
+
+    for (n = 0; n < len && p[n]; n++)
+        ;
+    /* '#' pads PLMN fields */
+    while (n > 0 && (p[n - 1] == '#' || p[n - 1] == ' '))
+        n--;
+    if (!n)
+        return NULL;
+    s = g_strndup ((const gchar *) p, n);
+    if (!g_utf8_validate (s, -1, NULL)) {
+        g_free (s);
+        return NULL;
+    }
+    return s;
+}
+
+static gchar *
+ip_string (int family, const guint8 *p, gsize len)
+{
+    gchar buf[INET6_ADDRSTRLEN];
+    gsize i;
+
+    for (i = 0; i < len && !p[i]; i++)
+        ;
+    if (i == len)
+        return NULL;
+    if (!inet_ntop (family, p, buf, sizeof (buf)))
+        return NULL;
+    return g_strdup (buf);
+}
+
+/*****************************************************************************/
+/* Data calls (layout: datacall.py)
+ *   0x00 u16 fail cause   0x02 u8 cid   0x03 u8 active   0x04 u8 pdp type
+ *   0x05 ipv4[4]   0x09 ipv6[16]   0x1a dns1 v4   0x1e dns1 v6
+ *   0x2e dns2 v4   0x32 dns2 v6   0x7f u16 mtu
+ */
+
+void
+mm_sit_data_call_clear (MMSitDataCall *call)
+{
+    guint i;
+
+    g_clear_pointer (&call->ipv4, g_free);
+    g_clear_pointer (&call->ipv6, g_free);
+    for (i = 0; i < G_N_ELEMENTS (call->dns); i++)
+        g_clear_pointer (&call->dns[i], g_free);
+}
+
+gboolean
+mm_sit_parse_data_call (const guint8  *it,
+                        gsize          len,
+                        MMSitDataCall *call)
+{
+    guint n = 0;
+    gchar *s;
+
+    memset (call, 0, sizeof (*call));
+    if (len < 0x81)
+        return FALSE;
+    call->fail_cause = it[0] | (it[1] << 8);
+    call->cid        = it[2];
+    call->active     = it[3] != 0;
+    call->pdp_type   = it[4];
+    call->ipv4       = ip_string (AF_INET,  it + 0x05, 4);
+    call->ipv6       = ip_string (AF_INET6, it + 0x09, 16);
+    if ((s = ip_string (AF_INET,  it + 0x1a, 4)))  call->dns[n++] = s;
+    if ((s = ip_string (AF_INET6, it + 0x1e, 16))) call->dns[n++] = s;
+    if ((s = ip_string (AF_INET,  it + 0x2e, 4)))  call->dns[n++] = s;
+    if ((s = ip_string (AF_INET6, it + 0x32, 16)))  call->dns[n++] = s;
+    call->mtu = it[0x7f] | (it[0x80] << 8);
+    return TRUE;
+}
+
+/* u8 count + items. The item size depends on the request version the CP
+ * last saw: 0x118 after v1 SETUP_DATA_CALLs only, 0x124 once a v2 one (the
+ * IMS PDN) exists, so derive it from the length. */
+const guint8 *
+mm_sit_find_data_call_item (GBytes *list,
+                            guint8  cid,
+                            gsize  *item_len)
+{
+    const guint8 *d;
+    gsize         len;
+    gsize         stride;
+    guint         i;
+
+    d = g_bytes_get_data (list, &len);
+    if (!len || !d[0])
+        return NULL;
+    stride = (len - 1) / d[0];
+    if (stride < 0x81)
+        return NULL;
+    for (i = 0; i < d[0]; i++) {
+        gsize off = 1 + (gsize) i * stride;
+
+        if (d[off + 2] != cid)
+            continue;
+        *item_len = stride;
+        return d + off;
+    }
+    return NULL;
+}
+
+gboolean
+mm_sit_find_data_call (GBytes        *list,
+                       guint8         cid,
+                       MMSitDataCall *call)
+{
+    const guint8 *item;
+    gsize         item_len;
+
+    item = mm_sit_find_data_call_item (list, cid, &item_len);
+    if (!item)
+        return FALSE;
+    return mm_sit_parse_data_call (item, item_len, call);
+}
+
+/*****************************************************************************/
+/* Registration state (ProtocolNetVoiceRegStateAdapter /
+ * ProtocolNetDataRegStateAdapter):
+ *   CS: 0 state, 1 reject cause, 2 rat, 3 u16 lac, 7 u32 cell id,
+ *       0x0c u16 tac, 0x14 u32 eci
+ *   PS: 0 state, 1 reject cause, 3 rat, 4 u16 lac, 8 u32 cell id,
+ *       0x0d u16 tac, 0x15 u32 eci
+ * (tac/eci checked against live LTE frames: TAC 0x3c96, ECI 0x0364b20f)
+ */
+
+static guint32
+le32 (const guint8 *p)
+{
+    return p[0] | (p[1] << 8) | (p[2] << 16) | ((guint32) p[3] << 24);
+}
+
+gboolean
+mm_sit_parse_reg_state (GBytes        *payload,
+                        gboolean       ps,
+                        MMSitRegState *out)
+{
+    const guint8 *d;
+    gsize         len;
+
+    d = g_bytes_get_data (payload, &len);
+    memset (out, 0, sizeof (*out));
+    if (len < (ps ? 0x19 : 0x18))
+        return FALSE;
+    out->state        = d[0];
+    out->reject_cause = d[1];
+    if (ps) {
+        out->rat     = d[3];
+        out->lac     = d[4] | (d[5] << 8);
+        out->cell_id = le32 (d + 8);
+        out->tac     = d[0x0d] | (d[0x0e] << 8);
+        out->eci     = le32 (d + 0x15);
+    } else {
+        out->rat     = d[2];
+        out->lac     = d[3] | (d[4] << 8);
+        out->cell_id = le32 (d + 7);
+        out->tac     = d[0x0c] | (d[0x0d] << 8);
+        out->eci     = le32 (d + 0x14);
+    }
+    return TRUE;
+}
+
+MMModem3gppRegistrationState
+mm_sit_reg_state_to_mm (guint8 state)
+{
+    /* Android RIL RegState; 10/12/13/14 are the emergency-only variants */
+    switch (state) {
+    case 0:
+    case 10:
+        return MM_MODEM_3GPP_REGISTRATION_STATE_IDLE;
+    case 1:
+        return MM_MODEM_3GPP_REGISTRATION_STATE_HOME;
+    case 2:
+    case 12:
+        return MM_MODEM_3GPP_REGISTRATION_STATE_SEARCHING;
+    case 3:
+    case 13:
+        return MM_MODEM_3GPP_REGISTRATION_STATE_DENIED;
+    case 5:
+        return MM_MODEM_3GPP_REGISTRATION_STATE_ROAMING;
+    case 4:
+    case 14:
+    default:
+        return MM_MODEM_3GPP_REGISTRATION_STATE_UNKNOWN;
+    }
+}
+
+MMModemAccessTechnology
+mm_sit_rat_to_access_tech (guint8 rat)
+{
+    /* SIT rat -> Android RIL radio tech (toRadioTech table in
+     * vendor.radio.protocol.sit.base.so): identity for 1..18, 19 -> HSDPA,
+     * 20 -> LTE (LTE CA), 21 -> NR. */
+    switch (rat) {
+    case 1:  return MM_MODEM_ACCESS_TECHNOLOGY_GPRS;
+    case 2:  return MM_MODEM_ACCESS_TECHNOLOGY_EDGE;
+    case 3:  return MM_MODEM_ACCESS_TECHNOLOGY_UMTS;
+    case 9:
+    case 19: return MM_MODEM_ACCESS_TECHNOLOGY_HSDPA;
+    case 10: return MM_MODEM_ACCESS_TECHNOLOGY_HSUPA;
+    case 11: return MM_MODEM_ACCESS_TECHNOLOGY_HSPA;
+    case 14:
+    case 20: return MM_MODEM_ACCESS_TECHNOLOGY_LTE;
+    case 15: return MM_MODEM_ACCESS_TECHNOLOGY_HSPA_PLUS;
+    case 16: return MM_MODEM_ACCESS_TECHNOLOGY_GSM;
+    case 21: return MM_MODEM_ACCESS_TECHNOLOGY_5GNR;
+    default: return MM_MODEM_ACCESS_TECHNOLOGY_UNKNOWN;
+    }
+}
+
+/*****************************************************************************/
+
+gboolean
+mm_sit_parse_operator (GBytes  *payload,
+                       gchar  **plmn,
+                       gchar  **short_name,
+                       gchar  **long_name)
+{
+    const guint8 *d;
+    gsize         len;
+
+    d = g_bytes_get_data (payload, &len);
+    if (len < 6)
+        return FALSE;
+    if (plmn)
+        *plmn = mm_sit_string_field (d, 6);
+    if (short_name)
+        *short_name = len >= 0x26 ? mm_sit_string_field (d + 6, 32) : NULL;
+    if (long_name)
+        *long_name = len >= 0x66 ? mm_sit_string_field (d + 0x26, 64) : NULL;
+    return TRUE;
+}
+
+gchar *
+mm_sit_parse_digits (GBytes *payload)
+{
+    const guint8 *d;
+    gsize         len;
+
+    d = g_bytes_get_data (payload, &len);
+    if (len < 2 || d[0] == 0 || (gsize) d[0] + 1 > len)
+        return NULL;
+    return mm_sit_string_field (d + 1, d[0]);
+}
+
+gchar *
+mm_sit_parse_baseband_sw (GBytes *payload)
+{
+    const guint8 *d;
+    gsize         len;
+
+    d = g_bytes_get_data (payload, &len);
+    if (len < 1 + 32)
+        return NULL;
+    return mm_sit_string_field (d + 1, 32);
+}
+
+/*****************************************************************************/
+/* SIM status (ProtocolSimStatusAdapter): 0 card state, 1 universal PIN state,
+ * 2 app count, then 63-byte app records from 3: 0 type, 1 state, 2 perso,
+ * 3 aid len, 4 aid[16], ..., 0x39 pin1 state, 0x3a pin2 state,
+ * 0x3b pin1 retries, 0x3c puk1 retries, 0x3d pin2 retries, 0x3e puk2 retries.
+ */
+
+gboolean
+mm_sit_parse_sim_status (GBytes         *payload,
+                         MMSitSimStatus *out)
+{
+    const guint8 *d;
+    gsize         len;
+
+    d = g_bytes_get_data (payload, &len);
+    memset (out, 0, sizeof (*out));
+    if (len < 3)
+        return FALSE;
+    out->card_state = d[0];
+    out->n_apps     = d[2];
+    if (out->n_apps && len >= 3 + 63) {
+        const guint8 *app = d + 3;
+
+        out->app_type     = app[0];
+        out->app_state    = app[1];
+        out->pin1_state   = app[0x39];
+        out->pin1_retries = app[0x3b];
+        out->puk1_retries = app[0x3c];
+    }
+    return TRUE;
+}
+
+/*****************************************************************************/
+
+gboolean
+mm_sit_parse_signal (GBytes      *payload,
+                     MMSitSignal *out)
+{
+    const guint8 *d;
+    gsize         len;
+    guint32       rsrp, rsrq, rssnr;
+
+    d = g_bytes_get_data (payload, &len);
+    memset (out, 0, sizeof (*out));
+    if (len < 0x3e + 16)
+        return FALSE;
+    rsrp  = le32 (d + 0x42);
+    rsrq  = le32 (d + 0x46);
+    rssnr = le32 (d + 0x4a);
+    if (rsrp < 44 || rsrp > 140)
+        return FALSE;
+    out->rsrp = -(gint) rsrp;
+    out->rsrq = (rsrq >= 3 && rsrq <= 20) ? -(gint) rsrq : 0;
+    out->rssnr = (gint32) rssnr;
+    return TRUE;
+}
+
+guint
+mm_sit_signal_quality (const MMSitSignal *sig)
+{
+    /* linear over the 3GPP RSRP range, -140 dBm = 0 %, -44 dBm = 100 % */
+    if (!sig->rsrp)
+        return 0;
+    return (guint) CLAMP ((sig->rsrp + 140) * 100 / 96, 0, 100);
+}
+
+/*****************************************************************************/
+/* GET_CURRENT_CALLS response: u32 count, then one item per call. The item is
+ * 0x147 bytes (RIL 1.1), 0x14b (1.2: + u32 audio quality) or 0x16c (1.6);
+ * the fields below are in all of them (ProtocolGetCurrentCallAdapter):
+ *   0x00 u8 state (RIL CallState), 0x01 u32 index, 0x05 u32 TOA,
+ *   0x09 u8 multiparty, 0x0a u8 MT, 0x0b u8 ALS, 0x0c u8 call type,
+ *   0x0e u8 number length, 0x0f number[0x52], 0x61 u32 number presentation,
+ *   0x65 u8 name length, 0x66 name, 0xb8 u32 name presentation, 0xbc u8 dcs */
+
+#define SIT_CALL_ITEM_V1_1 0x147
+#define SIT_CALL_ITEM_V1_2 0x14b
+#define SIT_CALL_ITEM_V1_6 0x16c
+
+static MMCallState
+sit_call_state_to_mm (guint8 state)
+{
+    switch (state) {
+    case 0: return MM_CALL_STATE_ACTIVE;
+    case 1: return MM_CALL_STATE_HELD;
+    case 2: return MM_CALL_STATE_DIALING;
+    case 3: return MM_CALL_STATE_RINGING_OUT;
+    case 4: return MM_CALL_STATE_RINGING_IN;
+    case 5: return MM_CALL_STATE_WAITING;
+    default: return MM_CALL_STATE_UNKNOWN;
+    }
+}
+
+gboolean
+mm_sit_parse_call_list (GBytes   *payload,
+                        gpointer  log_object,
+                        GList   **out_list,
+                        GError  **error)
+{
+    const guint8 *d;
+    gsize         len;
+    guint32       count;
+    gsize         item_len;
+    GList        *list = NULL;
+    guint         i;
+
+    d = g_bytes_get_data (payload, &len);
+    if (len < 4) {
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                     "call list too short (%" G_GSIZE_FORMAT " bytes)", len);
+        return FALSE;
+    }
+    count = d[0] | (d[1] << 8) | (d[2] << 16) | ((guint32) d[3] << 24);
+    if (count == 0) {
+        *out_list = NULL;
+        return TRUE;
+    }
+    item_len = (len - 4) / count;
+    if (count > 9 || (len - 4) % count ||
+        (item_len != SIT_CALL_ITEM_V1_1 && item_len != SIT_CALL_ITEM_V1_2 && item_len != SIT_CALL_ITEM_V1_6)) {
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                     "unexpected call list layout (%u calls in %" G_GSIZE_FORMAT " bytes)", count, len);
+        return FALSE;
+    }
+
+    for (i = 0; i < count; i++) {
+        const guint8 *e = d + 4 + i * item_len;
+        MMCallInfo   *info;
+        guint32       toa;
+        guint8        nlen;
+        g_autofree gchar *number = NULL;
+
+        info = g_slice_new0 (MMCallInfo);
+        info->index = e[1] | (e[2] << 8) | (e[3] << 16) | ((guint32) e[4] << 24);
+        toa = e[5] | (e[6] << 8) | (e[7] << 16) | ((guint32) e[8] << 24);
+        info->state = sit_call_state_to_mm (e[0]);
+        info->direction = e[0x0a] ? MM_CALL_DIRECTION_INCOMING : MM_CALL_DIRECTION_OUTGOING;
+        nlen = MIN (e[0x0e], 0x52);
+        number = mm_sit_string_field (e + 0x0f, nlen);
+        if (number && toa == 0x91 && number[0] != '+')
+            info->number = g_strdup_printf ("+%s", number);
+        else
+            info->number = g_steal_pointer (&number);
+
+        mm_obj_dbg (log_object, "SIT call %u: state %u, %s, toa 0x%x, mpty %u, type %u, number %s",
+                    info->index, e[0], e[0x0a] ? "MT" : "MO", toa, e[0x09], e[0x0c],
+                    info->number ? info->number : "n/a");
+
+        if (info->state == MM_CALL_STATE_UNKNOWN) {
+            /* report_all_calls asserts on unknown states */
+            mm_obj_warn (log_object, "SIT call %u: unknown state %u, skipped", info->index, e[0]);
+            g_free (info->number);
+            g_slice_free (MMCallInfo, info);
+            continue;
+        }
+        list = g_list_append (list, info);
+    }
+    *out_list = list;
+    return TRUE;
+}
diff --git a/src/plugins/shannon/mm-sit-helpers.h b/src/plugins/shannon/mm-sit-helpers.h
new file mode 100644
index 00000000..713039fb
--- /dev/null
+++ b/src/plugins/shannon/mm-sit-helpers.h
@@ -0,0 +1,223 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SIT (Samsung IPC over cpif) message ids and payload decoders for the
+ * Shannon 5123 modem in the Pixel 6 (local plugin, not upstream).
+ *
+ * Frame layouts were taken from the stock vendor.radio.protocol.sit.stream.so
+ * adapters/builders and checked against live responses; all offsets below are
+ * payload offsets (RSP payload starts after the 12-byte header, IND payload
+ * after the 8-byte header).
+ */
+
+#ifndef MM_SIT_HELPERS_H
+#define MM_SIT_HELPERS_H
+
+#include <glib.h>
+
+#define _LIBMM_INSIDE_MM
+#include <libmm-glib.h>
+
+/* Frame types */
+#define SIT_TYPE_REQ 0
+#define SIT_TYPE_RSP 1
+#define SIT_TYPE_IND 2
+
+#define SIT_RSP_HDR_LEN 12
+#define SIT_IND_HDR_LEN 8
+
+/* Message ids */
+#define SIT_GET_CURRENT_CALLS               0x0000
+#define SIT_DIAL                            0x0001
+#define SIT_GET_LAST_CALL_FAIL_CAUSE        0x0002
+#define SIT_DTMF                            0x0003
+#define SIT_ANSWER                          0x0004
+#define SIT_HANGUP                          0x0008
+#define SIT_IND_CALL_STATE_CHANGED          0x0009
+#define SIT_IND_CALL_RING                   0x000a
+#define SIT_IND_CALL_PRESENT_IND            0x0010
+#define SIT_HANGUP_WAITING_OR_BACKGROUND    0x0500
+#define SIT_HANGUP_FOREGROUND_RESUME_BACKGROUND 0x0501
+#define SIT_SWITCH_WAITING_OR_HOLDING_AND_ACTIVE 0x0502
+#define SIT_SEND_SMS                        0x0100
+#define SIT_SEND_SMS_EXPECT_MORE            0x0101
+#define SIT_SEND_SMS_ACK                    0x0102
+#define SIT_GET_SMSC_ADDR                   0x0108
+#define SIT_SEND_SMS_MEM_STATUS             0x010a
+#define SIT_IND_NEW_SMS                     0x010c
+#define SIT_IND_NEW_SMS_STATUS_REPORT       0x010d
+#define SIT_IND_NEW_SMS_ON_SIM              0x010e
+#define SIT_IND_SIM_SMS_STORAGE_FULL        0x010f
+#define SIT_GET_SIM_STATUS                  0x0200
+#define SIT_IND_SIM_STATUS_CHANGED          0x0210
+#define SIT_TRANSMIT_SIM_APDU_BASIC         0x020c
+#define SIT_CLOSE_SIM_CHANNEL               0x020e
+#define SIT_TRANSMIT_SIM_APDU_CHANNEL       0x020f
+#define SIT_OPEN_SIM_CHANNEL_WITH_P2        0x0247
+#define SIT_IND_SIM_SLOT_STATUS_CHANGED     0x024e
+#define SIT_SET_LOGICAL_TO_PHYSICAL_SLOT_MAPPING 0x0250
+#define SIT_GET_IMSI                        0x0400
+#define SIT_GET_IMEI                        0x0401
+#define SIT_GET_IMEISV                      0x0402
+#define SIT_SETUP_DATA_CALL                 0x0600
+#define SIT_DEACT_DATA_CALL                 0x0601
+#define SIT_GET_DATA_CALL_LIST              0x0602
+#define SIT_SET_INITIAL_ATTACH_APN          0x0603
+#define SIT_SET_DATA_PROFILE                0x0613
+#define SIT_IND_DATA_CALL_LIST_CHANGED      0x0604
+#define SIT_GET_CS_REG_STATE                0x0700
+#define SIT_GET_PS_REG_STATE                0x0701
+#define SIT_GET_OPERATOR                    0x0702
+#define SIT_GET_NTW_MODE                    0x0703
+#define SIT_SET_NTW_MODE_AUTO               0x0704
+#define SIT_SET_NTW_MODE_MANUAL             0x0705
+#define SIT_GET_AVAILABLE_NETWORKS          0x0706
+#define SIT_SET_PREFERRED_NTW_TYPE          0x070a
+#define SIT_GET_PREFERRED_NTW_TYPE          0x070b
+#define SIT_IND_NTW_STATE_CHANGED           0x070e
+#define SIT_SET_PS_SERVICE                  0x0710
+#define SIT_SET_NR_MODE                     0x0748
+#define SIT_IND_REGISTRATION_FAILED         0x074a
+#define SIT_SET_RADIO_POWER                 0x0800
+#define SIT_GET_RADIO_POWER                 0x0801
+#define SIT_IND_RADIO_STATE_CHANGED         0x0802
+#define SIT_IND_RADIO_READY                 0x0803
+#define SIT_IND_PHONE_RESET                 0x0804
+#define SIT_IND_MODEM_RESTART               0x0805
+#define SIT_GET_SIGNAL_STRENGTH             0x0900
+#define SIT_GET_BASEBAND_VERSION            0x0901
+#define SIT_IND_NITZ_TIME_RECEIVED          0x0905
+#define SIT_IND_SIGNAL_STRENGTH             0x0906
+#define SIT_SET_IND_FILTER                  0x0928
+#define SIT_SET_CP_CARRIER_CONFIG           0x4600
+#define SIT_IND_CP_CARRIER_CONFIG_STATUS    0x4601
+#define SIT_IND_CP_CARRIER_SIM_INFO         0x4602
+
+/* SET_RADIO_POWER u32 values */
+#define SIT_RADIO_POWER_OFF 1
+#define SIT_RADIO_POWER_ON  2
+
+/* PDP types used in SETUP_DATA_CALL / SET_INITIAL_ATTACH_APN */
+#define SIT_PDP_IP     1
+#define SIT_PDP_IPV6   2
+#define SIT_PDP_IPV4V6 3
+
+/* Data call item: u8 count + items of this size in GET_DATA_CALL_LIST */
+#define SIT_DATA_CALL_ITEM_LEN 0x118
+
+typedef struct {
+    guint16  fail_cause;
+    guint8   cid;
+    gboolean active;
+    guint8   pdp_type;
+    gchar   *ipv4;      /* NULL if none */
+    gchar   *ipv6;      /* NULL if none */
+    gchar   *dns[5];    /* v4 and v6 servers, NULL-terminated */
+    guint16  mtu;
+} MMSitDataCall;
+
+void mm_sit_data_call_clear (MMSitDataCall *call);
+
+/* Decoders: return FALSE if the payload is too short */
+gboolean mm_sit_parse_data_call      (const guint8 *item, gsize len, MMSitDataCall *call);
+gboolean mm_sit_find_data_call       (GBytes *list, guint8 cid, MMSitDataCall *call);
+const guint8 *mm_sit_find_data_call_item (GBytes *list, guint8 cid, gsize *item_len);
+
+/* GET_CS_REG_STATE / GET_PS_REG_STATE */
+typedef struct {
+    guint8  state;      /* Android RIL RegState */
+    guint8  reject_cause;
+    guint8  rat;        /* SIT rat */
+    guint16 lac;
+    guint32 cell_id;
+    guint16 tac;        /* LTE/NR */
+    guint32 eci;        /* LTE/NR cell identity */
+} MMSitRegState;
+
+gboolean mm_sit_parse_reg_state (GBytes *payload, gboolean ps, MMSitRegState *out);
+
+MMModem3gppRegistrationState mm_sit_reg_state_to_mm (guint8 state);
+MMModemAccessTechnology      mm_sit_rat_to_access_tech (guint8 rat);
+
+/* GET_OPERATOR: plmn[6] ('#' padded), short[32], long[64] */
+gboolean mm_sit_parse_operator (GBytes *payload, gchar **plmn, gchar **short_name, gchar **long_name);
+
+/* u8 len + digits (GET_IMSI, GET_IMEI, GET_IMEISV) */
+gchar *mm_sit_parse_digits (GBytes *payload);
+
+/* GET_BASEBAND_VERSION: u8 mask, swver[32], hwver[32], ... */
+gchar *mm_sit_parse_baseband_sw (GBytes *payload);
+
+/* GET_SIM_STATUS */
+typedef struct {
+    guint8 card_state;   /* 0 absent, 1 present, 2 error */
+    guint8 n_apps;
+    guint8 app_type;     /* first app */
+    guint8 app_state;
+    guint8 pin1_state;
+    guint8 pin1_retries;
+    guint8 puk1_retries;
+} MMSitSimStatus;
+
+gboolean mm_sit_parse_sim_status (GBytes *payload, MMSitSimStatus *out);
+
+/* SIGNAL_STRENGTH (IND 0x0906 / RSP 0x0900): LTE block at payload 0x3e,
+ * six LE u32 in Android order: signal strength (asu), rsrp, rsrq (both
+ * positive, i.e. -dBm / -dB), rssnr (0.1 dB), cqi, timing advance. Decoded
+ * from live samples (14, 115, 12, 20, 1, 6). */
+typedef struct {
+    gint rsrp;   /* dBm, 0 if invalid */
+    gint rsrq;   /* dB */
+    gint rssnr;  /* 0.1 dB */
+} MMSitSignal;
+
+gboolean mm_sit_parse_signal (GBytes *payload, MMSitSignal *out);
+guint    mm_sit_signal_quality (const MMSitSignal *sig);
+
+/* SMS (ProtocolSmsBuilder / ProtocolNewSmsIndAdapter / ProtocolSendSms-
+ * RespAdapter in the stream lib):
+ * SEND_SMS(_EXPECT_MORE) payload 259 B: u8 sms domain (vendor.radio.smsdomain,
+ *   0 = auto), u8 smsc_len (1..12; 1 + 0x00 = default SMSC), smsc[12] (TS
+ *   24.011 RP address incl. its own length byte, as in an SMS-SUBMIT PDU
+ *   prefix), u8 tpdu_len (1..244), tpdu[244].
+ *   RSP: u8 message reference @0, u8 ack pdu len @4, pdu @5, u32 error @0xf9.
+ * IND NEW_SMS / NEW_SMS_STATUS_REPORT: u8 tpid, u8 pdu_len, pdu.
+ * SEND_SMS_ACK payload 9 B: u32 success (1/0), u8 tpid (from the IND),
+ *   u32 failure cause (TS 23.040 TP-FCS when success is 0). */
+#define SIT_SEND_SMS_PAYLOAD_LEN 259
+#define SIT_SMS_SMSC_MAX         12
+#define SIT_SMS_TPDU_MAX         244
+#define SIT_SMS_ACK_PAYLOAD_LEN  9
+
+/* SMS over IMS through the CP's AIMS stack (ShannonIms RilReqSendSms,
+ * RilReqSendSmsAck, RilIndNewSms): SEND = u8 smsc len, smsc[12], u8 tpdu
+ * len, tpdu[244], u8 sms type, u8 geolocation (260 B); its response = u32
+ * msg ref, u8 ack len, ack pdu[244], u32 error (0 = sent). The NEW_SMS IND
+ * has the SIT layout (u8 tpid, u8 len, pdu). ACK = u32 result (1 ok), u8
+ * tpid, u32 error. */
+#define SIT_AIMS_SEND_SMS                   0x0d1b
+#define SIT_AIMS_SEND_SMS_EXPECT_MORE       0x0d1c
+#define SIT_AIMS_SEND_SMS_ACK               0x0d1d
+#define SIT_IND_AIMS_NEW_SMS                0x0d1e
+#define SIT_IND_AIMS_NEW_SMS_STATUS_REPORT  0x0d20
+#define SIT_AIMS_SEND_SMS_PAYLOAD_LEN       260
+#define SIT_AIMS_SEND_SMS_ERROR_OFFSET      249
+#define SIT_AIMS_SMS_ACK_PAYLOAD_LEN        9
+
+/* Fixed-size, possibly unterminated string field -> trimmed UTF-8 or NULL */
+/* SIT_DIAL: u8 call type (1 voice), u8 0, u8 number length, number[0x52],
+ * u8 ton (0x10 international, 0x20 unknown), u8 1, u8 clir (0xff default),
+ * u16 0, u8 0, u8 0 (ProtocolCallBuilder::BuildDial) */
+#define SIT_DIAL_PAYLOAD_LEN   0x5c
+#define SIT_DIAL_NUMBER_MAX    0x51
+#define SIT_DTMF_PAYLOAD_LEN   0x41
+#define SIT_DTMF_MAX           0x40
+
+/* GET_CURRENT_CALLS: list of MMCallInfo, NULL if there are no calls */
+gboolean mm_sit_parse_call_list (GBytes   *payload,
+                                 gpointer  log_object,
+                                 GList   **out_list,
+                                 GError  **error);
+
+gchar *mm_sit_string_field (const guint8 *p, gsize len);
+
+#endif /* MM_SIT_HELPERS_H */
diff --git a/src/plugins/shannon/mm-sms-shannon.c b/src/plugins/shannon/mm-sms-shannon.c
new file mode 100644
index 00000000..5fc79cf5
--- /dev/null
+++ b/src/plugins/shannon/mm-sms-shannon.c
@@ -0,0 +1,270 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SMS sent over SIT on a Shannon modem (local plugin).
+ */
+
+#include <string.h>
+
+#define _LIBMM_INSIDE_MM
+#include <libmm-glib.h>
+
+#include "mm-log-object.h"
+#include "mm-errors-types.h"
+#include "mm-bind.h"
+#include "mm-sms-part-3gpp.h"
+#include "mm-broadband-modem-shannon.h"
+#include "mm-sms-shannon.h"
+#include "mm-sit-helpers.h"
+#include "mm-shannon-ims.h"
+
+G_DEFINE_TYPE (MMSmsShannon, mm_sms_shannon, MM_TYPE_BASE_SMS)
+
+struct _MMSmsShannonPrivate {
+    MMBaseModem *modem;
+};
+
+/*****************************************************************************/
+/* Send the SMS: one SEND_SMS per part, EXPECT_MORE for all but the last */
+
+typedef struct {
+    GList    *current;
+    gboolean  over_ims;   /* AIMS_SEND_SMS: IMS registered (no CS on e.g. Verizon) */
+} SmsSendContext;
+
+static gboolean
+sms_send_finish (MMBaseSms     *self,
+                 GAsyncResult  *res,
+                 GError       **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void sms_send_next_part (GTask *task);
+
+static void
+sms_send_ready (MMBroadbandModemShannon *modem,
+                GAsyncResult            *res,
+                GTask                   *task)
+{
+    MMSmsShannon      *self = g_task_get_source_object (task);
+    SmsSendContext    *ctx = g_task_get_task_data (task);
+    g_autoptr(GBytes)  payload = NULL;
+    GError            *error = NULL;
+    const guint8      *d;
+    gsize              len;
+
+    payload = mm_broadband_modem_shannon_command_finish (modem, res, &error);
+    if (!payload) {
+        g_prefix_error (&error, "Couldn't send SMS part: ");
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    d = g_bytes_get_data (payload, &len);
+    if (ctx->over_ims) {
+        guint32 err = 0;
+
+        if (len >= SIT_AIMS_SEND_SMS_ERROR_OFFSET + 4)
+            memcpy (&err, d + SIT_AIMS_SEND_SMS_ERROR_OFFSET, 4);
+        err = GUINT32_FROM_LE (err);
+        if (err != 0) {
+            g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                     "Couldn't send SMS part over IMS: error %u", err);
+            g_object_unref (task);
+            return;
+        }
+        if (len >= 4) {
+            mm_obj_dbg (self, "SMS part sent over IMS: message reference %u", d[0]);
+            mm_sms_part_set_message_reference ((MMSmsPart *) ctx->current->data, d[0]);
+        }
+        ctx->current = g_list_next (ctx->current);
+        sms_send_next_part (task);
+        return;
+    }
+
+    /* a zero header error only means the CP handled the request: the
+     * RP/CMS cause at 0xf9 is 0 on success (the RIL maps e.g. 98 to
+     * RIL_E_NETWORK_ERR) */
+    if (len >= 0xf9 + 4) {
+        guint32 cause;
+
+        cause = d[0xf9] | (d[0xfa] << 8) | (d[0xfb] << 16) | ((guint32) d[0xfc] << 24);
+        if (cause != 0) {
+            g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                     "Couldn't send SMS part: network cause %u", cause);
+            g_object_unref (task);
+            return;
+        }
+    }
+    if (len >= 1) {
+        mm_obj_dbg (self, "SMS part sent: message reference %u", d[0]);
+        mm_sms_part_set_message_reference ((MMSmsPart *) ctx->current->data, d[0]);
+    }
+
+    ctx->current = g_list_next (ctx->current);
+    sms_send_next_part (task);
+}
+
+static void
+sms_send_next_part (GTask *task)
+{
+    MMSmsShannon      *self = g_task_get_source_object (task);
+    SmsSendContext    *ctx = g_task_get_task_data (task);
+    g_autofree guint8 *pdu = NULL;
+    guint              pdulen = 0;
+    guint              msgstart = 0;
+    guint8             req[SIT_SEND_SMS_PAYLOAD_LEN] = { 0 };
+    GByteArray        *smsc;
+    GError            *error = NULL;
+
+    if (!ctx->current) {
+        g_task_return_boolean (task, TRUE);
+        g_object_unref (task);
+        return;
+    }
+
+    /* pdu = SMSC address (incl. its length byte) + TPDU from msgstart */
+    pdu = mm_sms_part_3gpp_get_submit_pdu ((MMSmsPart *) ctx->current->data, &pdulen, &msgstart, self, &error);
+    if (!pdu) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+    if (msgstart > SIT_SMS_SMSC_MAX || pdulen - msgstart > SIT_SMS_TPDU_MAX || pdulen <= msgstart) {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_INVALID_ARGS,
+                                 "SMS part too long for SIT (smsc %u, tpdu %u bytes)",
+                                 msgstart, pdulen - msgstart);
+        g_object_unref (task);
+        return;
+    }
+
+    req[0] = mm_broadband_modem_shannon_get_sms_domain (MM_BROADBAND_MODEM_SHANNON (self->priv->modem));
+    if (msgstart > 1) {
+        req[1] = msgstart;
+        memcpy (&req[2], pdu, msgstart);
+    } else if ((smsc = mm_broadband_modem_shannon_peek_smsc (MM_BROADBAND_MODEM_SHANNON (self->priv->modem)))) {
+        /* no SMSC in the part: the SIM one (the CP has no default) */
+        req[1] = smsc->len;
+        memcpy (&req[2], smsc->data, smsc->len);
+    } else {
+        req[1] = 1;   /* "default SMSC": the CP then fails with cause 98 */
+        req[2] = 0;
+    }
+    req[2 + SIT_SMS_SMSC_MAX] = pdulen - msgstart;
+    memcpy (&req[3 + SIT_SMS_SMSC_MAX], pdu + msgstart, pdulen - msgstart);
+
+    if (ctx->over_ims) {
+        guint8 aims[SIT_AIMS_SEND_SMS_PAYLOAD_LEN] = { 0 };
+
+        /* same smsc/tpdu block without the domain byte; sms type 0 (no
+         * emergency callback mode), no geolocation */
+        memcpy (aims, req + 1, sizeof (req) - 1);
+        mm_broadband_modem_shannon_command (MM_BROADBAND_MODEM_SHANNON (self->priv->modem),
+                                            g_list_next (ctx->current) ? SIT_AIMS_SEND_SMS_EXPECT_MORE
+                                                                       : SIT_AIMS_SEND_SMS,
+                                            aims, sizeof (aims),
+                                            MM_BASE_SMS_DEFAULT_SEND_TIMEOUT,
+                                            (GAsyncReadyCallback) sms_send_ready,
+                                            task);
+        return;
+    }
+    mm_broadband_modem_shannon_command (MM_BROADBAND_MODEM_SHANNON (self->priv->modem),
+                                        g_list_next (ctx->current) ? SIT_SEND_SMS_EXPECT_MORE : SIT_SEND_SMS,
+                                        req, sizeof (req),
+                                        MM_BASE_SMS_DEFAULT_SEND_TIMEOUT,
+                                        (GAsyncReadyCallback) sms_send_ready,
+                                        task);
+}
+
+static void
+sms_send (MMBaseSms           *self,
+          GAsyncReadyCallback  callback,
+          gpointer             user_data)
+{
+    GTask          *task;
+    SmsSendContext *ctx;
+    MMShannonIms   *ims;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    ctx = g_new0 (SmsSendContext, 1);
+    ctx->current = mm_base_sms_get_parts (self);
+    ims = mm_broadband_modem_shannon_peek_ims (MM_BROADBAND_MODEM_SHANNON (MM_SMS_SHANNON (self)->priv->modem));
+    ctx->over_ims = ims && mm_shannon_ims_is_registered (ims);
+    g_task_set_task_data (task, ctx, g_free);
+    sms_send_next_part (task);
+}
+
+/*****************************************************************************/
+/* Delete: received messages are never stored on the device */
+
+static gboolean
+sms_delete_finish (MMBaseSms     *self,
+                   GAsyncResult  *res,
+                   GError       **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void
+sms_delete (MMBaseSms           *self,
+            GAsyncReadyCallback  callback,
+            gpointer             user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+/*****************************************************************************/
+
+MMBaseSms *
+mm_sms_shannon_new (MMBaseModem  *modem,
+                    MMSmsStorage  default_storage)
+{
+    MMBaseSms *sms;
+
+    g_return_val_if_fail (MM_IS_BROADBAND_MODEM_SHANNON (modem), NULL);
+
+    sms = MM_BASE_SMS (g_object_new (MM_TYPE_SMS_SHANNON,
+                                     MM_BIND_TO, G_OBJECT (modem),
+                                     MM_BASE_SMS_IS_3GPP, TRUE,
+                                     MM_BASE_SMS_DEFAULT_STORAGE, default_storage,
+                                     NULL));
+    MM_SMS_SHANNON (sms)->priv->modem = g_object_ref (modem);
+    return sms;
+}
+
+static void
+mm_sms_shannon_init (MMSmsShannon *self)
+{
+    self->priv = G_TYPE_INSTANCE_GET_PRIVATE (self, MM_TYPE_SMS_SHANNON, MMSmsShannonPrivate);
+}
+
+static void
+dispose (GObject *object)
+{
+    MMSmsShannon *self = MM_SMS_SHANNON (object);
+
+    g_clear_object (&self->priv->modem);
+    G_OBJECT_CLASS (mm_sms_shannon_parent_class)->dispose (object);
+}
+
+static void
+mm_sms_shannon_class_init (MMSmsShannonClass *klass)
+{
+    GObjectClass   *object_class = G_OBJECT_CLASS (klass);
+    MMBaseSmsClass *base_sms_class = MM_BASE_SMS_CLASS (klass);
+
+    g_type_class_add_private (object_class, sizeof (MMSmsShannonPrivate));
+    object_class->dispose = dispose;
+
+    base_sms_class->store = NULL;
+    base_sms_class->store_finish = NULL;
+    base_sms_class->send = sms_send;
+    base_sms_class->send_finish = sms_send_finish;
+    base_sms_class->delete = sms_delete;
+    base_sms_class->delete_finish = sms_delete_finish;
+}
diff --git a/src/plugins/shannon/mm-sms-shannon.h b/src/plugins/shannon/mm-sms-shannon.h
new file mode 100644
index 00000000..dfa172dd
--- /dev/null
+++ b/src/plugins/shannon/mm-sms-shannon.h
@@ -0,0 +1,43 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SMS sent over SIT on a Shannon modem (local plugin). Received messages are
+ * not stored on the device (the CP hands them over in IND 0x010c and the
+ * modem object acks them), so there is nothing to store or delete there.
+ */
+
+#ifndef MM_SMS_SHANNON_H
+#define MM_SMS_SHANNON_H
+
+#include <glib.h>
+#include <glib-object.h>
+
+#include "mm-base-modem.h"
+#include "mm-base-sms.h"
+
+#define MM_TYPE_SMS_SHANNON            (mm_sms_shannon_get_type ())
+#define MM_SMS_SHANNON(obj)            (G_TYPE_CHECK_INSTANCE_CAST ((obj), MM_TYPE_SMS_SHANNON, MMSmsShannon))
+#define MM_SMS_SHANNON_CLASS(klass)    (G_TYPE_CHECK_CLASS_CAST ((klass),  MM_TYPE_SMS_SHANNON, MMSmsShannonClass))
+#define MM_IS_SMS_SHANNON(obj)         (G_TYPE_CHECK_INSTANCE_TYPE ((obj), MM_TYPE_SMS_SHANNON))
+#define MM_IS_SMS_SHANNON_CLASS(klass) (G_TYPE_CHECK_CLASS_TYPE ((klass),  MM_TYPE_SMS_SHANNON))
+#define MM_SMS_SHANNON_GET_CLASS(obj)  (G_TYPE_INSTANCE_GET_CLASS ((obj),  MM_TYPE_SMS_SHANNON, MMSmsShannonClass))
+
+typedef struct _MMSmsShannon MMSmsShannon;
+typedef struct _MMSmsShannonClass MMSmsShannonClass;
+typedef struct _MMSmsShannonPrivate MMSmsShannonPrivate;
+
+struct _MMSmsShannon {
+    MMBaseSms parent;
+    MMSmsShannonPrivate *priv;
+};
+
+struct _MMSmsShannonClass {
+    MMBaseSmsClass parent;
+};
+
+GType mm_sms_shannon_get_type (void);
+G_DEFINE_AUTOPTR_CLEANUP_FUNC (MMSmsShannon, g_object_unref)
+
+MMBaseSms *mm_sms_shannon_new (MMBaseModem  *modem,
+                               MMSmsStorage  default_storage);
+
+#endif /* MM_SMS_SHANNON_H */
