+/*****************************************************************************/
+/* Power */
+
+static gboolean
+radio_power_is_on (GBytes *payload)
+{
+    const guint8 *d;
+    gsize         len;
+    guint32       v;
+
+    d = g_bytes_get_data (payload, &len);
+    if (len < 4)
+        return FALSE;
+    /* 0 off, 1 unavailable, 2..10 on (SIM state variants; 10 = ON) */
+    v = d[0] | (d[1] << 8) | (d[2] << 16) | ((guint32) d[3] << 24);
+    return v >= 2;
+}
+
+static void
+power_state_ready (MMBroadbandModemShannon *self,
+                   GAsyncResult            *res,
+                   GTask                   *task)
+{
+    g_autoptr(GBytes) payload = NULL;
+    GError           *error = NULL;
+
+    payload = SIT_FINISH (self, res, &error);
+    if (!payload)
+        g_task_return_error (task, error);
+    else
+        g_task_return_int (task, radio_power_is_on (payload) ? MM_MODEM_POWER_STATE_ON : MM_MODEM_POWER_STATE_LOW);
+    g_object_unref (task);
+}
+
+static MMModemPowerState
+load_power_state_finish (MMIfaceModem  *self,
+                         GAsyncResult  *res,
+                         GError       **error)
+{
