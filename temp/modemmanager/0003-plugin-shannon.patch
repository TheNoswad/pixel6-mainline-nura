+static void
+modem_3gpp_setup_unsolicited_events (MMIfaceModem3gpp    *self,
+                                     GAsyncReadyCallback  callback,
+                                     gpointer             user_data)
+{
+    MM_BROADBAND_MODEM_SHANNON (self)->priv->unsolicited_events_enabled = TRUE;
+    return_true (self, callback, user_data);
+}
+
+static void
+modem_3gpp_cleanup_unsolicited_events (MMIfaceModem3gpp    *self,
+                                       GAsyncReadyCallback  callback,
+                                       gpointer             user_data)
+{
+    MM_BROADBAND_MODEM_SHANNON (self)->priv->unsolicited_events_enabled = FALSE;
+    return_true (self, callback, user_data);
+}
+
+static gboolean
+watchdog_tick_cb (MMBroadbandModemShannon *self)
+{
+    ps_idle_watchdog (self);
+    return G_SOURCE_CONTINUE;
+}
+
+static void
+modem_3gpp_enable_registration_events (MMIfaceModem3gpp    *self,
+                                       gboolean             cs_supported,
+                                       gboolean             ps_supported,
+                                       gboolean             eps_supported,
+                                       GAsyncReadyCallback  callback,
+                                       gpointer             user_data)
+{
+    MMBroadbandModemShannon *shannon = MM_BROADBAND_MODEM_SHANNON (self);
+
+    shannon->priv->registration_events_enabled = TRUE;
+    if (!shannon->priv->watchdog_id)
+        shannon->priv->watchdog_id = g_timeout_add_seconds (10, (GSourceFunc) watchdog_tick_cb, shannon);
+    /* a registration check also arms the idle watchdog right away */
+    schedule_registration_check (shannon);
+    return_true (self, callback, user_data);
+}
+
+static void
+modem_3gpp_disable_registration_events (MMIfaceModem3gpp    *self,
+                                        gboolean             cs_supported,
+                                        gboolean             ps_supported,
+                                        gboolean             eps_supported,
+                                        GAsyncReadyCallback  callback,
+                                        gpointer             user_data)
+{
+    MMBroadbandModemShannon *shannon = MM_BROADBAND_MODEM_SHANNON (self);
+
+    shannon->priv->registration_events_enabled = FALSE;
+    shannon->priv->ps_idle_since = 0;
+    if (shannon->priv->watchdog_id) {
+        g_source_remove (shannon->priv->watchdog_id);
+        shannon->priv->watchdog_id = 0;
+    }
+    if (shannon->priv->registration_check_id) {
+        g_source_remove (shannon->priv->registration_check_id);
+        shannon->priv->registration_check_id = 0;
+    }
+    return_true (self, callback, user_data);
+}
