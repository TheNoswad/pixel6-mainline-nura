+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SIM card behind a Shannon modem, read over SIT (local plugin).
+ */
+
+#ifndef MM_SIM_SHANNON_H
+#define MM_SIM_SHANNON_H
+
+#include <glib.h>
+#include <glib-object.h>
+
+#include "mm-base-sim.h"
+
+#define MM_TYPE_SIM_SHANNON            (mm_sim_shannon_get_type ())
+#define MM_SIM_SHANNON(obj)            (G_TYPE_CHECK_INSTANCE_CAST ((obj), MM_TYPE_SIM_SHANNON, MMSimShannon))
+#define MM_SIM_SHANNON_CLASS(klass)    (G_TYPE_CHECK_CLASS_CAST ((klass),  MM_TYPE_SIM_SHANNON, MMSimShannonClass))
+#define MM_IS_SIM_SHANNON(obj)         (G_TYPE_CHECK_INSTANCE_TYPE ((obj), MM_TYPE_SIM_SHANNON))
+#define MM_IS_SIM_SHANNON_CLASS(klass) (G_TYPE_CHECK_CLASS_TYPE ((klass),  MM_TYPE_SIM_SHANNON))
+#define MM_SIM_SHANNON_GET_CLASS(obj)  (G_TYPE_INSTANCE_GET_CLASS ((obj),  MM_TYPE_SIM_SHANNON, MMSimShannonClass))
+
+typedef struct _MMSimShannon MMSimShannon;
+typedef struct _MMSimShannonClass MMSimShannonClass;
+
+struct _MMSimShannon {
+    MMBaseSim parent;
+};
+
+struct _MMSimShannonClass {
+    MMBaseSimClass parent;
+};
+
+GType mm_sim_shannon_get_type (void);
+G_DEFINE_AUTOPTR_CLEANUP_FUNC (MMSimShannon, g_object_unref)
+
+void       mm_sim_shannon_new        (MMBaseModem         *modem,
+                                      GCancellable        *cancellable,
+                                      GAsyncReadyCallback  callback,
+                                      gpointer             user_data);
+MMBaseSim *mm_sim_shannon_new_finish (GAsyncResult        *res,
+                                      GError             **error);
+
+/* IMSI, ICCID and GID1 (hex; NULL when the SIM has no EF_GID1), read before
+ * the SIM object exists: the CP's carrier config depends on them */
+typedef struct _MMBroadbandModemShannon MMBroadbandModemShannon;
+void     mm_sim_shannon_read_identity        (MMBroadbandModemShannon  *modem,
+                                              GAsyncReadyCallback       callback,
+                                              gpointer                  user_data);
+gboolean mm_sim_shannon_read_identity_finish (MMBroadbandModemShannon  *modem,
+                                              GAsyncResult             *res,
+                                              gchar                   **imsi,
+                                              gchar                   **gid1,
+                                              gchar                   **iccid,
+                                              GError                  **error);
+
