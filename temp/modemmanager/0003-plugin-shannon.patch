+    iface->load_supported_storages = messaging_check_support;
+    iface->load_supported_storages_finish = messaging_load_supported_storages_finish;
+    iface->setup_sms_format = NULL;
+    iface->setup_sms_format_finish = NULL;
+    iface->set_default_storage = NULL;
+    iface->set_default_storage_finish = NULL;
+    iface->init_current_storages = NULL;
+    iface->init_current_storages_finish = NULL;
+    iface->lock_storages = NULL;
+    iface->lock_storages_finish = NULL;
+    iface->unlock_storages = NULL;
+    iface->load_initial_sms_parts = messaging_load_initial_sms_parts;
+    iface->load_initial_sms_parts_finish = messaging_load_initial_sms_parts_finish;
+    iface->setup_unsolicited_events = messaging_events_noop;
+    iface->setup_unsolicited_events_finish = messaging_events_finish;
+    iface->cleanup_unsolicited_events = messaging_events_noop;
+    iface->cleanup_unsolicited_events_finish = messaging_events_finish;
+    iface->enable_unsolicited_events = messaging_enable_unsolicited_events;
+    iface->enable_unsolicited_events_finish = messaging_events_finish;
+    iface->disable_unsolicited_events = messaging_disable_unsolicited_events;
+    iface->disable_unsolicited_events_finish = messaging_events_finish;
+}
+
+/*****************************************************************************/
+/* Voice: SIT call control, call list from GET_CURRENT_CALLS */
+
+static gboolean
+voice_check_support_finish (MMIfaceModemVoice  *self,
+                            GAsyncResult       *res,
+                            GError            **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void
+voice_check_support (MMIfaceModemVoice   *self,
+                     GAsyncReadyCallback  callback,
+                     gpointer             user_data)
+{
+    GTask *task;
+
+    /* call state INDs drive the call list; no polling (a poll racing a
+     * dial that the CP has not listed yet would terminate the call) */
+    g_object_set (self,
+                  MM_IFACE_MODEM_VOICE_PERIODIC_CALL_LIST_CHECK_DISABLED, TRUE,
+                  NULL);
+    task = g_task_new (self, NULL, callback, user_data);
+    g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static gboolean
+voice_events_finish (MMIfaceModemVoice  *self,
+                     GAsyncResult       *res,
+                     GError            **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void
+voice_set_events (MMIfaceModemVoice   *_self,
+                  gboolean             enabled,
+                  GAsyncReadyCallback  callback,
+                  gpointer             user_data)
+{
+    MMBroadbandModemShannon *self = MM_BROADBAND_MODEM_SHANNON (_self);
+    GTask                   *task;
+
+    self->priv->voice_events_enabled = enabled;
+    /* modem being disabled: deregister and drop the IMS PDN */
+    if (!enabled && self->priv->ims)
+        mm_shannon_ims_stop (self->priv->ims);
+    task = g_task_new (self, NULL, callback, user_data);
+    g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+voice_enable_unsolicited_events (MMIfaceModemVoice   *self,
+                                 GAsyncReadyCallback  callback,
+                                 gpointer             user_data)
+{
+    voice_set_events (self, TRUE, callback, user_data);
+}
+
+static void
+voice_disable_unsolicited_events (MMIfaceModemVoice   *self,
+                                  GAsyncReadyCallback  callback,
+                                  gpointer             user_data)
+{
+    voice_set_events (self, FALSE, callback, user_data);
+}
+
+static gboolean
+voice_load_call_list_finish (MMIfaceModemVoice  *self,
+                             GAsyncResult       *res,
+                             GList             **out_call_info_list,
+                             GError            **error)
+{
+    GError *inner_error = NULL;
+    GList  *list;
+
+    list = g_task_propagate_pointer (G_TASK (res), &inner_error);
+    if (inner_error) {
+        g_propagate_error (error, inner_error);
+        return FALSE;
+    }
+    *out_call_info_list = list;
+    return TRUE;
+}
+
+static gboolean
+call_list_retry_cb (MMBroadbandModemShannon *self)
+{
+    self->priv->call_list_retry_id = 0;
+    mm_iface_modem_voice_reload_all_calls (MM_IFACE_MODEM_VOICE (self), NULL, NULL);
+    return G_SOURCE_REMOVE;
+}
+
+static void
+fail_cause_ready (MMBroadbandModemShannon *self,
+                  GAsyncResult            *res)
+{
+    g_autoptr(GBytes)  payload = NULL;
+    g_autoptr(GError)  error = NULL;
+    g_autofree gchar  *hex = NULL;
+    gsize              len;
+    const guint8      *d;
+
+    payload = SIT_FINISH (self, res, &error);
+    if (!payload) {
+        mm_obj_dbg (self, "couldn't get last call fail cause: %s", error->message);
+        return;
+    }
+    d = g_bytes_get_data (payload, &len);
+    hex = len ? mm_utils_bin2hexstr (d, len) : NULL;
+    mm_obj_info (self, "last call fail cause: %s", hex ? hex : "(empty)");
+}
+
+static void
+call_list_ready (MMBroadbandModemShannon *self,
+                 GAsyncResult            *res,
+                 GTask                   *task)
+{
+    g_autoptr(GBytes)  payload = NULL;
+    GError            *error = NULL;
+    GList             *list = NULL;
+    GList             *l;
+    guint              count;
+
+    payload = SIT_FINISH (self, res, &error);
+    if (!payload || !mm_sit_parse_call_list (payload, self, &list, &error)) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    count = g_list_length (list);
+    if (count < self->priv->last_call_count)
+        SIT_CMD (self, SIT_GET_LAST_CALL_FAIL_CAUSE, NULL, 0, 10, fail_cause_ready, NULL);
+    self->priv->last_call_count = count;
+
+    /* a call the CP is still setting up is listed with index 0, which MM
+     * cannot track (report_all_calls asserts on it): skip this report and
+     * look again shortly */
+    for (l = list; l; l = g_list_next (l)) {
+        if (((MMCallInfo *) l->data)->index == 0) {
+            mm_3gpp_call_info_list_free (list);
+            if (!self->priv->call_list_retry_id)
+                self->priv->call_list_retry_id =
+                    g_timeout_add (500, (GSourceFunc) call_list_retry_cb, self);
+            g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_RETRY,
+                                     "call without index yet, retrying");
+            g_object_unref (task);
+            return;
+        }
+    }
+
+    g_task_return_pointer (task, list, (GDestroyNotify) mm_3gpp_call_info_list_free);
+    g_object_unref (task);
+}
+
+static void
+voice_load_call_list (MMIfaceModemVoice   *self,
+                      GAsyncReadyCallback  callback,
+                      gpointer             user_data)
+{
+    MMShannonIms *ims = MM_BROADBAND_MODEM_SHANNON (self)->priv->ims;
+    GTask        *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    /* VoLTE calls are tracked from the AIMS INDs; the CS list doesn't have them */
+    if (ims && (mm_shannon_ims_is_registered (ims) || mm_shannon_ims_has_calls (ims))) {
+        if (mm_shannon_ims_dial_pending (ims))
+            g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_RETRY,
+                                     "VoLTE dial in progress");
+        else
+            g_task_return_pointer (task, mm_shannon_ims_get_call_list (ims),
+                                   (GDestroyNotify) mm_3gpp_call_info_list_free);
+        g_object_unref (task);
+        return;
+    }
+    SIT_CMD (self, SIT_GET_CURRENT_CALLS, NULL, 0, 10, call_list_ready, task);
+}
+
+static MMBaseCall *
+voice_create_call (MMIfaceModemVoice *self,
+                   MMCallDirection    direction,
+                   const gchar       *number,
+                   const guint        dtmf_tone_duration)
+{
+    return mm_call_shannon_new (MM_BASE_MODEM (self), direction, number, dtmf_tone_duration);
+}
+
+/* hold/accept and hangup-all map onto the 3GPP CHLD-style SIT requests */
+static gboolean
+voice_manage_calls_finish (MMIfaceModemVoice  *self,
+                           GAsyncResult       *res,
+                           GError            **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void
+manage_calls_ready (MMBroadbandModemShannon *self,
+                    GAsyncResult            *res,
+                    GTask                   *task)
+{
+    g_autoptr(GBytes)  payload = NULL;
+    GError            *error = NULL;
+
+    payload = SIT_FINISH (self, res, &error);
+    if (!payload)
+        g_task_return_error (task, error);
+    else
+        g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+    mm_iface_modem_voice_reload_all_calls (MM_IFACE_MODEM_VOICE (self), NULL, NULL);
+}
+
+static void
+voice_hold_and_accept (MMIfaceModemVoice   *self,
+                       GAsyncReadyCallback  callback,
+                       gpointer             user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    SIT_CMD (self, SIT_SWITCH_WAITING_OR_HOLDING_AND_ACTIVE, NULL, 0, 15, manage_calls_ready, task);
+}
+
+static void
+voice_hangup_and_accept (MMIfaceModemVoice   *self,
+                         GAsyncReadyCallback  callback,
+                         gpointer             user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    SIT_CMD (self, SIT_HANGUP_FOREGROUND_RESUME_BACKGROUND, NULL, 0, 15, manage_calls_ready, task);
+}
+
+static void
+iface_modem_voice_init (MMIfaceModemVoiceInterface *iface)
+{
+    iface->check_support = voice_check_support;
+    iface->check_support_finish = voice_check_support_finish;
+    iface->setup_unsolicited_events = NULL;
+    iface->setup_unsolicited_events_finish = NULL;
+    iface->cleanup_unsolicited_events = NULL;
+    iface->cleanup_unsolicited_events_finish = NULL;
+    iface->enable_unsolicited_events = voice_enable_unsolicited_events;
+    iface->enable_unsolicited_events_finish = voice_events_finish;
+    iface->disable_unsolicited_events = voice_disable_unsolicited_events;
+    iface->disable_unsolicited_events_finish = voice_events_finish;
+    iface->setup_in_call_unsolicited_events = NULL;
+    iface->setup_in_call_unsolicited_events_finish = NULL;
+    iface->cleanup_in_call_unsolicited_events = NULL;
+    iface->cleanup_in_call_unsolicited_events_finish = NULL;
+    iface->setup_in_call_audio_channel = NULL;
+    iface->setup_in_call_audio_channel_finish = NULL;
+    iface->cleanup_in_call_audio_channel = NULL;
+    iface->cleanup_in_call_audio_channel_finish = NULL;
+    iface->load_call_list = voice_load_call_list;
+    iface->load_call_list_finish = voice_load_call_list_finish;
+    iface->create_call = voice_create_call;
+    iface->hold_and_accept = voice_hold_and_accept;
+    iface->hold_and_accept_finish = voice_manage_calls_finish;
+    iface->hangup_and_accept = voice_hangup_and_accept;
+    iface->hangup_and_accept_finish = voice_manage_calls_finish;
+    iface->hangup_all = NULL;
+    iface->hangup_all_finish = NULL;
+    iface->join_multiparty = NULL;
+    iface->join_multiparty_finish = NULL;
+    iface->leave_multiparty = NULL;
+    iface->leave_multiparty_finish = NULL;
+    iface->transfer = NULL;
+    iface->transfer_finish = NULL;
+    iface->call_waiting_setup = NULL;
+    iface->call_waiting_setup_finish = NULL;
+    iface->call_waiting_query = NULL;
+    iface->call_waiting_query_finish = NULL;
+}
+
+static void
+mm_broadband_modem_shannon_class_init (MMBroadbandModemShannonClass *klass)
+{
+    GObjectClass          *object_class = G_OBJECT_CLASS (klass);
+    MMBroadbandModemClass *broadband_modem_class = MM_BROADBAND_MODEM_CLASS (klass);
+
+    g_type_class_add_private (object_class, sizeof (MMBroadbandModemShannonPrivate));
+    object_class->dispose = dispose;
+    object_class->finalize = finalize;
+
+    broadband_modem_class->initialization_started = initialization_started;
+    broadband_modem_class->initialization_started_finish = initialization_started_finish;
+    broadband_modem_class->enabling_started = enabling_started;
+    broadband_modem_class->enabling_started_finish = enabling_started_finish;
+    broadband_modem_class->enabling_modem_init = NULL;
+    broadband_modem_class->enabling_modem_init_finish = NULL;
+    broadband_modem_class->create_sms = messaging_create_sms;
+}
diff --git a/src/plugins/shannon/mm-broadband-modem-shannon.h b/src/plugins/shannon/mm-broadband-modem-shannon.h
new file mode 100644
index 00000000..e2fba700
--- /dev/null
+++ b/src/plugins/shannon/mm-broadband-modem-shannon.h
@@ -0,0 +1,85 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * Samsung Shannon modem driven over SIT (cpif), Google Pixel 6 (local plugin).
+ */
+
+#ifndef MM_BROADBAND_MODEM_SHANNON_H
+#define MM_BROADBAND_MODEM_SHANNON_H
+
+#include "mm-broadband-modem.h"
+#include "mm-port-sit.h"
+
+#define MM_TYPE_BROADBAND_MODEM_SHANNON            (mm_broadband_modem_shannon_get_type ())
+#define MM_BROADBAND_MODEM_SHANNON(obj)            (G_TYPE_CHECK_INSTANCE_CAST ((obj), MM_TYPE_BROADBAND_MODEM_SHANNON, MMBroadbandModemShannon))
+#define MM_BROADBAND_MODEM_SHANNON_CLASS(klass)    (G_TYPE_CHECK_CLASS_CAST ((klass),  MM_TYPE_BROADBAND_MODEM_SHANNON, MMBroadbandModemShannonClass))
+#define MM_IS_BROADBAND_MODEM_SHANNON(obj)         (G_TYPE_CHECK_INSTANCE_TYPE ((obj), MM_TYPE_BROADBAND_MODEM_SHANNON))
+#define MM_IS_BROADBAND_MODEM_SHANNON_CLASS(klass) (G_TYPE_CHECK_CLASS_TYPE ((klass),  MM_TYPE_BROADBAND_MODEM_SHANNON))
+#define MM_BROADBAND_MODEM_SHANNON_GET_CLASS(obj)  (G_TYPE_INSTANCE_GET_CLASS ((obj),  MM_TYPE_BROADBAND_MODEM_SHANNON, MMBroadbandModemShannonClass))
+
+typedef struct _MMBroadbandModemShannon MMBroadbandModemShannon;
+typedef struct _MMBroadbandModemShannonClass MMBroadbandModemShannonClass;
+typedef struct _MMBroadbandModemShannonPrivate MMBroadbandModemShannonPrivate;
+
+struct _MMBroadbandModemShannon {
+    MMBroadbandModem parent;
+    MMBroadbandModemShannonPrivate *priv;
+};
+
+struct _MMBroadbandModemShannonClass {
+    MMBroadbandModemClass parent;
+};
+
+GType mm_broadband_modem_shannon_get_type (void);
+G_DEFINE_AUTOPTR_CLEANUP_FUNC (MMBroadbandModemShannon, g_object_unref)
+
+MMBroadbandModemShannon *mm_broadband_modem_shannon_new (const gchar  *device,
+                                                         const gchar  *physdev,
+                                                         const gchar **drivers,
+                                                         const gchar  *plugin,
+                                                         guint16       vendor_id,
+                                                         guint16       product_id);
+
+/* The open SIT port (NULL before initialization or after the CP went away) */
+MMPortSit *mm_broadband_modem_shannon_peek_port_sit (MMBroadbandModemShannon *self);
+
+/* VoLTE (NULL when [ims] is not enabled) */
+typedef struct _MMShannonIms MMShannonIms;
+MMShannonIms *mm_broadband_modem_shannon_peek_ims (MMBroadbandModemShannon *self);
+
+/* Convenience wrapper: fails with WRONG_STATE if there is no open port */
+void    mm_broadband_modem_shannon_command        (MMBroadbandModemShannon *self,
+                                                   guint16                  id,
+                                                   const guint8            *payload,
+                                                   gsize                    payload_len,
+                                                   guint                    timeout_seconds,
+                                                   GAsyncReadyCallback      callback,
+                                                   gpointer                 user_data);
+GBytes *mm_broadband_modem_shannon_command_finish (MMBroadbandModemShannon *self,
+                                                   GAsyncResult            *res,
+                                                   GError                 **error);
+
+/* Build the APN record shared by SETUP_DATA_CALL (frame 0xf6) and
+ * SET_INITIAL_ATTACH_APN (frame 0xfb); returns the payload */
+GByteArray *mm_broadband_modem_shannon_build_apn_payload (guint16      frame_len,
+                                                          guint8       cid,
+                                                          const gchar *apn,
+                                                          guint8       pdp_type);
+/* SETUP_DATA_CALL request (v2 frame, matchAllRuleAllowed); apn_type: SIT
+ * APN type (0 default, 1 IMS, 2 emergency); pcscf_type: pdp type or 0 */
+GByteArray *mm_broadband_modem_shannon_build_setup_data_call (guint8       cid,
+                                                              const gchar *apn,
+                                                              guint8       pdp_type,
+                                                              guint8       apn_type,
+                                                              guint8       pcscf_type);
+
+/* SMSC from the SIM (GET_SMSC_ADDR at messaging enable) as the SEND_SMS
+ * smsc field: TS 24.011 RP address with its own length byte; NULL if unknown.
+ * The CP does not fill in a default SMSC: without one sends fail (cause 98). */
+GByteArray *mm_broadband_modem_shannon_peek_smsc (MMBroadbandModemShannon *self);
+
+/* SEND_SMS domain byte ([sms] domain in shannon.conf, default 0) */
+guint8 mm_broadband_modem_shannon_get_sms_domain (MMBroadbandModemShannon *self);
+
+guint8 mm_broadband_modem_shannon_pdp_type_from_ip_family (MMBearerIpFamily family);
+
+#endif /* MM_BROADBAND_MODEM_SHANNON_H */
diff --git a/src/plugins/shannon/mm-call-shannon.c b/src/plugins/shannon/mm-call-shannon.c
new file mode 100644
index 00000000..e86a6e6a
--- /dev/null
+++ b/src/plugins/shannon/mm-call-shannon.c
@@ -0,0 +1,370 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * Voice call over SIT on a Shannon modem (local plugin). While IMS is
+ * registered (or has calls) the AIMS requests are used (VoLTE, see
+ * mm-shannon-ims.c), else the CS ones.
+ */
+
+#include <string.h>
+
+#define _LIBMM_INSIDE_MM
+#include <libmm-glib.h>
+
+#include "mm-log-object.h"
+#include "mm-errors-types.h"
+#include "mm-bind.h"
+#include "mm-iface-modem-voice.h"
+#include "mm-broadband-modem-shannon.h"
+#include "mm-call-shannon.h"
+#include "mm-sit-helpers.h"
+#include "mm-shannon-ims.h"
+
+G_DEFINE_TYPE (MMCallShannon, mm_call_shannon, MM_TYPE_BASE_CALL)
+
+struct _MMCallShannonPrivate {
+    MMBaseModem *modem;
+};
+
+#define CALL_CMD(self, id, data, len, timeout, cb, task)                                    \
+    mm_broadband_modem_shannon_command (MM_BROADBAND_MODEM_SHANNON ((self)->priv->modem),  \
+                                        id, data, len, timeout, (GAsyncReadyCallback) (cb), task)
+
+/* the CP sends IND_CALL_STATE_CHANGED too, but reload once more after each
+ * request so the index and state are picked up even if that IND is missed */
+static void
+reload_calls (MMCallShannon *self)
+{
+    mm_iface_modem_voice_reload_all_calls (MM_IFACE_MODEM_VOICE (self->priv->modem), NULL, NULL);
+}
+
+/* common completion: TRUE on an error-free SIT RSP */
+static void
+command_ready (MMBroadbandModemShannon *modem,
+               GAsyncResult            *res,
+               GTask                   *task)
+{
+    MMCallShannon     *self = g_task_get_source_object (task);
+    g_autoptr(GBytes)  payload = NULL;
+    GError            *error = NULL;
+    const gchar       *what = g_task_get_task_data (task);
+
+    payload = mm_broadband_modem_shannon_command_finish (modem, res, &error);
+    if (!payload) {
+        g_prefix_error (&error, "Couldn't %s: ", what);
+        g_task_return_error (task, error);
+    } else {
+        gsize             len;
+        const guint8     *d = g_bytes_get_data (payload, &len);
+        g_autofree gchar *hex = len ? mm_utils_bin2hexstr (d, len) : NULL;
+
+        mm_obj_dbg (self, "%s done%s%s", what, hex ? ": " : "", hex ? hex : "");
+        g_task_return_boolean (task, TRUE);
+        reload_calls (self);
+    }
+    g_object_unref (task);
+}
+
+/* AIMS: state comes from the AIMS call INDs, no reload (a call list
+ * report racing the first status IND would terminate a new call) */
+static void
+aims_command_ready (MMBroadbandModemShannon *modem,
+                    GAsyncResult            *res,
+                    GTask                   *task)
+{
+    MMCallShannon     *self = g_task_get_source_object (task);
+    g_autoptr(GBytes)  payload = NULL;
+    GError            *error = NULL;
+    const gchar       *what = g_task_get_task_data (task);
+
+    payload = mm_broadband_modem_shannon_command_finish (modem, res, &error);
+    if (!payload) {
+        MMShannonIms *ims = mm_broadband_modem_shannon_peek_ims (modem);
+
+        if (ims && !g_strcmp0 (what, "dial (VoLTE)"))
+            mm_shannon_ims_set_dial_pending (ims, FALSE);
+        g_prefix_error (&error, "Couldn't %s: ", what);
+        g_task_return_error (task, error);
+    } else {
+        mm_obj_dbg (self, "%s done", what);
+        g_task_return_boolean (task, TRUE);
+    }
+    g_object_unref (task);
+}
+
+/* the IMS object if VoLTE call control applies */
+static MMShannonIms *
+peek_aims (MMCallShannon *self)
+{
+    MMShannonIms *ims;
+
+    ims = mm_broadband_modem_shannon_peek_ims (MM_BROADBAND_MODEM_SHANNON (self->priv->modem));
+    if (ims && (mm_shannon_ims_is_registered (ims) || mm_shannon_ims_has_calls (ims)))
+        return ims;
+    return NULL;
+}
+
+/* CP call id: from the index (CP id + 1), else the call being set up */
+static guint8
+aims_call_id (MMCallShannon *self,
+              MMShannonIms  *ims)
+{
+    guint idx = mm_base_call_get_index (MM_BASE_CALL (self));
+    gint  id;
+
+    if (idx)
+        return idx - 1;
+    id = mm_shannon_ims_get_dialing_call_id (ims);
+    return id >= 0 ? id : 0;
+}
+
+static gboolean
+common_finish (MMBaseCall    *self,
+               GAsyncResult  *res,
+               GError       **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+/*****************************************************************************/
+/* Start (dial) */
+
+static void
+call_start (MMBaseCall          *_self,
+            GCancellable        *cancellable,
+            GAsyncReadyCallback  callback,
+            gpointer             user_data)
+{
+    MMCallShannon *self = MM_CALL_SHANNON (_self);
+    GTask         *task;
+    const gchar   *number;
+    guint8         payload[SIT_DIAL_PAYLOAD_LEN] = { 0 };
+    gsize          n;
+    MMShannonIms  *ims;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    g_task_set_task_data (task, (gpointer) "dial", NULL);
+
+    number = mm_gdbus_call_get_number (MM_GDBUS_CALL (self));
+    n = number ? strlen (number) : 0;
+
+    ims = peek_aims (self);
+    if (ims && n) {
+        g_autoptr(GByteArray) req = mm_shannon_ims_build_dial (number);
+
+        g_task_set_task_data (task, (gpointer) "dial (VoLTE)", NULL);
+        mm_shannon_ims_set_dial_pending (ims, TRUE);
+        mm_obj_dbg (self, "dialing %s over IMS", number);
+        CALL_CMD (self, SIT_AIMS_DIAL, req->data, req->len, 60, aims_command_ready, task);
+        return;
+    }
+    if (!n || n > SIT_DIAL_NUMBER_MAX) {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_INVALID_ARGS,
+                                 "Invalid number length (%" G_GSIZE_FORMAT ")", n);
+        g_object_unref (task);
+        return;
+    }
+
+    payload[0] = 1;                 /* voice */
+    payload[1] = 0;
+    payload[2] = n;
+    memcpy (payload + 3, number, n);
+    payload[3 + SIT_DIAL_NUMBER_MAX] = 0;
+    payload[3 + SIT_DIAL_NUMBER_MAX + 1] = number[0] == '+' ? 0x10 : 0x20;
+    payload[3 + SIT_DIAL_NUMBER_MAX + 2] = 1;
+    payload[3 + SIT_DIAL_NUMBER_MAX + 3] = 0xff;   /* CLIR: network default */
+
+    mm_obj_dbg (self, "dialing %s", number);
+    CALL_CMD (self, SIT_DIAL, payload, sizeof (payload), 60, command_ready, task);
+}
+
+/*****************************************************************************/
+/* Accept */
+
+static void
+call_accept (MMBaseCall          *_self,
+             GAsyncReadyCallback  callback,
+             gpointer             user_data)
+{
+    MMCallShannon *self = MM_CALL_SHANNON (_self);
+    GTask         *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    if (peek_aims (self)) {
+        g_autoptr(GByteArray) req = mm_shannon_ims_build_answer ();
+
+        g_task_set_task_data (task, (gpointer) "answer (VoLTE)", NULL);
+        CALL_CMD (self, SIT_AIMS_ANSWER, req->data, req->len, 15, aims_command_ready, task);
+        return;
+    }
+    g_task_set_task_data (task, (gpointer) "answer", NULL);
+    CALL_CMD (self, SIT_ANSWER, NULL, 0, 15, command_ready, task);
+}
+
+/*****************************************************************************/
+/* Hangup: by index, or the foreground call while the index is unknown */
+
+static void
+call_hangup (MMBaseCall          *_self,
+             GAsyncReadyCallback  callback,
+             gpointer             user_data)
+{
+    MMCallShannon *self = MM_CALL_SHANNON (_self);
+    GTask         *task;
+    guint          idx;
+    guint8         payload[8];
+    MMShannonIms  *ims;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    g_task_set_task_data (task, (gpointer) "hang up", NULL);
+
+    ims = peek_aims (self);
+    if (ims) {
+        g_autoptr(GByteArray) req = NULL;
+        guint8                id = aims_call_id (self, ims);
+        gboolean              reject;
+
+        reject = mm_base_call_get_state (_self) == MM_CALL_STATE_RINGING_IN ||
+                 mm_base_call_get_state (_self) == MM_CALL_STATE_WAITING;
+        req = mm_shannon_ims_build_hangup (id, reject ? SHANNON_IMS_HANGUP_REJECT : SHANNON_IMS_HANGUP_NORMAL);
+        g_task_set_task_data (task, (gpointer) (reject ? "reject (VoLTE)" : "hang up (VoLTE)"), NULL);
+        mm_obj_dbg (self, "%s IMS call %u", reject ? "rejecting" : "hanging up", id);
+        CALL_CMD (self, SIT_AIMS_HANGUP, req->data, req->len, 15, aims_command_ready, task);
+        return;
+    }
+
+    idx = mm_base_call_get_index (_self);
+    if (!idx) {
+        mm_obj_dbg (self, "hanging up the foreground call (index unknown)");
+        CALL_CMD (self, SIT_HANGUP_FOREGROUND_RESUME_BACKGROUND, NULL, 0, 15, command_ready, task);
+        return;
+    }
+
+    /* u32 index, u32 1 (2 = multiparty) */
+    payload[0] = idx & 0xff;
+    payload[1] = (idx >> 8) & 0xff;
+    payload[2] = (idx >> 16) & 0xff;
+    payload[3] = (idx >> 24) & 0xff;
+    payload[4] = 1;
+    payload[5] = payload[6] = payload[7] = 0;
+    mm_obj_dbg (self, "hanging up call %u", idx);
+    CALL_CMD (self, SIT_HANGUP, payload, sizeof (payload), 15, command_ready, task);
+}
+
+/*****************************************************************************/
+/* DTMF: one tone at a time (the base class paces them) */
+
+static gssize
+call_send_dtmf_finish (MMBaseCall    *self,
+                       GAsyncResult  *res,
+                       GError       **error)
+{
+    return g_task_propagate_int (G_TASK (res), error);
+}
+
+static void
+send_dtmf_ready (MMBroadbandModemShannon *modem,
+                 GAsyncResult            *res,
+                 GTask                   *task)
+{
+    g_autoptr(GBytes)  payload = NULL;
+    GError            *error = NULL;
+
+    payload = mm_broadband_modem_shannon_command_finish (modem, res, &error);
+    if (!payload)
+        g_task_return_error (task, error);
+    else
+        g_task_return_int (task, GPOINTER_TO_INT (g_task_get_task_data (task)));
+    g_object_unref (task);
+}
+
+static void
+call_send_dtmf (MMBaseCall          *_self,
+                const gchar         *dtmf,
+                GAsyncReadyCallback  callback,
+                gpointer             user_data)
+{
+    MMCallShannon *self = MM_CALL_SHANNON (_self);
+    GTask         *task;
+    guint8         payload[SIT_DTMF_PAYLOAD_LEN] = { 0 };
+    gsize          n;
+    MMShannonIms  *ims;
+
+    task = g_task_new (self, NULL, callback, user_data);
+
+    /* AIMS: one digit per request; the base class sends the rest */
+    ims = peek_aims (self);
+    if (ims && dtmf[0]) {
+        g_autoptr(GByteArray) req = mm_shannon_ims_build_dtmf (aims_call_id (self, ims), dtmf[0]);
+
+        g_task_set_task_data (task, GINT_TO_POINTER (1), NULL);
+        CALL_CMD (self, SIT_AIMS_SEND_DTMF, req->data, req->len, 10, send_dtmf_ready, task);
+        return;
+    }
+    n = MIN (strlen (dtmf), SIT_DTMF_MAX);
+    payload[0] = n;
+    memcpy (payload + 1, dtmf, n);
+    g_task_set_task_data (task, GINT_TO_POINTER ((gint) n), NULL);
+    CALL_CMD (self, SIT_DTMF, payload, sizeof (payload), 10, send_dtmf_ready, task);
+}
+
+/*****************************************************************************/
+
+MMBaseCall *
+mm_call_shannon_new (MMBaseModem     *modem,
+                     MMCallDirection  direction,
+                     const gchar     *number,
+                     guint            dtmf_tone_duration)
+{
+    MMBaseCall *call;
+
+    call = MM_BASE_CALL (g_object_new (MM_TYPE_CALL_SHANNON,
+                                       MM_BASE_CALL_IFACE_MODEM_VOICE,           modem,
+                                       MM_BIND_TO,                               modem,
+                                       MM_CALL_DIRECTION,                        direction,
+                                       MM_CALL_NUMBER,                           number,
+                                       MM_CALL_DTMF_TONE_DURATION,               dtmf_tone_duration,
+                                       MM_BASE_CALL_SKIP_INCOMING_TIMEOUT,       TRUE,
+                                       MM_BASE_CALL_SUPPORTS_DIALING_TO_RINGING, TRUE,
+                                       MM_BASE_CALL_SUPPORTS_RINGING_TO_ACTIVE,  TRUE,
+                                       NULL));
+    MM_CALL_SHANNON (call)->priv->modem = g_object_ref (modem);
+    return call;
+}
+
+static void
+mm_call_shannon_init (MMCallShannon *self)
+{
+    self->priv = G_TYPE_INSTANCE_GET_PRIVATE (self, MM_TYPE_CALL_SHANNON, MMCallShannonPrivate);
+}
+
+static void
+dispose (GObject *object)
+{
+    MMCallShannon *self = MM_CALL_SHANNON (object);
+
+    g_clear_object (&self->priv->modem);
+    G_OBJECT_CLASS (mm_call_shannon_parent_class)->dispose (object);
+}
+
+static void
+mm_call_shannon_class_init (MMCallShannonClass *klass)
+{
+    GObjectClass    *object_class = G_OBJECT_CLASS (klass);
+    MMBaseCallClass *base_call_class = MM_BASE_CALL_CLASS (klass);
+
+    g_type_class_add_private (object_class, sizeof (MMCallShannonPrivate));
+    object_class->dispose = dispose;
+
+    base_call_class->start = call_start;
+    base_call_class->start_finish = common_finish;
+    base_call_class->accept = call_accept;
+    base_call_class->accept_finish = common_finish;
+    base_call_class->hangup = call_hangup;
+    base_call_class->hangup_finish = common_finish;
+    base_call_class->send_dtmf = call_send_dtmf;
+    base_call_class->send_dtmf_finish = call_send_dtmf_finish;
+    base_call_class->deflect = NULL;
+    base_call_class->deflect_finish = NULL;
+    base_call_class->stop_dtmf = NULL;
+    base_call_class->stop_dtmf_finish = NULL;
+}
diff --git a/src/plugins/shannon/mm-call-shannon.h b/src/plugins/shannon/mm-call-shannon.h
new file mode 100644
index 00000000..0eaeb214
--- /dev/null
+++ b/src/plugins/shannon/mm-call-shannon.h
@@ -0,0 +1,44 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * Voice call over SIT on a Shannon modem (local plugin). Call state comes from
+ * GET_CURRENT_CALLS, reloaded by the modem object on IND_CALL_STATE_CHANGED.
+ */
+
+#ifndef MM_CALL_SHANNON_H
+#define MM_CALL_SHANNON_H
+
+#include <glib.h>
+#include <glib-object.h>
+
+#include "mm-base-modem.h"
+#include "mm-base-call.h"
+
+#define MM_TYPE_CALL_SHANNON            (mm_call_shannon_get_type ())
+#define MM_CALL_SHANNON(obj)            (G_TYPE_CHECK_INSTANCE_CAST ((obj), MM_TYPE_CALL_SHANNON, MMCallShannon))
+#define MM_CALL_SHANNON_CLASS(klass)    (G_TYPE_CHECK_CLASS_CAST ((klass),  MM_TYPE_CALL_SHANNON, MMCallShannonClass))
+#define MM_IS_CALL_SHANNON(obj)         (G_TYPE_CHECK_INSTANCE_TYPE ((obj), MM_TYPE_CALL_SHANNON))
+#define MM_IS_CALL_SHANNON_CLASS(klass) (G_TYPE_CHECK_CLASS_TYPE ((klass),  MM_TYPE_CALL_SHANNON))
+#define MM_CALL_SHANNON_GET_CLASS(obj)  (G_TYPE_INSTANCE_GET_CLASS ((obj),  MM_TYPE_CALL_SHANNON, MMCallShannonClass))
+
+typedef struct _MMCallShannon MMCallShannon;
+typedef struct _MMCallShannonClass MMCallShannonClass;
+typedef struct _MMCallShannonPrivate MMCallShannonPrivate;
+
+struct _MMCallShannon {
+    MMBaseCall parent;
+    MMCallShannonPrivate *priv;
+};
+
+struct _MMCallShannonClass {
+    MMBaseCallClass parent;
+};
+
+GType mm_call_shannon_get_type (void);
+G_DEFINE_AUTOPTR_CLEANUP_FUNC (MMCallShannon, g_object_unref)
+
+MMBaseCall *mm_call_shannon_new (MMBaseModem     *modem,
+                                 MMCallDirection  direction,
+                                 const gchar     *number,
+                                 guint            dtmf_tone_duration);
+
+#endif /* MM_CALL_SHANNON_H */
diff --git a/src/plugins/shannon/mm-plugin-shannon.c b/src/plugins/shannon/mm-plugin-shannon.c
new file mode 100644
index 00000000..bc24ed03
--- /dev/null
+++ b/src/plugins/shannon/mm-plugin-shannon.c
@@ -0,0 +1,79 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * Samsung Shannon modems controlled over SIT on cpif character devices
+ * (Google Pixel 6 / gs101 with the s5123 CP). Local plugin, not upstream.
+ *
+ * The ports are virtual devices without a common parent, so the udev rules
+ * tag them (ID_MM_SHANNON) and give them one ID_MM_PHYSDEV_UID.
+ */
+
+#include <gmodule.h>
+
+#define _LIBMM_INSIDE_MM
+#include <libmm-glib.h>
+
+#include "mm-plugin-common.h"
+#include "mm-log-object.h"
+#include "mm-broadband-modem-shannon.h"
+
+#define MM_TYPE_PLUGIN_SHANNON mm_plugin_shannon_get_type ()
+MM_DEFINE_PLUGIN (SHANNON, shannon, Shannon)
+
+/*****************************************************************************/
+
+static MMBaseModem *
+create_modem (MMPlugin     *self,
+              const gchar  *uid,
+              const gchar  *physdev,
+              const gchar **drivers,
+              guint16       vendor,
+              guint16       product,
+              guint16       subsystem_vendor,
+              guint16       subsystem_device,
+              GList        *probes,
+              GError      **error)
+{
+    if (!mm_port_probe_list_has_sit_port (probes)) {
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                     "Unsupported device: a SIT port is required");
+        return NULL;
+    }
+
+    mm_obj_dbg (self, "Shannon SIT modem found...");
+    return MM_BASE_MODEM (mm_broadband_modem_shannon_new (uid,
+                                                          physdev,
+                                                          drivers,
+                                                          mm_plugin_get_name (self),
+                                                          vendor,
+                                                          product));
+}
+
+/*****************************************************************************/
+
+MM_PLUGIN_NAMED_CREATOR_SCOPE MMPlugin *
+mm_plugin_create_shannon (void)
+{
+    static const gchar *subsystems[] = { "cpif", "net", NULL };
+    static const gchar *udev_tags[] = { "ID_MM_SHANNON", NULL };
+
+    return MM_PLUGIN (
+        g_object_new (MM_TYPE_PLUGIN_SHANNON,
+                      MM_PLUGIN_NAME,               MM_MODULE_NAME,
+                      MM_PLUGIN_ALLOWED_SUBSYSTEMS, subsystems,
+                      MM_PLUGIN_ALLOWED_UDEV_TAGS,  udev_tags,
+                      MM_PLUGIN_ALLOWED_SIT,        TRUE,
+                      NULL));
+}
+
+static void
+mm_plugin_shannon_init (MMPluginShannon *self)
+{
+}
+
+static void
+mm_plugin_shannon_class_init (MMPluginShannonClass *klass)
+{
+    MMPluginClass *plugin_class = MM_PLUGIN_CLASS (klass);
+
+    plugin_class->create_modem = create_modem;
+}
diff --git a/src/plugins/shannon/mm-port-sit.c b/src/plugins/shannon/mm-port-sit.c
new file mode 100644
index 00000000..f303c9b5
--- /dev/null
+++ b/src/plugins/shannon/mm-port-sit.c
@@ -0,0 +1,450 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SIT control port on a cpif character device (local plugin, not upstream).
+ *
+ * Frame header (little endian): u16 type, u16 id, u16 length (incl. header),
+ * u16 token, then for RSP a u32 error. Requests use type 0 and a 12-byte
+ * header with error 0. INDs have an 8-byte header.
+ */
+
+#include <errno.h>
+#include <fcntl.h>
+#include <string.h>
+#include <unistd.h>
+
+#include <glib-unix.h>
+
+#define _LIBMM_INSIDE_MM
+#include <libmm-glib.h>
+
+#include "mm-log-object.h"
+#include "mm-port-sit.h"
+#include "mm-sit-helpers.h"
+
+G_DEFINE_TYPE (MMPortSit, mm_port_sit, MM_TYPE_PORT)
+
+enum {
+    SIGNAL_INDICATION,
+    SIGNAL_FAILED,
+    SIGNAL_LAST
+};
+
+static guint signals[SIGNAL_LAST] = { 0 };
+
+G_DEFINE_QUARK (mm-sit-error-quark, mm_sit_error)
+
+typedef struct {
+    MMPortSit *self;      /* not a full reference */
+    GTask     *task;
+    guint16    id;
+    guint16    token;
+    GByteArray *frame;
+    guint      timeout_seconds;
+    guint      timeout_id;
+    gboolean   sent;
+} Request;
+
+struct _MMPortSitPrivate {
+    gint     fd;
+    guint    open_count;
+    GSource *source;
+    guint16  next_token;
+    GList   *requests;    /* Request*, in order of submission */
+};
+
+/*****************************************************************************/
+
+static void
+request_free (Request *req)
+{
+    if (req->timeout_id)
+        g_source_remove (req->timeout_id);
+    g_byte_array_unref (req->frame);
+    g_clear_object (&req->task);
+    g_slice_free (Request, req);
+}
+
+static void request_send (MMPortSit *self, Request *req);
+
+/* Start the next queued request with this id, if any. Only one request per
+ * id is in flight, so an RSP is never matched to the wrong caller even if
+ * the CP doesn't echo the token. */
+static void
+send_next_for_id (MMPortSit *self,
+                  guint16    id)
+{
+    GList *l;
+
+    for (l = self->priv->requests; l; l = g_list_next (l)) {
+        Request *req = l->data;
+
+        if (req->id == id && !req->sent) {
+            request_send (self, req);
+            return;
+        }
+    }
+}
+
+static void
+request_complete (MMPortSit *self,
+                  Request   *req,
+                  GBytes    *payload,
+                  GError    *error)
+{
+    guint16 id = req->id;
+    GTask  *task;
+
+    self->priv->requests = g_list_remove (self->priv->requests, req);
+    task = g_steal_pointer (&req->task);
+    request_free (req);
+
+    if (error)
+        g_task_return_error (task, error);
+    else
+        g_task_return_pointer (task, g_bytes_ref (payload), (GDestroyNotify) g_bytes_unref);
+    g_object_unref (task);
+
+    if (self->priv->fd >= 0)
+        send_next_for_id (self, id);
+}
+
+static gboolean
+request_timeout_cb (Request *req)
+{
+    MMPortSit *self = req->self;
+
+    req->timeout_id = 0;
+    mm_obj_dbg (self, "SIT request 0x%04x (token %u) timed out after %u s",
+                req->id, req->token, req->timeout_seconds);
+    request_complete (self, req, NULL,
+                      g_error_new (MM_CORE_ERROR, MM_CORE_ERROR_TIMEOUT,
+                                   "SIT request 0x%04x timed out", req->id));
+    return G_SOURCE_REMOVE;
+}
+
+static void
+request_send (MMPortSit *self,
+              Request   *req)
+{
+    g_autofree gchar *hex = NULL;
+    gssize            n;
+
+    hex = mm_utils_bin2hexstr (req->frame->data + SIT_RSP_HDR_LEN, req->frame->len - SIT_RSP_HDR_LEN);
+    mm_obj_dbg (self, "SIT >> 0x%04x tok %u len %u: %s", req->id, req->token,
+                req->frame->len - SIT_RSP_HDR_LEN, hex ? hex : "");
+
+    req->sent = TRUE;
+    n = write (self->priv->fd, req->frame->data, req->frame->len);
+    if (n != (gssize) req->frame->len) {
+        gint errsv = errno;
+
+        request_complete (self, req, NULL,
+                          g_error_new (MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                       "Couldn't write SIT request 0x%04x: %s",
+                                       req->id, n < 0 ? g_strerror (errsv) : "short write"));
+        return;
+    }
+    req->timeout_id = g_timeout_add_seconds (req->timeout_seconds, (GSourceFunc) request_timeout_cb, req);
+}
+
+/*****************************************************************************/
+
+static void
+fail_all_requests (MMPortSit   *self,
+                   const gchar *reason)
+{
+    while (self->priv->requests) {
+        Request *req = self->priv->requests->data;
+        GTask   *task;
+
+        self->priv->requests = g_list_delete_link (self->priv->requests, self->priv->requests);
+        task = g_steal_pointer (&req->task);
+        request_free (req);
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_ABORTED,
+                                 "SIT request aborted: %s", reason);
+        g_object_unref (task);
+    }
+}
+
+static void
+process_frame (MMPortSit    *self,
+               const guint8 *buf,
+               gsize         len)
+{
+    guint16 type, id;
+
+    if (len < SIT_IND_HDR_LEN) {
+        mm_obj_dbg (self, "ignoring short SIT frame (%" G_GSIZE_FORMAT " bytes)", len);
+        return;
+    }
+    type = buf[0] | (buf[1] << 8);
+    id   = buf[2] | (buf[3] << 8);
+
+    if (type == SIT_TYPE_IND) {
+        g_autoptr(GBytes) payload = NULL;
+
+        payload = g_bytes_new (buf + SIT_IND_HDR_LEN, len - SIT_IND_HDR_LEN);
+        /* signal strength arrives every second or so: keep it out of the log */
+        if (id != SIT_IND_SIGNAL_STRENGTH) {
+            g_autofree gchar *hex = NULL;
+
+            hex = mm_utils_bin2hexstr (buf + SIT_IND_HDR_LEN, MIN (len - SIT_IND_HDR_LEN, 64));
+            mm_obj_dbg (self, "SIT << IND 0x%04x len %" G_GSIZE_FORMAT ": %s%s", id,
+                        len - SIT_IND_HDR_LEN, hex ? hex : "", len - SIT_IND_HDR_LEN > 64 ? "..." : "");
+        }
+        g_signal_emit (self, signals[SIGNAL_INDICATION], 0, (guint) id, payload);
+        return;
+    }
+
+    if (type == SIT_TYPE_RSP && len >= SIT_RSP_HDR_LEN) {
+        g_autoptr(GBytes)  payload = NULL;
+        g_autofree gchar  *hex = NULL;
+        guint16            token;
+        guint32            err;
+        GList             *l;
+        Request           *match = NULL;
+
+        token = buf[6] | (buf[7] << 8);
+        err   = buf[8] | (buf[9] << 8) | (buf[10] << 16) | ((guint32) buf[11] << 24);
+        hex = mm_utils_bin2hexstr (buf + SIT_RSP_HDR_LEN, MIN (len - SIT_RSP_HDR_LEN, 96));
+        mm_obj_dbg (self, "SIT << RSP 0x%04x tok %u err 0x%x len %" G_GSIZE_FORMAT ": %s%s", id, token, err,
+                    len - SIT_RSP_HDR_LEN, hex ? hex : "", len - SIT_RSP_HDR_LEN > 96 ? "..." : "");
+
+        for (l = self->priv->requests; l; l = g_list_next (l)) {
+            Request *req = l->data;
+
+            if (req->id == id && req->sent) {
+                match = req;
+                break;
+            }
+        }
+        if (!match) {
+            mm_obj_dbg (self, "no pending request for SIT RSP 0x%04x", id);
+            return;
+        }
+        if (err) {
+            request_complete (self, match, NULL,
+                              g_error_new (MM_SIT_ERROR, (gint) err,
+                                           "SIT request 0x%04x failed: error 0x%x", id, err));
+            return;
+        }
+        payload = g_bytes_new (buf + SIT_RSP_HDR_LEN, len - SIT_RSP_HDR_LEN);
+        request_complete (self, match, payload, NULL);
+        return;
+    }
+
+    mm_obj_dbg (self, "ignoring SIT frame type %u id 0x%04x", type, id);
+}
+
+static void port_sit_close_internal (MMPortSit *self);
+
+static gboolean
+fd_ready_cb (gint          fd,
+             GIOCondition  condition,
+             MMPortSit    *self)
+{
+    guint8 buf[65536];
+
+    /* cpif returns POLLHUP/POLLERR only in the CP crash/reset states */
+    if (condition & (G_IO_ERR | G_IO_HUP)) {
+        mm_obj_warn (self, "SIT port hung up (CP crash or reset)");
+        g_object_ref (self);
+        self->priv->open_count = 0;
+        port_sit_close_internal (self);
+        g_signal_emit (self, signals[SIGNAL_FAILED], 0);
+        g_object_unref (self);
+        return G_SOURCE_REMOVE;
+    }
+
+    /* One frame per read(). cpif ignores O_NONBLOCK: on an empty queue it
+     * waits up to 100 ms and returns 0, so read only once per wakeup (the
+     * source is level-triggered) and treat 0 as "nothing yet". */
+    if (condition & G_IO_IN) {
+        gssize n;
+
+        n = read (fd, buf, sizeof (buf));
+        if (n > 0)
+            process_frame (self, buf, (gsize) n);
+        else if (n < 0 && errno != EAGAIN && errno != EINTR)
+            mm_obj_dbg (self, "SIT port read failed: %s", g_strerror (errno));
+    }
+    return G_SOURCE_CONTINUE;
+}
+
+/*****************************************************************************/
+
+gboolean
+mm_port_sit_open (MMPortSit  *self,
+                  GError    **error)
+{
+    g_autofree gchar *path = NULL;
+
+    if (self->priv->open_count++ > 0)
+        return TRUE;
+
+    path = g_strdup_printf ("/dev/%s", mm_port_get_device (MM_PORT (self)));
+    self->priv->fd = open (path, O_RDWR | O_NONBLOCK | O_CLOEXEC | O_NOCTTY);
+    if (self->priv->fd < 0) {
+        gint errsv = errno;
+
+        self->priv->open_count = 0;
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                     "Couldn't open %s: %s", path, g_strerror (errsv));
+        return FALSE;
+    }
+
+    self->priv->source = g_unix_fd_source_new (self->priv->fd, G_IO_IN | G_IO_ERR | G_IO_HUP);
+    g_source_set_callback (self->priv->source, (GSourceFunc) fd_ready_cb, self, NULL);
+    g_source_attach (self->priv->source, g_main_context_get_thread_default ());
+    mm_obj_dbg (self, "SIT port opened (%s)", path);
+    return TRUE;
+}
+
+gboolean
+mm_port_sit_is_open (MMPortSit *self)
+{
+    return self->priv->fd >= 0;
+}
+
+static void
+port_sit_close_internal (MMPortSit *self)
+{
+    if (self->priv->source) {
+        g_source_destroy (self->priv->source);
+        g_clear_pointer (&self->priv->source, g_source_unref);
+    }
+    if (self->priv->fd >= 0) {
+        close (self->priv->fd);
+        self->priv->fd = -1;
+        mm_obj_dbg (self, "SIT port closed");
+    }
+    fail_all_requests (self, "port closed");
+}
+
+void
+mm_port_sit_close (MMPortSit *self)
+{
+    if (!self->priv->open_count)
+        return;
+    if (--self->priv->open_count > 0)
+        return;
+    port_sit_close_internal (self);
+}
+
+/*****************************************************************************/
+
+void
+mm_port_sit_command (MMPortSit           *self,
+                     guint16              id,
+                     const guint8        *payload,
+                     gsize                payload_len,
+                     guint                timeout_seconds,
+                     GAsyncReadyCallback  callback,
+                     gpointer             user_data)
+{
+    Request *req;
+    GList   *l;
+    gboolean busy = FALSE;
+    guint8   hdr[SIT_RSP_HDR_LEN] = { 0 };
+    gsize    total;
+
+    req = g_slice_new0 (Request);
+    req->self = self;
+    req->task = g_task_new (self, NULL, callback, user_data);
+    req->id = id;
+
+    if (self->priv->fd < 0) {
+        g_task_return_new_error (req->task, MM_CORE_ERROR, MM_CORE_ERROR_WRONG_STATE,
+                                 "SIT port not open");
+        g_clear_object (&req->task);
+        g_slice_free (Request, req);
+        return;
+    }
+
+    req->token = ++self->priv->next_token;
+    req->timeout_seconds = timeout_seconds ? timeout_seconds : 10;
+    total = SIT_RSP_HDR_LEN + payload_len;
+    hdr[0] = SIT_TYPE_REQ;
+    hdr[2] = id & 0xff;
+    hdr[3] = id >> 8;
+    hdr[4] = total & 0xff;
+    hdr[5] = total >> 8;
+    hdr[6] = req->token & 0xff;
+    hdr[7] = req->token >> 8;
+    req->frame = g_byte_array_sized_new (total);
+    g_byte_array_append (req->frame, hdr, sizeof (hdr));
+    if (payload_len)
+        g_byte_array_append (req->frame, payload, payload_len);
+
+    for (l = self->priv->requests; l; l = g_list_next (l)) {
+        if (((Request *) l->data)->id == id) {
+            busy = TRUE;
+            break;
+        }
+    }
+    self->priv->requests = g_list_append (self->priv->requests, req);
+    if (!busy)
+        request_send (self, req);
+}
+
+GBytes *
+mm_port_sit_command_finish (MMPortSit     *self,
+                            GAsyncResult  *res,
+                            GError       **error)
+{
+    return g_task_propagate_pointer (G_TASK (res), error);
+}
+
+/*****************************************************************************/
+
+MMPortSit *
+mm_port_sit_new (const gchar *name)
+{
+    return MM_PORT_SIT (g_object_new (MM_TYPE_PORT_SIT,
+                                      MM_PORT_DEVICE, name,
+                                      MM_PORT_SUBSYS, MM_PORT_SUBSYS_CPIF,
+                                      MM_PORT_TYPE,   MM_PORT_TYPE_SIT,
+                                      NULL));
+}
+
+static void
+mm_port_sit_init (MMPortSit *self)
+{
+    self->priv = G_TYPE_INSTANCE_GET_PRIVATE (self, MM_TYPE_PORT_SIT, MMPortSitPrivate);
+    self->priv->fd = -1;
+}
+
+static void
+dispose (GObject *object)
+{
+    MMPortSit *self = MM_PORT_SIT (object);
+
+    self->priv->open_count = 0;
+    port_sit_close_internal (self);
+    G_OBJECT_CLASS (mm_port_sit_parent_class)->dispose (object);
+}
+
+static void
+mm_port_sit_class_init (MMPortSitClass *klass)
+{
+    GObjectClass *object_class = G_OBJECT_CLASS (klass);
+
+    g_type_class_add_private (object_class, sizeof (MMPortSitPrivate));
+    object_class->dispose = dispose;
+
+    signals[SIGNAL_INDICATION] =
+        g_signal_new (MM_PORT_SIT_SIGNAL_INDICATION,
+                      G_OBJECT_CLASS_TYPE (object_class),
+                      G_SIGNAL_RUN_LAST,
+                      0, NULL, NULL,
+                      g_cclosure_marshal_generic,
+                      G_TYPE_NONE, 2, G_TYPE_UINT, G_TYPE_BYTES);
+
+    signals[SIGNAL_FAILED] =
+        g_signal_new (MM_PORT_SIT_SIGNAL_FAILED,
+                      G_OBJECT_CLASS_TYPE (object_class),
+                      G_SIGNAL_RUN_LAST,
+                      0, NULL, NULL,
+                      g_cclosure_marshal_generic,
+                      G_TYPE_NONE, 0);
+}
diff --git a/src/plugins/shannon/mm-port-sit.h b/src/plugins/shannon/mm-port-sit.h
new file mode 100644
index 00000000..c2d1484e
--- /dev/null
+++ b/src/plugins/shannon/mm-port-sit.h
@@ -0,0 +1,71 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SIT control port on a cpif character device (/dev/umts_ipcN), Shannon
+ * modems in Google Pixel phones (local plugin, not upstream).
+ *
+ * cpif hands each frame (one read() = one frame) to exactly one reader, so
+ * this port must be the only user of the device while it is open.
+ */
+
+#ifndef MM_PORT_SIT_H
+#define MM_PORT_SIT_H
+
+#include <glib.h>
+#include <glib-object.h>
+#include <gio/gio.h>
+
+#include "mm-port.h"
+
+#define MM_TYPE_PORT_SIT            (mm_port_sit_get_type ())
+#define MM_PORT_SIT(obj)            (G_TYPE_CHECK_INSTANCE_CAST ((obj), MM_TYPE_PORT_SIT, MMPortSit))
+#define MM_PORT_SIT_CLASS(klass)    (G_TYPE_CHECK_CLASS_CAST ((klass),  MM_TYPE_PORT_SIT, MMPortSitClass))
+#define MM_IS_PORT_SIT(obj)         (G_TYPE_CHECK_INSTANCE_TYPE ((obj), MM_TYPE_PORT_SIT))
+#define MM_IS_PORT_SIT_CLASS(klass) (G_TYPE_CHECK_CLASS_TYPE ((klass),  MM_TYPE_PORT_SIT))
+#define MM_PORT_SIT_GET_CLASS(obj)  (G_TYPE_INSTANCE_GET_CLASS ((obj),  MM_TYPE_PORT_SIT, MMPortSitClass))
+
+typedef struct _MMPortSit MMPortSit;
+typedef struct _MMPortSitClass MMPortSitClass;
+typedef struct _MMPortSitPrivate MMPortSitPrivate;
+
+/* "indication" signal: (guint id, GBytes *payload) */
+#define MM_PORT_SIT_SIGNAL_INDICATION "indication"
+/* "closed" signal: the device failed (e.g. CP reset) */
+#define MM_PORT_SIT_SIGNAL_FAILED     "failed"
+
+struct _MMPortSit {
+    MMPort parent;
+    MMPortSitPrivate *priv;
+};
+
+struct _MMPortSitClass {
+    MMPortClass parent;
+};
+
+GType mm_port_sit_get_type (void);
+G_DEFINE_AUTOPTR_CLEANUP_FUNC (MMPortSit, g_object_unref)
+
+/* SIT errors: the code is the raw u32 error from the RSP header */
+#define MM_SIT_ERROR (mm_sit_error_quark ())
+GQuark mm_sit_error_quark (void);
+
+MMPortSit *mm_port_sit_new      (const gchar *name);
+
+gboolean   mm_port_sit_open     (MMPortSit  *self,
+                                 GError    **error);
+gboolean   mm_port_sit_is_open  (MMPortSit  *self);
+void       mm_port_sit_close    (MMPortSit  *self);
+
+/* Send a request and wait for the RSP with the same id. The result is the
+ * RSP payload; a non-zero SIT error is returned as MM_SIT_ERROR. */
+void       mm_port_sit_command        (MMPortSit           *self,
+                                       guint16              id,
+                                       const guint8        *payload,
+                                       gsize                payload_len,
+                                       guint                timeout_seconds,
+                                       GAsyncReadyCallback  callback,
+                                       gpointer             user_data);
+GBytes    *mm_port_sit_command_finish (MMPortSit           *self,
+                                       GAsyncResult        *res,
+                                       GError             **error);
+
+#endif /* MM_PORT_SIT_H */
diff --git a/src/plugins/shannon/mm-shannon-carrier.c b/src/plugins/shannon/mm-shannon-carrier.c
new file mode 100644
index 00000000..c1fb18d0
--- /dev/null
+++ b/src/plugins/shannon/mm-shannon-carrier.c
@@ -0,0 +1,167 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * Carrier selection for the Shannon CP (local plugin).
+ *
+ * The CP loads its per-carrier configuration (bands, IMS, attach behaviour)
+ * from the confpack in the modem image once it is told which manifest to
+ * use (SET_CP_CARRIER_CONFIG). The confpack's cfg.db maps SIM identities to
+ * carriers:
+ *   carrier_info (carrier_id, mccmnc, imsi_prefix_xpattern, spn, gid1, gid2,
+ *                 iccid_prefix, ...)   '%' = any; xpattern uses '_' and '%'
+ *   confmap      (carrier_id, parent_id, confman)
+ *   carrier_parent (carrier_id, parent_id), confnames/carrier_name
+ * A carrier_info row matches when its MCC/MNC is a prefix of the IMSI and
+ * every non-wildcard field matches the SIM (GID1 by prefix, case-
+ * insensitive; the database pads GID1 with '0', SIMs pad the file with FF). The most specific row wins (the MVNO over its host network),
+ * as with Android's carrier id matching. Carriers without their own confpack
+ * entry use their parent's; nothing matched = the default entry (carrier 0).
+ */
+
+#include <string.h>
+#include <sqlite3.h>
+
+#define _LIBMM_INSIDE_MM
+#include <libmm-glib.h>
+
+#include "mm-shannon-carrier.h"
+
+void
+mm_shannon_carrier_free (MMShannonCarrier *carrier)
+{
+    if (!carrier)
+        return;
+    g_free (carrier->name);
+    g_free (carrier->config_name);
+    g_free (carrier->manifest);
+    g_free (carrier);
+}
+
+static gchar *
+query_text (sqlite3     *db,
+            const gchar *sql,
+            gint         id)
+{
+    sqlite3_stmt *st = NULL;
+    gchar        *out = NULL;
+
+    if (sqlite3_prepare_v2 (db, sql, -1, &st, NULL) != SQLITE_OK)
+        return NULL;
+    sqlite3_bind_int (st, 1, id);
+    if (sqlite3_step (st) == SQLITE_ROW && sqlite3_column_text (st, 0))
+        out = g_strdup ((const gchar *) sqlite3_column_text (st, 0));
+    sqlite3_finalize (st);
+    return out;
+}
+
+/* confpack entry of the carrier or its nearest ancestor */
+static gchar *
+find_manifest (sqlite3 *db,
+               gint     carrier_id,
+               gint    *config_id)
+{
+    guint i;
+
+    for (i = 0; i < 8; i++) {
+        g_autofree gchar *man = NULL;
+        g_autofree gchar *parent = NULL;
+
+        man = query_text (db, "SELECT confman FROM confmap WHERE CAST(carrier_id AS INTEGER) = ?1", carrier_id);
+        if (man) {
+            *config_id = carrier_id;
+            return g_steal_pointer (&man);
+        }
+        parent = query_text (db,
+                             "SELECT parent_id FROM carrier_parent WHERE carrier_id = ?1 "
+                             "UNION ALL SELECT parent_id FROM confmap "
+                             "WHERE CAST(carrier_id AS INTEGER) = ?1 AND parent_id IS NOT NULL "
+                             "AND parent_id != '' LIMIT 1",
+                             carrier_id);
+        if (!parent)
+            return NULL;
+        carrier_id = (gint) g_ascii_strtoll (parent, NULL, 10);
+    }
+    return NULL;
+}
+
+MMShannonCarrier *
+mm_shannon_carrier_lookup (const gchar  *db_path,
+                           const gchar  *imsi,
+                           const gchar  *gid1,
+                           const gchar  *spn,
+                           const gchar  *iccid,
+                           GError      **error)
+{
+    g_autoptr(MMShannonCarrier) carrier = NULL;
+    sqlite3                    *db = NULL;
+    sqlite3_stmt               *st = NULL;
+    g_autofree gchar           *uri = NULL;
+    /* Candidates, most specific first. The SIM values are bound as LIKE
+     * subjects: the database supplies the patterns. GID1 compares by prefix
+     * with the padding dropped on both sides. */
+    static const gchar *sql =
+        "SELECT carrier_id, "
+        "  (gid1 != '%') + (spn != '%') + (imsi_prefix_xpattern != '%') + "
+        "  (iccid_prefix IS NOT NULL AND iccid_prefix != '') AS score "
+        "FROM carrier_info "
+        "WHERE substr(?1, 1, length(mccmnc)) = mccmnc "
+        "  AND ?1 LIKE imsi_prefix_xpattern || '%' "
+        "  AND (gid1 = '%' OR rtrim(upper(?2), 'F') LIKE "
+        "       coalesce(nullif(rtrim(upper(gid1), '0'), ''), upper(gid1)) || '%') "
+        "  AND (spn = '%' OR ?3 LIKE spn) "
+        "  AND (iccid_prefix IS NULL OR iccid_prefix = '' OR ?4 LIKE iccid_prefix || '%') "
+        "ORDER BY score DESC, length(mccmnc) DESC, carrier_id";
+    gint rc;
+
+    g_return_val_if_fail (imsi != NULL, NULL);
+
+    uri = g_strdup_printf ("file:%s?mode=ro&immutable=1", db_path);
+    if (sqlite3_open_v2 (uri, &db, SQLITE_OPEN_READONLY | SQLITE_OPEN_URI, NULL) != SQLITE_OK) {
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_FAILED, "couldn't open %s: %s",
+                     db_path, db ? sqlite3_errmsg (db) : "out of memory");
+        sqlite3_close (db);
+        return NULL;
+    }
+
+    carrier = g_new0 (MMShannonCarrier, 1);
+    carrier->carrier_id = -1;
+    if (sqlite3_prepare_v2 (db, sql, -1, &st, NULL) != SQLITE_OK) {
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_FAILED, "unexpected cfg.db layout: %s",
+                     sqlite3_errmsg (db));
+        sqlite3_close (db);
+        return NULL;
+    }
+    sqlite3_bind_text (st, 1, imsi, -1, SQLITE_STATIC);
+    sqlite3_bind_text (st, 2, gid1 ? gid1 : "", -1, SQLITE_STATIC);
+    sqlite3_bind_text (st, 3, spn ? spn : "", -1, SQLITE_STATIC);
+    sqlite3_bind_text (st, 4, iccid ? iccid : "", -1, SQLITE_STATIC);
+    /* first candidate that has a confpack entry (itself or a parent) */
+    while ((rc = sqlite3_step (st)) == SQLITE_ROW) {
+        gint id = sqlite3_column_int (st, 0);
+
+        carrier->manifest = find_manifest (db, id, &carrier->config_id);
+        if (carrier->manifest) {
+            carrier->carrier_id = id;
+            break;
+        }
+    }
+    sqlite3_finalize (st);
+
+    if (!carrier->manifest) {
+        carrier->carrier_id = 0;
+        carrier->manifest = find_manifest (db, 0, &carrier->config_id);
+    }
+    if (carrier->manifest) {
+        carrier->name = query_text (db, "SELECT name FROM carrier_name WHERE carrier_id = ?1",
+                                    carrier->carrier_id);
+        carrier->config_name = query_text (db, "SELECT name FROM confnames WHERE carrier_id = ?1",
+                                           carrier->config_id);
+    }
+    sqlite3_close (db);
+
+    if (!carrier->manifest) {
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_NOT_FOUND,
+                     "no confpack entry for IMSI %.6s", imsi);
+        return NULL;
+    }
+    return g_steal_pointer (&carrier);
+}
diff --git a/src/plugins/shannon/mm-shannon-carrier.h b/src/plugins/shannon/mm-shannon-carrier.h
new file mode 100644
index 00000000..f136e0eb
--- /dev/null
+++ b/src/plugins/shannon/mm-shannon-carrier.h
@@ -0,0 +1,32 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * Carrier selection for the Shannon CP (local plugin): match the SIM against
+ * the confpack carrier database (cfg.db) shipped in the modem image.
+ */
+
+#ifndef MM_SHANNON_CARRIER_H
+#define MM_SHANNON_CARRIER_H
+
+#include <glib.h>
+
+typedef struct {
+    gint   carrier_id;   /* matched carrier (before parent fallback) */
+    gchar *name;         /* its carrier_name, may be NULL */
+    gint   config_id;    /* carrier whose confpack entry is used */
+    gchar *config_name;  /* confnames of that entry (e.g. us_vzw), may be NULL */
+    gchar *manifest;     /* confman sha1, 40 hex digits */
+} MMShannonCarrier;
+
+void mm_shannon_carrier_free (MMShannonCarrier *carrier);
+G_DEFINE_AUTOPTR_CLEANUP_FUNC (MMShannonCarrier, mm_shannon_carrier_free)
+
+/* imsi is required; gid1 (hex), spn and iccid may be NULL. Without any
+ * carrier_info match the default entry (carrier 0) is returned. */
+MMShannonCarrier *mm_shannon_carrier_lookup (const gchar  *db_path,
+                                             const gchar  *imsi,
+                                             const gchar  *gid1,
+                                             const gchar  *spn,
+                                             const gchar  *iccid,
+                                             GError      **error);
+
+#endif /* MM_SHANNON_CARRIER_H */
diff --git a/src/plugins/shannon/mm-shannon-ims.c b/src/plugins/shannon/mm-shannon-ims.c
new file mode 100644
index 00000000..40e763f5
--- /dev/null
+++ b/src/plugins/shannon/mm-shannon-ims.c
@@ -0,0 +1,1207 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * VoLTE on a Shannon modem (local plugin): IMS bring-up for the CP's AIMS
+ * stack, AIMS call tracking and the CP side of call audio. See
+ * mm-shannon-ims.h.
+ *
+ * Only the modem's half of call audio is done here (audio clock, path and
+ * mute, like the stock RIL). The phone's half (mixer routing, the hostless
+ * voice PCMs) belongs to the sound stack: on the Pixel 6 that is the ALSA
+ * UCM "Voice Call" verb switched by callaudiod, and aoc-voiced.
+ *
+ * Layouts are from the stock ShannonIms app (network/adaptor/data/RilReq*
+ * getBytes() and RilInd* parsers, little-endian) and were checked against
+ * live frames (PIXEL6-LOCAL.md item 12 "VOLTE").
+ *
+ * Settings: /etc/ModemManager/shannon.conf
+ *   [ims]
+ *   enabled=true
+ *   apn=ims
+ *   cid=2
+ *   user-agent=...  manufacturer= model= build= device= os=
+ */
+
+#include <string.h>
+#include <arpa/inet.h>
+
+#define _LIBMM_INSIDE_MM
+#include <libmm-glib.h>
+
+#include "mm-log-object.h"
+#include "mm-errors-types.h"
+#include "mm-iface-modem-voice.h"
+#include "mm-modem-helpers.h"
+#include "mm-broadband-modem-shannon.h"
+#include "mm-shannon-ims.h"
+#include "mm-sit-helpers.h"
+
+#define SIT_IND_AIMS_CALL_RING      0x0d01
+#define SIT_IND_AIMS_CALL_STATUS    0x0d04
+#define SIT_IND_AIMS_REGISTRATION   0x0d05
+#define SIT_AIMS_HIDDEN_MENU        0x0d07
+#define SIT_AIMS_ADD_PDN_INFO       0x0d08
+#define SIT_AIMS_DEL_PDN_INFO       0x0d38
+#define SIT_AIMS_STACK_START        0x0d39
+#define SIT_AIMS_STACK_STOP         0x0d3a
+#define SIT_SET_VOICE_OPERATION     0x091a
+#define SIT_SET_MUTE                0x0a00
+#define SIT_SET_AUDIOPATH           0x0a05
+#define SIT_SET_AUDIO_CLK           0x0a0a
+
+#define SIT_APN_TYPE_IMS            1
+
+/* AIMS_DIAL (RilReqDial) payload: u16 type, u8 clir, u16 len, number[513],
+ * then 159 B of options and a u32 */
+#define AIMS_DIAL_NUMBER_MAX        513
+#define AIMS_DIAL_PAYLOAD_LEN       679
+
+/* IND_AIMS_REGISTRATION regState (RilIndRegistration.RegState) */
+#define AIMS_REG_NOT_REGISTERED     1
+#define AIMS_REG_REGISTERED         2
+#define AIMS_REG_LIMITED            3
+
+#define IMS_REG_TIMEOUT             60
+#define IMS_BACKOFF_MIN             30
+#define IMS_BACKOFF_MAX             600
+
+#define DEFAULT_APN          "ims"
+#define DEFAULT_CID          2
+#define DEFAULT_MANUFACTURER "Google"
+#define DEFAULT_MODEL        "Pixel 6"
+#define DEFAULT_BUILD        "CP1A.260405.005"
+#define DEFAULT_DEVICE       "oriole"
+#define DEFAULT_OS           "16"
+#define DEFAULT_USER_AGENT   "T-Mobile EPSFB-ePDG-IR94-RTT-ussd Google/Pixel 6 CP1A.260405.005"
+
+typedef enum {
+    IMS_STATE_IDLE,
+    IMS_STATE_STARTING,
+    IMS_STATE_WAIT_REG,
+    IMS_STATE_REGISTERED,
+    IMS_STATE_BACKOFF,
+} ImsState;
+
+static const gchar *state_names[] = { "idle", "starting", "waiting for registration", "registered", "backoff" };
+
+typedef struct {
+    guint8          id;
+    MMCallDirection direction;
+    MMCallState     state;
+    gchar          *number;
+} ImsCall;
+
+struct _MMShannonIms {
+    MMBroadbandModemShannon *modem;   /* not a reference: the modem owns this */
+
+    gchar   *apn;
+    guint8   cid;
+    gchar   *user_agent;
+    gchar   *manufacturer;
+    gchar   *model;
+    gchar   *build;
+    gchar   *device;
+    gchar   *os;
+
+    ImsState state;
+    guint    generation;   /* bumped on every (re)start/stop: stale replies are dropped */
+    gboolean lte;
+    guint    timer_id;
+    guint    backoff;
+    gboolean pdn_requested;
+    gboolean started_once;
+
+    /* IMS PDN details for AIMS_ADD_PDN_INFO */
+    guint8   addr4[4];
+    guint8   addr6[16];
+    gboolean have4;
+    gboolean have6;
+    guint8   pcscf4[3][4];
+    guint    n_pcscf4;
+    guint8   pcscf6[3][16];
+    guint    n_pcscf6;
+    guint8   dns4[2][4];
+    guint8   dns6[2][16];
+
+    GList   *calls;        /* ImsCall */
+    gboolean dial_pending;
+    gboolean audio_on;
+};
+
+#define ims_dbg(self, ...)  mm_obj_dbg  ((self)->modem, "IMS: " __VA_ARGS__)
+#define ims_info(self, ...) mm_obj_info ((self)->modem, "IMS: " __VA_ARGS__)
+#define ims_warn(self, ...) mm_obj_warn ((self)->modem, "IMS: " __VA_ARGS__)
+
+static void ims_start (MMShannonIms *self);
+
+/*****************************************************************************/
+/* SIT helpers: replies are matched to the IMS object by generation */
+
+static void
+ims_command (MMShannonIms        *self,
+             guint16              id,
+             const guint8        *data,
+             gsize                len,
+             guint                timeout,
+             GAsyncReadyCallback  callback)
+{
+    mm_broadband_modem_shannon_command (self->modem, id, data, len, timeout, callback,
+                                        GUINT_TO_POINTER (self->generation));
+}
+
+/* finish the command; NULL ims if it belongs to an older generation */
+static GBytes *
+ims_finish (MMBroadbandModemShannon  *modem,
+            GAsyncResult             *res,
+            gpointer                  user_data,
+            MMShannonIms            **out_ims,
+            GError                  **error)
+{
+    MMShannonIms *self;
+    GBytes       *payload;
+
+    payload = mm_broadband_modem_shannon_command_finish (modem, res, error);
+    self = mm_broadband_modem_shannon_peek_ims (modem);
+    if (self && self->generation != GPOINTER_TO_UINT (user_data))
+        self = NULL;
+    *out_ims = self;
+    return payload;
+}
+
+static void
+ignore_ready (MMBroadbandModemShannon *modem,
+              GAsyncResult            *res,
+              gpointer                 user_data)
+{
+    g_autoptr(GBytes) payload = NULL;
+    g_autoptr(GError) error = NULL;
+
+    payload = mm_broadband_modem_shannon_command_finish (modem, res, &error);
+    if (!payload)
+        mm_obj_dbg (modem, "IMS: %s failed: %s", (const gchar *) user_data, error->message);
+}
+
+static void
+fire (MMShannonIms *self,
+      guint16       id,
+      const guint8 *data,
+      gsize         len,
+      const gchar  *what)
+{
+    mm_broadband_modem_shannon_command (self->modem, id, data, len, 10,
+                                        (GAsyncReadyCallback) ignore_ready, (gpointer) what);
+}
+
+static void
+put_le16 (GByteArray *a, guint16 v)
+{
+    guint8 b[2] = { v & 0xff, v >> 8 };
+
+    g_byte_array_append (a, b, 2);
+}
+
+static void
+put_le32 (GByteArray *a, guint32 v)
+{
+    guint8 b[4] = { v & 0xff, (v >> 8) & 0xff, (v >> 16) & 0xff, v >> 24 };
+
+    g_byte_array_append (a, b, 4);
+}
+
+static void
+put_zero (GByteArray *a, gsize n)
+{
+    static const guint8 zeros[64] = { 0 };
+
+    while (n) {
+        gsize c = MIN (n, sizeof (zeros));
+
+        g_byte_array_append (a, zeros, c);
+        n -= c;
+    }
+}
+
+static void
+set_state (MMShannonIms *self,
+           ImsState      state)
+{
+    if (self->state != state)
+        ims_dbg (self, "%s -> %s", state_names[self->state], state_names[state]);
+    self->state = state;
+}
+
+static void
+clear_timer (MMShannonIms *self)
+{
+    if (self->timer_id) {
+        g_source_remove (self->timer_id);
+        self->timer_id = 0;
+    }
+}
+
+/*****************************************************************************/
+/* Teardown and retry */
+
+static void
+teardown_cp (MMShannonIms *self,
+             gboolean      deactivate_pdn)
+{
+    static const guint8 del_pdn[3] = { 1, 2, 0 };   /* cellular, IMS PDN, reason 0 */
+    static const guint8 stack[2] = { 1, 1 };       /* sim ready, stack 1 */
+
+    fire (self, SIT_AIMS_DEL_PDN_INFO, del_pdn, sizeof (del_pdn), "DEL_PDN_INFO");
+    fire (self, SIT_AIMS_STACK_STOP, stack, sizeof (stack), "STACK_STOP");
+    if (deactivate_pdn) {
+        guint8 deact[2] = { self->cid, 0 };
+
+        fire (self, SIT_DEACT_DATA_CALL, deact, sizeof (deact), "DEACT_DATA_CALL");
+    }
+}
+
+static gboolean
+retry_cb (MMShannonIms *self)
+{
+    self->timer_id = 0;
+    set_state (self, IMS_STATE_IDLE);
+    if (self->lte)
+        ims_start (self);
+    return G_SOURCE_REMOVE;
+}
+
+static void
+ims_fail (MMShannonIms *self,
+          const gchar  *reason)
+{
+    self->generation++;
+    clear_timer (self);
+    self->backoff = self->backoff ? MIN (self->backoff * 2, IMS_BACKOFF_MAX) : IMS_BACKOFF_MIN;
+    ims_warn (self, "%s; retrying in %u s", reason, self->backoff);
+    teardown_cp (self, FALSE);
+    set_state (self, IMS_STATE_BACKOFF);
+    self->timer_id = g_timeout_add_seconds (self->backoff, (GSourceFunc) retry_cb, self);
+}
+
+static void
+ims_fail_error (MMShannonIms *self,
+                const gchar  *what,
+                GError       *error)
+{
+    g_autofree gchar *reason = g_strdup_printf ("%s failed: %s", what, error->message);
+
+    ims_fail (self, reason);
+}
+
+/*****************************************************************************/
+/* Bring-up: PDN -> STACK_START -> VOICE_OP -> HIDDEN_MENU x2 -> ADD_PDN */
+
+static gboolean
+reg_timeout_cb (MMShannonIms *self)
+{
+    self->timer_id = 0;
+    ims_fail (self, "no IMS registration");
+    return G_SOURCE_REMOVE;
+}
+
+static void
+add_pdn_ready (MMBroadbandModemShannon *modem,
+               GAsyncResult            *res,
+               gpointer                 user_data)
+{
+    MMShannonIms      *self;
+    g_autoptr(GBytes)  payload = NULL;
+    g_autoptr(GError)  error = NULL;
+
+    payload = ims_finish (modem, res, user_data, &self, &error);
+    if (!self)
+        return;
+    if (!payload) {
+        ims_fail_error (self, "ADD_PDN_INFO", error);
+        return;
+    }
+    /* the registration IND may already have arrived */
+    if (self->state == IMS_STATE_STARTING) {
+        set_state (self, IMS_STATE_WAIT_REG);
+        self->timer_id = g_timeout_add_seconds (IMS_REG_TIMEOUT, (GSourceFunc) reg_timeout_cb, self);
+    }
+}
+
+static void
+send_add_pdn (MMShannonIms *self)
+{
+    g_autoptr(GByteArray) b = g_byte_array_sized_new (256);
+    static const guint8   flags[6] = { 17, 0, 0, 1, 0, 0 };  /* hd internet, operator, reg style, pdn new, volte/rcs autoconfig */
+    static const guint8   types[3] = { 0, 0, 1 };            /* reg type, init type, ims net type cellular */
+    static const guint8   sipdlg[12] = { 1, 0, 8, 0 };       /* SIP delegate capability TLV (u16 1, u16 8, u64 0) */
+    guint                 i;
+
+    /* RilReqAddPdnInfo.getBytes() */
+    g_byte_array_append (b, (guint8[]) { 2, self->have4 && self->have6 ? 3 : (self->have6 ? 2 : 1) }, 2);
+    g_byte_array_append (b, self->addr4, 4);
+    g_byte_array_append (b, self->addr6, 16);
+    g_byte_array_append (b, flags, sizeof (flags));
+    put_le16 (b, 0x23);                  /* offering type (feature tags) */
+    g_byte_array_append (b, types, sizeof (types));
+    put_zero (b, 6);                     /* wifi mac */
+    g_byte_array_append (b, (guint8[]) { self->n_pcscf4 }, 1);
+    for (i = 0; i < self->n_pcscf4; i++)
+        g_byte_array_append (b, self->pcscf4[i], 4);
+    g_byte_array_append (b, (guint8[]) { self->n_pcscf6 }, 1);
+    for (i = 0; i < self->n_pcscf6; i++)
+        g_byte_array_append (b, self->pcscf6[i], 16);
+    for (i = 0; i < 2; i++) {
+        g_byte_array_append (b, self->dns4[i], 4);
+        g_byte_array_append (b, self->dns6[i], 16);
+    }
+    put_zero (b, 23);                    /* wifi-only access network, timestamps */
+    put_le32 (b, 0);                     /* remaining emergency reg timer */
+    put_zero (b, 10);                    /* wifi-only mcc/mnc, country, mtu */
+    put_le32 (b, 0);                     /* rcs mask */
+    put_le16 (b, 0);                     /* vendor mask */
+    put_le32 (b, 0);                     /* ext rcs mask */
+    put_zero (b, 1 + 32);                /* vowifi e911 aid */
+    put_le16 (b, sizeof (sipdlg));
+    g_byte_array_append (b, sipdlg, sizeof (sipdlg));
+
+    ims_dbg (self, "sending ADD_PDN_INFO (%u B, %u+%u P-CSCFs)", b->len, self->n_pcscf4, self->n_pcscf6);
+    ims_command (self, SIT_AIMS_ADD_PDN_INFO, b->data, b->len, 20, (GAsyncReadyCallback) add_pdn_ready);
+}
+
+/*
+ * Video media configuration (AIMS_HIDDEN_MENU part 2): "03 03", the number
+ * of video formats, bandwidth AS/RS/RR, the formats, video orientation
+ * (CVO). There is no video calling on this stack, so no video formats are
+ * offered and CVO is off.
+ */
+static GByteArray *
+media_config_new (void)
+{
+    GByteArray *a = g_byte_array_new ();
+
+    g_byte_array_append (a, (guint8[]) { 3, 3, 0 }, 3);
+    put_zero (a, 12);                       /* bandwidth AS, RS, RR */
+    put_zero (a, 3);                        /* CVO off */
+    return a;
+}
+
+static void
+hidden_menu2_ready (MMBroadbandModemShannon *modem,
+                    GAsyncResult            *res,
+                    gpointer                 user_data)
+{
+    MMShannonIms      *self;
+    g_autoptr(GBytes)  payload = NULL;
+    g_autoptr(GError)  error = NULL;
+
+    payload = ims_finish (modem, res, user_data, &self, &error);
+    if (!self)
+        return;
+    if (!payload) {
+        ims_fail_error (self, "HIDDEN_MENU (media)", error);
+        return;
+    }
+    send_add_pdn (self);
+}
+
+static void
+hidden_menu1_ready (MMBroadbandModemShannon *modem,
+                    GAsyncResult            *res,
+                    gpointer                 user_data)
+{
+    MMShannonIms          *self;
+    g_autoptr(GBytes)      payload = NULL;
+    g_autoptr(GError)      error = NULL;
+    g_autoptr(GByteArray)  b = NULL;
+    g_autoptr(GByteArray)  media = NULL;
+
+    payload = ims_finish (modem, res, user_data, &self, &error);
+    if (!self)
+        return;
+    if (!payload) {
+        ims_fail_error (self, "HIDDEN_MENU (UA/timers)", error);
+        return;
+    }
+    /* part 2: the video media configuration, last part (more = 0) */
+    media = media_config_new ();
+    b = g_byte_array_sized_new (3 + media->len);
+    g_byte_array_append (b, (guint8[]) { 0 }, 1);
+    put_le16 (b, media->len);
+    g_byte_array_append (b, media->data, media->len);
+    ims_command (self, SIT_AIMS_HIDDEN_MENU, b->data, b->len, 10, (GAsyncReadyCallback) hidden_menu2_ready);
+}
+
+static void
+hm_int (GByteArray *a, guint16 tag, gint32 v)
+{
+    put_le16 (a, tag);
+    put_le32 (a, (guint32) v);
+}
+
+static void
+hm_str (GByteArray *a, guint16 tag, const gchar *v)
+{
+    put_le16 (a, tag);
+    g_byte_array_append (a, (const guint8 *) v, strlen (v));
+    g_byte_array_append (a, (const guint8 *) "##", 2);
+}
+
+static void
+voice_op_ready (MMBroadbandModemShannon *modem,
+                GAsyncResult            *res,
+                gpointer                 user_data)
+{
+    MMShannonIms          *self;
+    g_autoptr(GBytes)      payload = NULL;
+    g_autoptr(GError)      error = NULL;
+    g_autoptr(GByteArray)  d = NULL;
+    g_autoptr(GByteArray)  b = NULL;
+    static const guint16   timers[] = { 523, 527, 529, 531, 533 };
+    guint                  i;
+
+    payload = ims_finish (modem, res, user_data, &self, &error);
+    if (!self)
+        return;
+    if (!payload) {
+        ims_fail_error (self, "SET_VOICE_OPERATION", error);
+        return;
+    }
+    /* part 1 (RegistrationAdaptor.sendHiddenMenu): TLVs, u16 tag + i32 or
+     * u16 tag + string + "##"; without it registration fails at once */
+    d = g_byte_array_sized_new (256);
+    for (i = 0; i < G_N_ELEMENTS (timers); i++)
+        hm_int (d, timers[i], 30);
+    hm_str (d, 772, self->manufacturer);
+    hm_str (d, 773, self->model);
+    hm_str (d, 774, self->build);
+    hm_str (d, 775, self->device);
+    hm_str (d, 776, self->os);
+    hm_str (d, 519, self->user_agent);
+    hm_int (d, 1044, 1);
+    hm_int (d, 1045, 1);
+    hm_int (d, 1080, 0);
+    hm_int (d, 1081, 0);
+    hm_int (d, 1082, 0);
+    hm_int (d, 1084, 0);
+
+    b = g_byte_array_sized_new (3 + d->len);
+    g_byte_array_append (b, (guint8[]) { 1 }, 1);   /* more parts follow */
+    put_le16 (b, d->len);
+    g_byte_array_append (b, d->data, d->len);
+    ims_command (self, SIT_AIMS_HIDDEN_MENU, b->data, b->len, 10, (GAsyncReadyCallback) hidden_menu1_ready);
+}
+
+static void
+stack_start_ready (MMBroadbandModemShannon *modem,
+                   GAsyncResult            *res,
+                   gpointer                 user_data)
+{
+    MMShannonIms      *self;
+    g_autoptr(GBytes)  payload = NULL;
+    g_autoptr(GError)  error = NULL;
+    guint8             op[4] = { 1, 0, 0, 0 };
+
+    payload = ims_finish (modem, res, user_data, &self, &error);
+    if (!self)
+        return;
+    if (!payload) {
+        ims_fail_error (self, "STACK_START", error);
+        return;
+    }
+    ims_command (self, SIT_SET_VOICE_OPERATION, op, sizeof (op), 10, (GAsyncReadyCallback) voice_op_ready);
+}
+
+static gboolean
+addr_set (const guint8 *p, gsize n)
+{
+    gsize i;
+
+    for (i = 0; i < n; i++)
+        if (p[i])
+            return TRUE;
+    return FALSE;
+}
+
+/* data call item: pdp @4, v4 @5, v6 @9, dns v4 @0x1a/0x2e, v6 @0x1e/0x32,
+ * P-CSCF v4 x3 @0x43, v6 x3 @0x4f */
+static gboolean
+load_pdn (MMShannonIms *self,
+          const guint8 *it,
+          gsize         len)
+{
+    gchar buf[INET6_ADDRSTRLEN];
+    guint i;
+
+    if (len < 0x7f)
+        return FALSE;
+    memcpy (self->addr4, it + 0x05, 4);
+    memcpy (self->addr6, it + 0x09, 16);
+    self->have4 = addr_set (self->addr4, 4);
+    self->have6 = addr_set (self->addr6, 16);
+    memcpy (self->dns4[0], it + 0x1a, 4);
+    memcpy (self->dns6[0], it + 0x1e, 16);
+    memcpy (self->dns4[1], it + 0x2e, 4);
+    memcpy (self->dns6[1], it + 0x32, 16);
+    self->n_pcscf4 = self->n_pcscf6 = 0;
+    for (i = 0; i < 3; i++) {
+        if (addr_set (it + 0x43 + 4 * i, 4))
+            memcpy (self->pcscf4[self->n_pcscf4++], it + 0x43 + 4 * i, 4);
+        if (addr_set (it + 0x4f + 16 * i, 16))
+            memcpy (self->pcscf6[self->n_pcscf6++], it + 0x4f + 16 * i, 16);
+    }
+    if (self->have6 && inet_ntop (AF_INET6, self->addr6, buf, sizeof (buf)))
+        ims_info (self, "PDN cid %u: %s, %u+%u P-CSCFs", self->cid, buf, self->n_pcscf4, self->n_pcscf6);
+    else if (self->have4 && inet_ntop (AF_INET, self->addr4, buf, sizeof (buf)))
+        ims_info (self, "PDN cid %u: %s, %u+%u P-CSCFs", self->cid, buf, self->n_pcscf4, self->n_pcscf6);
+    return (self->have4 || self->have6) && (self->n_pcscf4 + self->n_pcscf6) > 0;
+}
+
+static void request_pdn (MMShannonIms *self);
+
+static void
+data_call_list_ready (MMBroadbandModemShannon *modem,
+                      GAsyncResult            *res,
+                      gpointer                 user_data)
+{
+    MMShannonIms      *self;
+    g_autoptr(GBytes)  payload = NULL;
+    g_autoptr(GError)  error = NULL;
+    const guint8      *item;
+    gsize              item_len = 0;
+    static const guint8 stack[2] = { 1, 1 };
+
+    payload = ims_finish (modem, res, user_data, &self, &error);
+    if (!self)
+        return;
+    if (!payload) {
+        ims_fail_error (self, "GET_DATA_CALL_LIST", error);
+        return;
+    }
+    item = mm_sit_find_data_call_item (payload, self->cid, &item_len);
+    if (item && item[3] && load_pdn (self, item, item_len)) {
+        ims_command (self, SIT_AIMS_STACK_START, stack, sizeof (stack), 10,
+                     (GAsyncReadyCallback) stack_start_ready);
+        return;
+    }
+    if (self->pdn_requested) {
+        if (item)
+            ims_fail (self, "IMS PDN has no address or P-CSCF");
+        else
+            ims_fail (self, "IMS PDN not listed after setup");
+        return;
+    }
+    request_pdn (self);
+}
+
+static void
+setup_ready (MMBroadbandModemShannon *modem,
+             GAsyncResult            *res,
+             gpointer                 user_data)
+{
+    MMShannonIms      *self;
+    g_autoptr(GBytes)  payload = NULL;
+    g_autoptr(GError)  error = NULL;
+
+    payload = ims_finish (modem, res, user_data, &self, &error);
+    if (!self)
+        return;
+    if (!payload) {
+        ims_fail_error (self, "IMS PDN setup", error);
+        return;
+    }
+    if (g_bytes_get_size (payload) >= 2) {
+        const guint8 *d = g_bytes_get_data (payload, NULL);
+        guint16       cause = d[0] | (d[1] << 8);
+
+        if (cause) {
+            g_autofree gchar *reason = g_strdup_printf ("IMS PDN setup failed (cause %u)", cause);
+
+            ims_fail (self, reason);
+            return;
+        }
+    }
+    ims_command (self, SIT_GET_DATA_CALL_LIST, NULL, 0, 10, (GAsyncReadyCallback) data_call_list_ready);
+}
+
+static void
+request_pdn (MMShannonIms *self)
+{
+    g_autoptr(GByteArray) req = NULL;
+
+    req = mm_broadband_modem_shannon_build_setup_data_call (self->cid, self->apn, SIT_PDP_IPV4V6,
+                                                            SIT_APN_TYPE_IMS, SIT_PDP_IPV4V6);
+
+    self->pdn_requested = TRUE;
+    ims_info (self, "requesting IMS PDN (cid %u, apn '%s')", self->cid, self->apn);
+    ims_command (self, SIT_SETUP_DATA_CALL, req->data, req->len, 40, (GAsyncReadyCallback) setup_ready);
+}
+
+static void
+ims_start (MMShannonIms *self)
+{
+    self->generation++;
+    clear_timer (self);
+    self->pdn_requested = FALSE;
+    set_state (self, IMS_STATE_STARTING);
+    ims_info (self, "starting");
+    /* the AIMS stack outlives ModemManager: a CP still registered from an
+     * earlier run sends no new registration IND, so reset it first */
+    if (!self->started_once) {
+        self->started_once = TRUE;
+        teardown_cp (self, FALSE);
+    }
+    ims_command (self, SIT_GET_DATA_CALL_LIST, NULL, 0, 10, (GAsyncReadyCallback) data_call_list_ready);
+}
+
+void
+mm_shannon_ims_network_update (MMShannonIms *self,
+                               gboolean      lte_attached)
+{
+    if (self->lte != lte_attached)
+        ims_dbg (self, "LTE/NR %s", lte_attached ? "attached" : "detached");
+    self->lte = lte_attached;
+    /* a lost registration comes as IND 0x0d05; backoff restarts by itself */
+    if (lte_attached && self->state == IMS_STATE_IDLE)
+        ims_start (self);
+}
+
+/*****************************************************************************/
+/* Calls */
+
+static void
+ims_call_free (ImsCall *call)
+{
+    g_free (call->number);
+    g_slice_free (ImsCall, call);
+}
+
+static ImsCall *
+find_call (MMShannonIms *self,
+           guint8        id)
+{
+    GList *l;
+
+    for (l = self->calls; l; l = g_list_next (l))
+        if (((ImsCall *) l->data)->id == id)
+            return l->data;
+    return NULL;
+}
+
+/* "<sip:+1256...@host;user=phone>" / "tel:+1256..." -> "+1256..." */
+static gchar *
+normalize_number (const guint8 *p,
+                  gsize         len)
+{
+    g_autofree gchar *s = NULL;
+    gchar            *start;
+    gchar            *end;
+
+    if (!len)
+        return NULL;
+    s = g_strndup ((const gchar *) p, len);
+    start = g_strstrip (s);
+    if (*start == '<')
+        start++;
+    if (!g_ascii_strncasecmp (start, "sip:", 4) || !g_ascii_strncasecmp (start, "tel:", 4))
+        start += 4;
+    end = start + strcspn (start, "@;>");
+    *end = '\0';
+    return *start ? g_strdup (start) : NULL;
+}
+
+static MMCallState
+call_state_from_aims (guint8 state)
+{
+    switch (state) {
+    case 0:  return MM_CALL_STATE_ACTIVE;
+    case 1:  return MM_CALL_STATE_HELD;      /* holding (remote put on hold by us) */
+    case 2:  return MM_CALL_STATE_DIALING;
+    case 3:  return MM_CALL_STATE_RINGING_OUT;
+    case 4:  return MM_CALL_STATE_RINGING_IN;
+    case 5:  return MM_CALL_STATE_WAITING;
+    case 6:  return MM_CALL_STATE_TERMINATED;
+    case 7:
+    case 8:  return MM_CALL_STATE_HELD;
+    default: return MM_CALL_STATE_UNKNOWN;
+    }
+}
+
+/* the CP's side of call audio, while any call is set up or connected */
+static void
+update_audio (MMShannonIms *self)
+{
+    static const guint8 clk_on[1] = { 1 };
+    static const guint8 clk_off[1] = { 0 };
+    static const guint8 path[4] = { 1, 0, 0, 0 };
+    static const guint8 unmute[4] = { 0, 0, 0, 0 };
+    gboolean            need = FALSE;
+    GList              *l;
+
+    for (l = self->calls; l; l = g_list_next (l)) {
+        MMCallState st = ((ImsCall *) l->data)->state;
+
+        if (st == MM_CALL_STATE_DIALING || st == MM_CALL_STATE_RINGING_OUT ||
+            st == MM_CALL_STATE_ACTIVE || st == MM_CALL_STATE_HELD)
+            need = TRUE;
+    }
+    if (need && !self->audio_on) {
+        self->audio_on = TRUE;
+        ims_info (self, "call audio on");
+        /* SET_AUDIO_CLK, SET_AUDIOPATH (handset), SET_MUTE off: which of
+         * these the uplink needs is not known yet; the HAL sends them all */
+        fire (self, SIT_SET_AUDIO_CLK, clk_on, sizeof (clk_on), "SET_AUDIO_CLK");
+        fire (self, SIT_SET_AUDIOPATH, path, sizeof (path), "SET_AUDIOPATH");
+        fire (self, SIT_SET_MUTE, unmute, sizeof (unmute), "SET_MUTE");
+    } else if (!self->calls && self->audio_on) {
+        self->audio_on = FALSE;
+        ims_info (self, "call audio off");
+        fire (self, SIT_SET_AUDIO_CLK, clk_off, sizeof (clk_off), "SET_AUDIO_CLK");
+    }
+}
+
+static void
+report_call (MMShannonIms *self,
+             ImsCall      *call)
+{
+    MMCallInfo info = {
+        .index     = call->id + 1,
+        .direction = call->direction,
+        .state     = call->state,
+        .number    = call->number,
+    };
+
+    mm_iface_modem_voice_report_call (MM_IFACE_MODEM_VOICE (self->modem), &info);
+}
+
+static void
+handle_call_ring (MMShannonIms *self,
+                  const guint8 *d,
+                  gsize         len)
+{
+    ImsCall *call;
+    guint16  nlen;
+
+    /* u16 call type, u8 call id, u16 number len, number, ... */
+    if (len < 5)
+        return;
+    nlen = d[3] | (d[4] << 8);
+    if (5 + (gsize) nlen > len)
+        nlen = len - 5;
+    call = find_call (self, d[2]);
+    if (!call) {
+        call = g_slice_new0 (ImsCall);
+        call->id = d[2];
+        self->calls = g_list_append (self->calls, call);
+    }
+    call->direction = MM_CALL_DIRECTION_INCOMING;
+    call->state = MM_CALL_STATE_RINGING_IN;
+    if (nlen) {
+        g_free (call->number);
+        call->number = normalize_number (d + 5, nlen);
+    }
+    ims_info (self, "incoming call %u from %s", call->id, call->number ? call->number : "(unknown)");
+    report_call (self, call);
+}
+
+/* bounded reader for the variable-length status IND */
+typedef struct {
+    const guint8 *d;
+    gsize         len;
+    gsize         off;
+    gboolean      ok;
+} Reader;
+
+static guint
+rd_u8 (Reader *r)
+{
+    if (r->off + 1 > r->len) {
+        r->ok = FALSE;
+        return 0;
+    }
+    return r->d[r->off++];
+}
+
+static guint
+rd_u16 (Reader *r)
+{
+    guint v;
+
+    if (r->off + 2 > r->len) {
+        r->ok = FALSE;
+        return 0;
+    }
+    v = r->d[r->off] | (r->d[r->off + 1] << 8);
+    r->off += 2;
+    return v;
+}
+
+static const guint8 *
+rd_bytes (Reader *r,
+          gsize   n)
+{
+    const guint8 *p;
+
+    if (r->off + n > r->len) {
+        r->ok = FALSE;
+        return NULL;
+    }
+    p = r->d + r->off;
+    r->off += n;
+    return p;
+}
+
+static void
+handle_call_status (MMShannonIms *self,
+                    const guint8 *d,
+                    gsize         len)
+{
+    Reader            r = { d, len, 0, TRUE };
+    ImsCall          *call;
+    guint             id, aims_state, mpty, users, i, end_cause, n;
+    const guint8     *p;
+    g_autofree gchar *conn = NULL;
+    g_autofree gchar *called = NULL;
+    MMCallState       state;
+
+    /* RilIndCallStatus: u16 type, u8 id, u8 state, u8 mpty, u8 users,
+     * [mpty: u8, u8, u16 len + uri per user], u8 state reason, u8 end cause,
+     * u8 ecc, u16 sdp len + sdp, u16 media dir, u16 len + connected party,
+     * u16 remote media, u8 ecbm, u16 len + called number, ... */
+    rd_u16 (&r);
+    id = rd_u8 (&r);
+    aims_state = rd_u8 (&r);
+    mpty = rd_u8 (&r);
+    users = rd_u8 (&r);
+    if (!r.ok)
+        return;
+    if (mpty)
+        for (i = 0; i < users && r.ok; i++) {
+            rd_u8 (&r);
+            rd_u8 (&r);
+            rd_bytes (&r, rd_u16 (&r));
+        }
+    rd_u8 (&r);
+    end_cause = rd_u8 (&r);
+    rd_u8 (&r);
+    rd_bytes (&r, rd_u16 (&r));
+    rd_u16 (&r);
+    n = rd_u16 (&r);
+    if ((p = rd_bytes (&r, n)))
+        conn = normalize_number (p, n);
+    rd_u16 (&r);
+    rd_u8 (&r);
+    n = rd_u16 (&r);
+    if ((p = rd_bytes (&r, n)))
+        called = normalize_number (p, n);
+
+    state = call_state_from_aims (aims_state);
+    if (state == MM_CALL_STATE_UNKNOWN) {
+        ims_dbg (self, "call %u: unknown state %u", id, aims_state);
+        return;
+    }
+    call = find_call (self, id);
+    if (!call) {
+        if (state == MM_CALL_STATE_TERMINATED)
+            return;
+        call = g_slice_new0 (ImsCall);
+        call->id = id;
+        call->direction = (state == MM_CALL_STATE_RINGING_IN || state == MM_CALL_STATE_WAITING) ?
+                          MM_CALL_DIRECTION_INCOMING : MM_CALL_DIRECTION_OUTGOING;
+        self->calls = g_list_append (self->calls, call);
+    }
+    if (call->direction == MM_CALL_DIRECTION_OUTGOING)
+        self->dial_pending = FALSE;
+    if (!call->number) {
+        if (call->direction == MM_CALL_DIRECTION_OUTGOING)
+            call->number = g_strdup (called ? called : conn);
+        else
+            call->number = g_strdup (conn);
+    }
+    if (call->state != state)
+        ims_info (self, "call %u (%s, %s): %s", id,
+                  mm_call_direction_get_string (call->direction),
+                  call->number ? call->number : "?",
+                  mm_call_state_get_string (state));
+    if (state == MM_CALL_STATE_TERMINATED)
+        ims_dbg (self, "call %u end cause %u", id, end_cause);
+    call->state = state;
+    report_call (self, call);
+
+    if (state == MM_CALL_STATE_TERMINATED) {
+        self->calls = g_list_remove (self->calls, call);
+        ims_call_free (call);
+    }
+    update_audio (self);
+}
+
+/*****************************************************************************/
+/* Indications */
+
+static void
+handle_registration (MMShannonIms *self,
+                     const guint8 *d,
+                     gsize         len)
+{
+    guint reg, status, uri_len = 0;
+
+    /* u8 regState, u8 feature, u32 bitmask, u16 status, u16 uri len,
+     * u16 reason len, uris */
+    if (len < 8)
+        return;
+    reg = d[0];
+    status = d[6] | (d[7] << 8);
+    if (len >= 10)
+        uri_len = d[8] | (d[9] << 8);
+
+    if (reg == AIMS_REG_REGISTERED || reg == AIMS_REG_LIMITED) {
+        g_autofree gchar *uris = NULL;
+
+        if (len >= 12 && uri_len && 12 + (gsize) uri_len <= len)
+            uris = g_strndup ((const gchar *) d + 12, uri_len);
+        clear_timer (self);
+        self->backoff = 0;
+        set_state (self, IMS_STATE_REGISTERED);
+        ims_info (self, "registered%s (feature %u)%s%s", reg == AIMS_REG_LIMITED ? " (limited)" : "",
+                  d[1], uris ? ": " : "", uris ? uris : "");
+        return;
+    }
+    if (reg != AIMS_REG_NOT_REGISTERED) {
+        ims_dbg (self, "registration IND state %u status %u", reg, status);
+        return;
+    }
+    if (self->state == IMS_STATE_REGISTERED) {
+        g_autofree gchar *reason = g_strdup_printf ("registration lost (status %u)", status);
+
+        ims_fail (self, reason);
+    } else if ((self->state == IMS_STATE_WAIT_REG || self->state == IMS_STATE_STARTING) && status) {
+        g_autofree gchar *reason = g_strdup_printf ("registration failed (status %u)", status);
+
+        ims_fail (self, reason);
+    } else
+        ims_dbg (self, "not registered (status %u, %s)", status, state_names[self->state]);
+}
+
+gboolean
+mm_shannon_ims_handle_indication (MMShannonIms *self,
+                                  guint         id,
+                                  GBytes       *payload)
+{
+    gsize         len;
+    const guint8 *d = g_bytes_get_data (payload, &len);
+
+    switch (id) {
+    case SIT_IND_AIMS_REGISTRATION:
+        handle_registration (self, d, len);
+        return TRUE;
+    case SIT_IND_AIMS_CALL_RING:
+        handle_call_ring (self, d, len);
+        return TRUE;
+    case SIT_IND_AIMS_CALL_STATUS:
+        handle_call_status (self, d, len);
+        return TRUE;
+    case SIT_IND_DATA_CALL_LIST_CHANGED:
+        /* the item flips between active 1/2 (dormant/up) all the time:
+         * only a missing or inactive IMS PDN matters */
+        if (self->state == IMS_STATE_WAIT_REG || self->state == IMS_STATE_REGISTERED) {
+            const guint8 *item;
+            gsize         item_len;
+
+            item = mm_sit_find_data_call_item (payload, self->cid, &item_len);
+            if (!item || !item[3])
+                ims_fail (self, "IMS PDN went down");
+        }
+        return FALSE;   /* the bearer wants it too */
+    case SIT_IND_AIMS_NEW_SMS:
+    case SIT_IND_AIMS_NEW_SMS_STATUS_REPORT:
+        return FALSE;   /* SMS over IMS: the modem's messaging code */
+    default:
+        /* other AIMS INDs: ringback tone, RTP stats, frame time, ... */
+        return (id & 0xff00) == 0x0d00;
+    }
+}
+
+/*****************************************************************************/
+/* Voice interface support */
+
+gboolean
+mm_shannon_ims_is_registered (MMShannonIms *self)
+{
+    return self->state == IMS_STATE_REGISTERED;
+}
+
+gboolean
+mm_shannon_ims_has_calls (MMShannonIms *self)
+{
+    return self->calls != NULL || self->dial_pending;
+}
+
+gboolean
+mm_shannon_ims_dial_pending (MMShannonIms *self)
+{
+    return self->dial_pending;
+}
+
+void
+mm_shannon_ims_set_dial_pending (MMShannonIms *self,
+                                 gboolean      pending)
+{
+    self->dial_pending = pending;
+}
+
+GList *
+mm_shannon_ims_get_call_list (MMShannonIms *self)
+{
+    GList *list = NULL;
+    GList *l;
+
+    for (l = self->calls; l; l = g_list_next (l)) {
+        ImsCall    *call = l->data;
+        MMCallInfo *info;
+
+        info = g_slice_new0 (MMCallInfo);
+        info->index = call->id + 1;
+        info->direction = call->direction;
+        info->state = call->state;
+        info->number = g_strdup (call->number);
+        list = g_list_append (list, info);
+    }
+    return list;
+}
+
+gint
+mm_shannon_ims_get_dialing_call_id (MMShannonIms *self)
+{
+    GList *l;
+    gint   id = -1;
+
+    for (l = self->calls; l; l = g_list_next (l)) {
+        ImsCall *call = l->data;
+
+        if (call->direction == MM_CALL_DIRECTION_OUTGOING &&
+            (call->state == MM_CALL_STATE_DIALING || call->state == MM_CALL_STATE_RINGING_OUT))
+            id = call->id;
+    }
+    return id;
+}
+
+GByteArray *
+mm_shannon_ims_build_dial (const gchar *number)
+{
+    GByteArray *b;
+    gsize       n = MIN (strlen (number), AIMS_DIAL_NUMBER_MAX);
+
+    /* RilReqDial: u16 call type 1 (voice), u8 clir 0, u16 len, number[513],
+     * cug/tty/ecc/ussd/rtp port/dialog id/pulled/ecall/msd fields, u32
+     * emergency urn length: all zero for a plain voice call */
+    b = g_byte_array_sized_new (AIMS_DIAL_PAYLOAD_LEN);
+    put_le16 (b, 1);
+    g_byte_array_append (b, (guint8[]) { 0 }, 1);
+    put_le16 (b, n);
+    g_byte_array_append (b, (const guint8 *) number, n);
+    put_zero (b, AIMS_DIAL_PAYLOAD_LEN - b->len);
+    return b;
+}
+
+GByteArray *
+mm_shannon_ims_build_answer (void)
+{
+    GByteArray *b = g_byte_array_sized_new (6);
+
+    put_le16 (b, 1);    /* call type voice */
+    put_le16 (b, 1);    /* media direction MD_AUDIO_SR (send + receive) */
+    put_le16 (b, 0);    /* video rtp port */
+    return b;
+}
+
+GByteArray *
+mm_shannon_ims_build_hangup (guint8 call_id,
+                             guint8 reason)
+{
+    GByteArray *b = g_byte_array_sized_new (3);
+
+    g_byte_array_append (b, (guint8[]) { call_id, 1, reason }, 3);
+    return b;
+}
+
+GByteArray *
+mm_shannon_ims_build_dtmf (guint8 call_id,
+                           gchar  digit)
+{
+    GByteArray *b = g_byte_array_sized_new (3);
+
+    g_byte_array_append (b, (guint8[]) { call_id, 0, (guint8) digit }, 3);
+    return b;
+}
+
+/*****************************************************************************/
+
+void
+mm_shannon_ims_stop (MMShannonIms *self)
+{
+    gboolean was_up = self->state != IMS_STATE_IDLE && self->state != IMS_STATE_BACKOFF;
+
+    self->generation++;
+    clear_timer (self);
+    self->backoff = 0;
+    self->lte = FALSE;
+    self->dial_pending = FALSE;
+    g_list_free_full (g_steal_pointer (&self->calls), (GDestroyNotify) ims_call_free);
+    update_audio (self);
+    if (was_up) {
+        ims_info (self, "stopping");
+        if (mm_broadband_modem_shannon_peek_port_sit (self->modem))
+            teardown_cp (self, TRUE);
+    }
+    set_state (self, IMS_STATE_IDLE);
+}
+
+static gchar *
+conf_string (GKeyFile    *kf,
+             const gchar *group,
+             const gchar *key,
+             const gchar *def)
+{
+    gchar *v = kf ? g_key_file_get_string (kf, group, key, NULL) : NULL;
+
+    return v ? v : g_strdup (def);
+}
+
+MMShannonIms *
+mm_shannon_ims_new (MMBroadbandModemShannon *modem,
+                    GKeyFile                *settings)
+{
+    MMShannonIms *self;
+    gint          cid;
+
+    if (!settings || !g_key_file_get_boolean (settings, "ims", "enabled", NULL)) {
+        mm_obj_info (modem, "IMS: disabled (set [ims] enabled=true in shannon.conf for VoLTE)");
+        return NULL;
+    }
+    self = g_slice_new0 (MMShannonIms);
+    self->modem = modem;
+    self->apn = conf_string (settings, "ims", "apn", DEFAULT_APN);
+    cid = g_key_file_get_integer (settings, "ims", "cid", NULL);
+    self->cid = (cid >= 1 && cid <= 15) ? cid : DEFAULT_CID;
+    self->user_agent = conf_string (settings, "ims", "user-agent", DEFAULT_USER_AGENT);
+    self->manufacturer = conf_string (settings, "ims", "manufacturer", DEFAULT_MANUFACTURER);
+    self->model = conf_string (settings, "ims", "model", DEFAULT_MODEL);
+    self->build = conf_string (settings, "ims", "build", DEFAULT_BUILD);
+    self->device = conf_string (settings, "ims", "device", DEFAULT_DEVICE);
+    self->os = conf_string (settings, "ims", "os", DEFAULT_OS);
+    mm_obj_info (modem, "IMS: enabled (apn '%s', cid %u)", self->apn, self->cid);
+    return self;
+}
+
+void
+mm_shannon_ims_free (MMShannonIms *self)
+{
+    if (!self)
+        return;
+    clear_timer (self);
+    g_list_free_full (self->calls, (GDestroyNotify) ims_call_free);
+    g_free (self->apn);
+    g_free (self->user_agent);
+    g_free (self->manufacturer);
+    g_free (self->model);
+    g_free (self->build);
+    g_free (self->device);
+    g_free (self->os);
+    g_slice_free (MMShannonIms, self);
+}
diff --git a/src/plugins/shannon/mm-shannon-ims.h b/src/plugins/shannon/mm-shannon-ims.h
new file mode 100644
index 00000000..e6e02018
--- /dev/null
+++ b/src/plugins/shannon/mm-shannon-ims.h
@@ -0,0 +1,69 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * VoLTE on a Shannon modem (local plugin). The IMS/SIP stack runs in the CP
+ * ("AIMS"); like the stock ShannonIms app, the AP only brings up the IMS PDN
+ * and feeds the stack its configuration and the PDN details:
+ *
+ *   SETUP_DATA_CALL v2 (apn "ims", matchAllRuleAllowed) -> AIMS_STACK_START
+ *   -> SET_VOICE_OPERATION -> AIMS_HIDDEN_MENU x2 (UA/timers, media) ->
+ *   AIMS_ADD_PDN_INFO (address, P-CSCFs, DNS) -> IND_AIMS_REGISTRATION
+ *
+ * It also tracks AIMS calls (IND 0x0d01 ring, 0x0d04 status), reports them
+ * to the Voice interface, and enables the CP's side of call audio.
+ */
+
+#ifndef MM_SHANNON_IMS_H
+#define MM_SHANNON_IMS_H
+
+#include <glib.h>
+
+#define _LIBMM_INSIDE_MM
+#include <libmm-glib.h>
+
+#include "mm-broadband-modem-shannon.h"
+
+/* MMShannonIms is declared in mm-broadband-modem-shannon.h */
+
+MMShannonIms *mm_shannon_ims_new  (MMBroadbandModemShannon *modem,
+                                   GKeyFile                *settings);
+void          mm_shannon_ims_free (MMShannonIms *ims);
+
+/* registration update: bring IMS up when attached on LTE/NR */
+void          mm_shannon_ims_network_update (MMShannonIms *ims,
+                                             gboolean      lte_attached);
+/* modem disabled or CP gone: tear down */
+void          mm_shannon_ims_stop (MMShannonIms *ims);
+
+/* TRUE if the IND was consumed */
+gboolean      mm_shannon_ims_handle_indication (MMShannonIms *ims,
+                                                guint         id,
+                                                GBytes       *payload);
+
+gboolean      mm_shannon_ims_is_registered (MMShannonIms *ims);
+gboolean      mm_shannon_ims_has_calls     (MMShannonIms *ims);
+/* MMCallInfo list (index = CP call id + 1), free with mm_3gpp_call_info_list_free */
+GList        *mm_shannon_ims_get_call_list (MMShannonIms *ims);
+/* an AIMS_DIAL was sent and its call isn't listed yet: a call list
+ * report now would terminate the new call */
+gboolean      mm_shannon_ims_dial_pending     (MMShannonIms *ims);
+void          mm_shannon_ims_set_dial_pending (MMShannonIms *ims,
+                                               gboolean      pending);
+/* CP call id of the outgoing call still being set up, or -1 */
+gint          mm_shannon_ims_get_dialing_call_id (MMShannonIms *ims);
+
+/* AIMS request payloads */
+GByteArray   *mm_shannon_ims_build_dial   (const gchar *number);
+GByteArray   *mm_shannon_ims_build_answer (void);
+GByteArray   *mm_shannon_ims_build_hangup (guint8 call_id, guint8 reason);
+GByteArray   *mm_shannon_ims_build_dtmf   (guint8 call_id, gchar digit);
+
+#define SIT_AIMS_DIAL         0x0d00
+#define SIT_AIMS_ANSWER       0x0d02
+#define SIT_AIMS_HANGUP       0x0d03
+#define SIT_AIMS_SEND_DTMF    0x0d0a
+
+/* AIMS_HANGUP release reasons (ShannonIms CallHangupReason) */
+#define SHANNON_IMS_HANGUP_NORMAL 0
+#define SHANNON_IMS_HANGUP_REJECT 2
+
+#endif /* MM_SHANNON_IMS_H */
diff --git a/src/plugins/shannon/mm-sim-shannon.c b/src/plugins/shannon/mm-sim-shannon.c
new file mode 100644
index 00000000..62036494
--- /dev/null
+++ b/src/plugins/shannon/mm-sim-shannon.c
@@ -0,0 +1,633 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SIM card behind a Shannon modem, read over SIT (local plugin).
+ *
+ * IMSI comes from SIT_GET_IMSI; the operator id is derived from it. The
+ * ICCID (EF_ICCID) and GID1 (EF_GID1) are read over a logical channel opened
+ * on the USIM (open 0x0247 / APDU 0x020f / close 0x020e, as simread.py):
+ * read-only, and the CP's own basic-channel file selection is left alone. PIN handling is
+ * not implemented (the test SIM has no PIN).
+ */
+
+#include <string.h>
+
+#define _LIBMM_INSIDE_MM
+#include <libmm-glib.h>
+
+#include "mm-log-object.h"
+#include "mm-modem-helpers.h"
+#include "mm-base-modem.h"
+#include "mm-bind.h"
+#include "mm-broadband-modem-shannon.h"
+#include "mm-sim-shannon.h"
+#include "mm-sit-helpers.h"
+
+G_DEFINE_TYPE (MMSimShannon, mm_sim_shannon, MM_TYPE_BASE_SIM)
+
+/* BuildGetImsi(aid): u8 aid length + aid[16]; empty = current app */
+static const guint8 imsi_request[17] = { 0 };
+
+typedef enum {
+    EF_FILE_ICCID,
+    EF_FILE_GID1,
+} EfFile;
+
+/*****************************************************************************/
+
+static void
+imsi_ready (MMBroadbandModemShannon *modem,
+            GAsyncResult            *res,
+            GTask                   *task)
+{
+    g_autoptr(GBytes) payload = NULL;
+    GError           *error = NULL;
+    gchar            *imsi;
+
+    payload = mm_broadband_modem_shannon_command_finish (modem, res, &error);
+    if (!payload) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+    imsi = mm_sit_parse_digits (payload);
+    if (!imsi)
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_FAILED, "Couldn't parse IMSI");
+    else
+        g_task_return_pointer (task, imsi, g_free);
+    g_object_unref (task);
+}
+
+static void
+get_imsi (MMBaseSim           *self,
+          GAsyncReadyCallback  callback,
+          gpointer             user_data)
+{
+    g_autoptr(MMBaseModem) modem = NULL;
+    GTask                 *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    g_object_get (self, MM_BASE_SIM_MODEM, &modem, NULL);
+    mm_broadband_modem_shannon_command (MM_BROADBAND_MODEM_SHANNON (modem), SIT_GET_IMSI,
+                                        imsi_request, sizeof (imsi_request), 10,
+                                        (GAsyncReadyCallback) imsi_ready, task);
+}
+
+static gchar *
+load_string_finish (MMBaseSim     *self,
+                    GAsyncResult  *res,
+                    GError       **error)
+{
+    return g_task_propagate_pointer (G_TASK (res), error);
+}
+
+static void
+load_imsi (MMBaseSim           *self,
+           GAsyncReadyCallback  callback,
+           gpointer             user_data)
+{
+    get_imsi (self, callback, user_data);
+}
+
+/* MCC+MNC from the IMSI. EF_AD would give the MNC length; until that is
+ * read, use 3 digits for the North American MCCs and 2 elsewhere. */
+static void
+operator_imsi_ready (MMBaseSim    *self,
+                     GAsyncResult *res,
+                     GTask        *task)
+{
+    g_autofree gchar *imsi = NULL;
+    GError           *error = NULL;
+    guint             mnc_len;
+
+    imsi = load_string_finish (self, res, &error);
+    if (!imsi || strlen (imsi) < 6) {
+        g_task_return_error (task, error ? error :
+                             g_error_new (MM_CORE_ERROR, MM_CORE_ERROR_FAILED, "IMSI too short"));
+        g_object_unref (task);
+        return;
+    }
+    mnc_len = (imsi[0] == '3' && imsi[1] >= '0' && imsi[1] <= '1') ? 3 : 2;
+    g_task_return_pointer (task, g_strndup (imsi, 3 + mnc_len), g_free);
+    g_object_unref (task);
+}
+
+static void
+load_operator_identifier (MMBaseSim           *self,
+                          GAsyncReadyCallback  callback,
+                          gpointer             user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    get_imsi (self, (GAsyncReadyCallback) operator_imsi_ready, task);
+}
+
+/*****************************************************************************/
+/* Elementary file reads (ICCID, GID1) */
+
+typedef enum {
+    EF_STEP_OPEN,
+    EF_STEP_SELECT,
+    EF_STEP_READ,
+    EF_STEP_CLOSE,
+} EfStep;
+
+typedef struct {
+    MMBroadbandModemShannon *modem;
+    EfStep                   step;
+    guint8                   p1;
+    guint8                   path[4];
+    guint8                   path_len;
+    guint8                   le;
+    gboolean                 le_retried;
+    guint32                  channel;
+    gboolean                 channel_open;
+    GBytes                  *data;
+    GError                  *error;
+} EfContext;
+
+static void
+ef_context_free (EfContext *ctx)
+{
+    g_clear_object (&ctx->modem);
+    g_clear_pointer (&ctx->data, g_bytes_unref);
+    g_clear_error (&ctx->error);
+    g_slice_free (EfContext, ctx);
+}
+
+/* APDU on a logical channel (0x020f): u32 channel, cla, ins, p1, p2, p3,
+ * u16 data length, data, zero padding to 0x1a + 2 * len payload bytes.
+ * Response: sw1, sw2, u16 length, data. */
+static void
+send_apdu (EfContext           *ctx,
+           guint8               ins,
+           guint8               p1,
+           guint8               p2,
+           guint8               p3,
+           const guint8        *data,
+           guint16              data_len,
+           GAsyncReadyCallback  callback,
+           GTask               *task)
+{
+    g_autoptr(GByteArray) a = NULL;
+    guint32               hdr[6];
+    guint8                cla;
+    guint16               dl = GUINT16_TO_LE (data_len);
+    guint                 i;
+    gsize                 total = 0x1a + 2 * (gsize) data_len;
+
+    cla = ctx->channel < 4 ? ctx->channel : 0x40 | (ctx->channel - 4);
+    hdr[0] = ctx->channel; hdr[1] = cla; hdr[2] = ins;
+    hdr[3] = p1; hdr[4] = p2; hdr[5] = p3;
+    a = g_byte_array_sized_new (total);
+    for (i = 0; i < G_N_ELEMENTS (hdr); i++) {
+        guint32 v = GUINT32_TO_LE (hdr[i]);
+
+        g_byte_array_append (a, (const guint8 *) &v, 4);
+    }
+    g_byte_array_append (a, (const guint8 *) &dl, 2);
+    if (data_len)
+        g_byte_array_append (a, data, data_len);
+    if (a->len < total) {
+        gsize pad = total - a->len;
+
+        g_byte_array_set_size (a, total);
+        memset (a->data + total - pad, 0, pad);
+    }
+    mm_broadband_modem_shannon_command (ctx->modem, SIT_TRANSMIT_SIM_APDU_CHANNEL,
+                                        a->data, a->len, 10, callback, task);
+}
+
+static void ef_step (GTask *task);
+
+static gboolean
+apdu_result (GBytes        *payload,
+             guint16       *sw,
+             const guint8 **data,
+             gsize         *data_len)
+{
+    const guint8 *d;
+    gsize         len;
+    guint16       n;
+
+    d = g_bytes_get_data (payload, &len);
+    if (len < 4)
+        return FALSE;
+    *sw = (d[0] << 8) | d[1];
+    n = d[2] | (d[3] << 8);
+    if ((gsize) n + 4 > len)
+        n = len - 4;
+    *data = d + 4;
+    *data_len = n;
+    return TRUE;
+}
+
+static void
+ef_step_ready (MMBroadbandModemShannon *modem,
+               GAsyncResult            *res,
+               GTask                   *task)
+{
+    EfContext         *ctx = g_task_get_task_data (task);
+    g_autoptr(GBytes)  payload = NULL;
+    GError            *error = NULL;
+    const guint8      *data = NULL;
+    gsize              data_len = 0;
+    guint16            sw = 0;
+
+    payload = mm_broadband_modem_shannon_command_finish (modem, res, &error);
+
+    switch (ctx->step) {
+    case EF_STEP_OPEN: {
+        const guint8 *d;
+        gsize         len = 0;
+
+        if (payload)
+            d = g_bytes_get_data (payload, &len);
+        if (!payload || len < 4) {
+            g_task_return_error (task, error ? error :
+                                 g_error_new (MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                              "Couldn't open a SIM channel"));
+            g_object_unref (task);
+            return;
+        }
+        ctx->channel = d[0] | (d[1] << 8) | (d[2] << 16) | ((guint32) d[3] << 24);
+        ctx->channel_open = TRUE;
+        ctx->step = EF_STEP_SELECT;
+        break;
+    }
+    case EF_STEP_SELECT:
+        /* 9000 or 61xx (FCP available): either way the EF is selected */
+        if (!payload || !apdu_result (payload, &sw, &data, &data_len) ||
+            (sw != 0x9000 && (sw >> 8) != 0x61)) {
+            ctx->error = error ? error :
+                g_error_new (MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                             "SELECT EF %02X%02X failed (SW %04x)",
+                             ctx->path[ctx->path_len - 2], ctx->path[ctx->path_len - 1], sw);
+            error = NULL;
+            ctx->step = EF_STEP_CLOSE;
+            break;
+        }
+        ctx->step = EF_STEP_READ;
+        break;
+    case EF_STEP_READ:
+        /* 6Cxx: wrong length, xx is the right one (le 0 = whole file) */
+        if (payload && apdu_result (payload, &sw, &data, &data_len) &&
+            (sw >> 8) == 0x6C && !ctx->le_retried) {
+            ctx->le = sw & 0xff;
+            ctx->le_retried = TRUE;
+            break;
+        }
+        if (!payload || !apdu_result (payload, &sw, &data, &data_len) ||
+            sw != 0x9000 || data_len < 1) {
+            ctx->error = error ? error :
+                g_error_new (MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                             "READ BINARY EF %02X%02X failed (SW %04x)",
+                             ctx->path[ctx->path_len - 2], ctx->path[ctx->path_len - 1], sw);
+            error = NULL;
+        } else
+            ctx->data = g_bytes_new (data, data_len);
+        ctx->step = EF_STEP_CLOSE;
+        break;
+    case EF_STEP_CLOSE:
+        if (error)
+            mm_obj_dbg (g_task_get_source_object (task), "closing SIM channel %u: %s",
+                        ctx->channel, error->message);
+        g_clear_error (&error);
+        if (ctx->error)
+            g_task_return_error (task, g_steal_pointer (&ctx->error));
+        else
+            g_task_return_pointer (task, g_steal_pointer (&ctx->data), (GDestroyNotify) g_bytes_unref);
+        g_object_unref (task);
+        return;
+    default:
+        g_assert_not_reached ();
+    }
+    g_clear_error (&error);
+    ef_step (task);
+}
+
+static void
+ef_step (GTask *task)
+{
+    EfContext *ctx = g_task_get_task_data (task);
+
+    switch (ctx->step) {
+    case EF_STEP_OPEN: {
+        /* u8 aid length, aid[16], u8 p2; partial USIM AID (RID + app code) */
+        static const guint8 req[18] = {
+            7, 0xA0, 0x00, 0x00, 0x00, 0x87, 0x10, 0x02,
+        };
+
+        mm_broadband_modem_shannon_command (ctx->modem, SIT_OPEN_SIM_CHANNEL_WITH_P2,
+                                            req, sizeof (req), 10,
+                                            (GAsyncReadyCallback) ef_step_ready, task);
+        return;
+    }
+    case EF_STEP_SELECT:
+        /* return FCP */
+        send_apdu (ctx, 0xA4, ctx->p1, 0x04, ctx->path_len, ctx->path, ctx->path_len,
+                   (GAsyncReadyCallback) ef_step_ready, task);
+        return;
+    case EF_STEP_READ:
+        send_apdu (ctx, 0xB0, 0x00, 0x00, ctx->le, NULL, 0,
+                   (GAsyncReadyCallback) ef_step_ready, task);
+        return;
+    case EF_STEP_CLOSE: {
+        guint32 ch = GUINT32_TO_LE (ctx->channel);
+
+        mm_broadband_modem_shannon_command (ctx->modem, SIT_CLOSE_SIM_CHANNEL,
+                                            (const guint8 *) &ch, sizeof (ch), 10,
+                                            (GAsyncReadyCallback) ef_step_ready, task);
+        return;
+    }
+    default:
+        g_assert_not_reached ();
+    }
+}
+
+/* Transparent EF over a logical channel opened on the USIM: read-only, and
+ * the CP's own basic-channel file selection is left alone. */
+static void
+read_ef (MMBroadbandModemShannon *modem,
+         EfFile                   file,
+         GAsyncReadyCallback      callback,
+         gpointer                 user_data)
+{
+    EfContext *ctx;
+    GTask     *task;
+
+    task = g_task_new (modem, NULL, callback, user_data);
+    ctx = g_slice_new0 (EfContext);
+    ctx->modem = g_object_ref (modem);
+    ctx->step = EF_STEP_OPEN;
+    switch (file) {
+    case EF_FILE_ICCID:
+        /* SELECT by path from MF: 2FE2 */
+        ctx->p1 = 0x08;
+        ctx->path[0] = 0x2F; ctx->path[1] = 0xE2;
+        ctx->le = 10;
+        break;
+    case EF_FILE_GID1:
+        /* SELECT by file id under ADF.USIM (the channel's current DF) */
+        ctx->p1 = 0x00;
+        ctx->path[0] = 0x6F; ctx->path[1] = 0x3E;
+        ctx->le = 0;
+        break;
+    default:
+        g_assert_not_reached ();
+    }
+    ctx->path_len = 2;
+    g_task_set_task_data (task, ctx, (GDestroyNotify) ef_context_free);
+    ef_step (task);
+}
+
+static GBytes *
+read_ef_finish (MMBroadbandModemShannon  *modem,
+                GAsyncResult             *res,
+                GError                  **error)
+{
+    return g_task_propagate_pointer (G_TASK (res), error);
+}
+
+/* BCD, low nibble first, 0xF terminates */
+static gchar *
+decode_iccid (GBytes *bytes)
+{
+    const guint8 *data;
+    gsize         data_len, i;
+    GString      *s = g_string_new (NULL);
+
+    data = g_bytes_get_data (bytes, &data_len);
+    for (i = 0; i < data_len; i++) {
+        guint8 lo = data[i] & 0x0f, hi = data[i] >> 4;
+
+        if (lo > 9)
+            break;
+        g_string_append_c (s, '0' + lo);
+        if (hi > 9)
+            break;
+        g_string_append_c (s, '0' + hi);
+    }
+    return g_string_free (s, FALSE);
+}
+
+static void
+iccid_ready (MMBroadbandModemShannon *modem,
+             GAsyncResult            *res,
+             GTask                   *task)
+{
+    g_autoptr(GBytes) bytes = NULL;
+    GError           *error = NULL;
+    gchar            *iccid;
+
+    bytes = read_ef_finish (modem, res, &error);
+    if (!bytes) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+    iccid = decode_iccid (bytes);
+    if (!iccid[0]) {
+        g_free (iccid);
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_FAILED, "Empty ICCID");
+    } else
+        g_task_return_pointer (task, iccid, g_free);
+    g_object_unref (task);
+}
+
+static void
+load_sim_identifier (MMBaseSim           *self,
+                     GAsyncReadyCallback  callback,
+                     gpointer             user_data)
+{
+    g_autoptr(MMBaseModem) modem = NULL;
+    GTask                 *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    g_object_get (self, MM_BASE_SIM_MODEM, &modem, NULL);
+    read_ef (MM_BROADBAND_MODEM_SHANNON (modem), EF_FILE_ICCID,
+             (GAsyncReadyCallback) iccid_ready, task);
+}
+
+/*****************************************************************************/
+/* SIM identity for carrier selection, read before the SIM object exists */
+
+typedef struct {
+    gchar *imsi;
+    gchar *gid1;
+    gchar *iccid;
+} IdentityContext;
+
+static void
+identity_context_free (IdentityContext *ctx)
+{
+    g_free (ctx->imsi);
+    g_free (ctx->gid1);
+    g_free (ctx->iccid);
+    g_slice_free (IdentityContext, ctx);
+}
+
+gboolean
+mm_sim_shannon_read_identity_finish (MMBroadbandModemShannon  *modem,
+                                     GAsyncResult             *res,
+                                     gchar                   **imsi,
+                                     gchar                   **gid1,
+                                     gchar                   **iccid,
+                                     GError                  **error)
+{
+    IdentityContext *ctx;
+
+    if (!g_task_propagate_boolean (G_TASK (res), error))
+        return FALSE;
+    ctx = g_task_get_task_data (G_TASK (res));
+    *imsi = g_steal_pointer (&ctx->imsi);
+    *gid1 = g_steal_pointer (&ctx->gid1);
+    *iccid = g_steal_pointer (&ctx->iccid);
+    return TRUE;
+}
+
+static void
+identity_gid1_ready (MMBroadbandModemShannon *modem,
+                     GAsyncResult            *res,
+                     GTask                   *task)
+{
+    IdentityContext   *ctx = g_task_get_task_data (task);
+    g_autoptr(GBytes)  bytes = NULL;
+    g_autoptr(GError)  error = NULL;
+
+    /* EF_GID1 is optional (absent = no MVNO marker) */
+    bytes = read_ef_finish (modem, res, &error);
+    if (bytes) {
+        gsize         len;
+        const guint8 *d = g_bytes_get_data (bytes, &len);
+
+        ctx->gid1 = mm_utils_bin2hexstr (d, len);
+    } else
+        mm_obj_dbg (modem, "no GID1: %s", error->message);
+    g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+identity_iccid_ready (MMBroadbandModemShannon *modem,
+                      GAsyncResult            *res,
+                      GTask                   *task)
+{
+    IdentityContext   *ctx = g_task_get_task_data (task);
+    g_autoptr(GBytes)  bytes = NULL;
+    g_autoptr(GError)  error = NULL;
+
+    bytes = read_ef_finish (modem, res, &error);
+    if (bytes)
+        ctx->iccid = decode_iccid (bytes);
+    else
+        mm_obj_dbg (modem, "no ICCID: %s", error->message);
+    read_ef (modem, EF_FILE_GID1, (GAsyncReadyCallback) identity_gid1_ready, task);
+}
+
+static void
+identity_imsi_ready (MMBroadbandModemShannon *modem,
+                     GAsyncResult            *res,
+                     GTask                   *task)
+{
+    IdentityContext   *ctx = g_task_get_task_data (task);
+    g_autoptr(GBytes)  payload = NULL;
+    GError            *error = NULL;
+
+    payload = mm_broadband_modem_shannon_command_finish (modem, res, &error);
+    if (payload)
+        ctx->imsi = mm_sit_parse_digits (payload);
+    if (!ctx->imsi || strlen (ctx->imsi) < 6) {
+        g_task_return_error (task, error ? error :
+                             g_error_new (MM_CORE_ERROR, MM_CORE_ERROR_FAILED, "Invalid IMSI"));
+        g_object_unref (task);
+        return;
+    }
+    read_ef (modem, EF_FILE_ICCID, (GAsyncReadyCallback) identity_iccid_ready, task);
+}
+
+void
+mm_sim_shannon_read_identity (MMBroadbandModemShannon *modem,
+                              GAsyncReadyCallback      callback,
+                              gpointer                 user_data)
+{
+    GTask *task;
+
+    task = g_task_new (modem, NULL, callback, user_data);
+    g_task_set_task_data (task, g_slice_new0 (IdentityContext), (GDestroyNotify) identity_context_free);
+    mm_broadband_modem_shannon_command (modem, SIT_GET_IMSI, imsi_request, sizeof (imsi_request), 10,
+                                        (GAsyncReadyCallback) identity_imsi_ready, task);
+}
+
+/*****************************************************************************/
+
+void
+mm_sim_shannon_new (MMBaseModem         *modem,
+                    GCancellable        *cancellable,
+                    GAsyncReadyCallback  callback,
+                    gpointer             user_data)
+{
+    g_async_initable_new_async (MM_TYPE_SIM_SHANNON,
+                                G_PRIORITY_DEFAULT,
+                                cancellable,
+                                callback,
+                                user_data,
+                                MM_BASE_SIM_MODEM, modem,
+                                MM_BIND_TO, modem,
+                                "active", TRUE,
+                                NULL);
+}
+
+MMBaseSim *
+mm_sim_shannon_new_finish (GAsyncResult  *res,
+                           GError       **error)
+{
+    GObject *source;
+    GObject *sim;
+
+    source = g_async_result_get_source_object (res);
+    sim = g_async_initable_new_finish (G_ASYNC_INITABLE (source), res, error);
+    g_object_unref (source);
+    if (!sim)
+        return NULL;
+    mm_base_sim_export (MM_BASE_SIM (sim));
+    return MM_BASE_SIM (sim);
+}
+
+static void
+mm_sim_shannon_init (MMSimShannon *self)
+{
+}
+
+static void
+mm_sim_shannon_class_init (MMSimShannonClass *klass)
+{
+    MMBaseSimClass *base_sim_class = MM_BASE_SIM_CLASS (klass);
+
+    base_sim_class->load_imsi = load_imsi;
+    base_sim_class->load_imsi_finish = load_string_finish;
+    base_sim_class->load_operator_identifier = load_operator_identifier;
+    base_sim_class->load_operator_identifier_finish = load_string_finish;
+
+    /* AT (+CRSM/+CPIN) defaults of MMBaseSim: not available here */
+    base_sim_class->wait_sim_ready = NULL;
+    base_sim_class->wait_sim_ready_finish = NULL;
+    base_sim_class->load_sim_identifier = load_sim_identifier;
+    base_sim_class->load_sim_identifier_finish = load_string_finish;
+    base_sim_class->load_operator_name = NULL;
+    base_sim_class->load_operator_name_finish = NULL;
+    base_sim_class->load_emergency_numbers = NULL;
+    base_sim_class->load_emergency_numbers_finish = NULL;
+    base_sim_class->load_preferred_networks = NULL;
+    base_sim_class->load_preferred_networks_finish = NULL;
+    base_sim_class->set_preferred_networks = NULL;
+    base_sim_class->set_preferred_networks_finish = NULL;
+    base_sim_class->send_pin = NULL;
+    base_sim_class->send_pin_finish = NULL;
+    base_sim_class->send_puk = NULL;
+    base_sim_class->send_puk_finish = NULL;
+    base_sim_class->enable_pin = NULL;
+    base_sim_class->enable_pin_finish = NULL;
+    base_sim_class->change_pin = NULL;
+    base_sim_class->change_pin_finish = NULL;
+}
diff --git a/src/plugins/shannon/mm-sim-shannon.h b/src/plugins/shannon/mm-sim-shannon.h
