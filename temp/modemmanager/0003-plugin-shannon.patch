diff --git a/src/plugins/shannon/mm-broadband-modem-shannon.c b/src/plugins/shannon/mm-broadband-modem-shannon.c
new file mode 100644
index 00000000..e5cfbb8a
--- /dev/null
+++ b/src/plugins/shannon/mm-broadband-modem-shannon.c
@@ -0,0 +1,3072 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * Samsung Shannon modem driven over SIT (cpif), Google Pixel 6 (local plugin).
+ *
+ * The CP is booted outside ModemManager (tinycbd-hb + rfsd units), which also
+ * provision it per CP boot (slot mapping, carrier config). This class does
+ * the radio configuration the CP needs before it attaches (IND filter, NR
+ * mode, preferred network type, attach APN, allow data), radio power,
+ * identity, SIM status, registration and the data bearer. There is no AT
+ * port: every MMBroadbandModem AT default is either overridden here or
+ * disabled.
+ *
+ * Carrier config: a freshly booted CP (radio off) gets SET_CP_CARRIER_CONFIG
+ * during initialization; the CP reads the confpack over RFS (modem-rfsd) and
+ * answers with IND 0x4601. The manifest is picked from the SIM (IMSI, GID1,
+ * ICCID) with the confpack's own cfg.db, see mm-shannon-carrier.c; without
+ * a readable SIM (absent, PIN locked) the CP keeps its default config.
+ *
+ * Optional settings (overrides): /etc/ModemManager/shannon.conf
+ *   [attach]
+ *   apn=                  (initial EPS bearer; default empty = network's)
+ *   ip-type=ipv4v6        (ipv4, ipv6 or ipv4v6)
+ *   [carrier]
+ *   manifest=<confman sha1 from confpack/cfg.db confmap, 40 hex digits>
+ *   path=/mnt/vendor/modem_img/images/default/confpack   (as the CP sees it)
+ *   db=/run/oriole/modem/images/default/confpack/cfg.db  (as the AP sees it)
+ *   [carrier:<confpack entry name, e.g. us_vzw>]
+ *   ims-apn=VZWIMS        (per-carrier [ims] apn for the APN table)
+ *   [sms]
+ *   domain=0              (SEND_SMS domain byte, 0-3; 0 = auto)
+ *   [ims]
+ *   enabled=true          (VoLTE; more keys in mm-shannon-ims.c)
+ */
+
+#include <string.h>
+#include <sys/stat.h>
+
+#define _LIBMM_INSIDE_MM
+#include <libmm-glib.h>
+
+#include "mm-log-object.h"
+#include "mm-errors-types.h"
+#include "mm-iface-modem.h"
+#include "mm-iface-modem-3gpp.h"
+#include "mm-iface-modem-messaging.h"
+#include "mm-iface-modem-voice.h"
+#include "mm-modem-helpers.h"
+#include "mm-sms-part-3gpp.h"
+#include "mm-base-modem.h"
+#include "mm-bearer-shannon.h"
+#include "mm-broadband-modem-shannon.h"
+#include "mm-sim-shannon.h"
+#include "mm-sms-shannon.h"
+#include "mm-call-shannon.h"
+#include "mm-sit-helpers.h"
+#include "mm-shannon-ims.h"
+#include "mm-shannon-carrier.h"
+
+#define SHANNON_CONF "/etc/ModemManager/shannon.conf"
+/* created by modem-cp.service after each CP boot */
+#define SHANNON_CP_ONLINE "/run/shannon-cp-online"
+/* written here once that CP boot is provisioned */
+#define SHANNON_CP_PROVISIONED "/run/shannon-cp-provisioned"
+
+/* SET_PREFERRED_NTW_TYPE value (RIL table): 9 = LTE/GSM/WCDMA */
+#define SHANNON_PREF_NTW_TYPE 9
+/* SET_NR_MODE: the CP default (3) tries 5G SA first; 1 keeps NSA only */
+#define SHANNON_NR_MODE 1
+/* cid used for the attach APN and the default bearer (must be >= 1) */
+#define SHANNON_DEFAULT_CID 1
+#define SHANNON_DEFAULT_CONFPACK "/mnt/vendor/modem_img/images/default/confpack"
+#define SHANNON_DEFAULT_CARRIER_DB "/run/oriole/modem/images/default/confpack/cfg.db"
+/* seconds to wait for a readable SIM before the carrier config */
+#define CARRIER_SIM_WAIT_ATTEMPTS 45
+
+static void iface_modem_init      (MMIfaceModemInterface     *iface);
+static void iface_modem_3gpp_init (MMIfaceModem3gppInterface *iface);
+static void iface_modem_messaging_init (MMIfaceModemMessagingInterface *iface);
+static void iface_modem_voice_init     (MMIfaceModemVoiceInterface     *iface);
+
+static gboolean carrier_settled_cb (GTask *task);
+static void     mark_cp_provisioned (MMBroadbandModemShannon *self);
+static void     ps_idle_watchdog   (MMBroadbandModemShannon *self);
+
+static MMIfaceModemInterface     *iface_modem_parent;
+static MMIfaceModem3gppInterface *iface_modem_3gpp_parent;
+
+G_DEFINE_TYPE_EXTENDED (MMBroadbandModemShannon, mm_broadband_modem_shannon, MM_TYPE_BROADBAND_MODEM, 0,
+                        G_IMPLEMENT_INTERFACE (MM_TYPE_IFACE_MODEM,      iface_modem_init)
+                        G_IMPLEMENT_INTERFACE (MM_TYPE_IFACE_MODEM_3GPP, iface_modem_3gpp_init)
+                        G_IMPLEMENT_INTERFACE (MM_TYPE_IFACE_MODEM_MESSAGING, iface_modem_messaging_init)
+                        G_IMPLEMENT_INTERFACE (MM_TYPE_IFACE_MODEM_VOICE,     iface_modem_voice_init))
+
+struct _MMBroadbandModemShannonPrivate {
+    MMPortSit *sit;
+    gulong     indication_id;
+    gulong     failed_id;
+
+    gboolean   unsolicited_events_enabled;
+    gboolean   registration_events_enabled;
+    guint      registration_check_id;
+
+    gchar     *attach_apn;
+    guint8     attach_pdp;
+    gchar     *ims_apn;      /* data profile with the IMS + IA types */
+    gchar     *carrier_name; /* confpack entry picked for this CP boot */
+
+    GByteArray *carrier_manifest;   /* raw sha1: override or detected */
+    gchar      *carrier_path;
+    gchar      *carrier_db;
+    guint       carrier_sim_attempts;
+    GTask      *carrier_task;       /* waiting for IND 0x4601 */
+    guint       carrier_timeout_id;
+
+    guint      last_signal_quality;
+
+    /* PS "not registered, not searching" watchdog (see reg_apply) */
+    gint64     ps_idle_since;
+    gboolean   recycling;
+    guint      watchdog_id;
+
+    /* this modem object provisioned the CP: power-up always runs the full
+     * radio config (a fresh CP may report its radio "on" already) */
+    gboolean   fresh_cp;
+
+    /* new SMS INDs are taken (and acked) only while enabled; until then the
+     * CP keeps the message and delivers it again later */
+    gboolean   messaging_events_enabled;
+    GByteArray *smsc;
+
+    /* call state INDs trigger a call list reload only while enabled */
+    gboolean   voice_events_enabled;
+    guint      call_list_retry_id;
+
+    guint      last_call_count;
+
+    MMShannonIms *ims;
+};
+
+/*****************************************************************************/
+/* Helpers */
+
+MMPortSit *
+mm_broadband_modem_shannon_peek_port_sit (MMBroadbandModemShannon *self)
+{
+    return (self->priv->sit && mm_port_sit_is_open (self->priv->sit)) ? self->priv->sit : NULL;
+}
+
+MMShannonIms *
+mm_broadband_modem_shannon_peek_ims (MMBroadbandModemShannon *self)
+{
+    return self->priv->ims;
+}
+
+static void
+command_ready (MMPortSit    *port,
+               GAsyncResult *res,
+               GTask        *task)
+{
+    GError *error = NULL;
+    GBytes *payload;
+
+    payload = mm_port_sit_command_finish (port, res, &error);
+    if (!payload)
+        g_task_return_error (task, error);
+    else
+        g_task_return_pointer (task, payload, (GDestroyNotify) g_bytes_unref);
+    g_object_unref (task);
+}
+
+void
+mm_broadband_modem_shannon_command (MMBroadbandModemShannon *self,
+                                    guint16                  id,
+                                    const guint8            *payload,
+                                    gsize                    payload_len,
+                                    guint                    timeout_seconds,
+                                    GAsyncReadyCallback      callback,
+                                    gpointer                 user_data)
+{
+    GTask     *task;
+    MMPortSit *port;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    port = mm_broadband_modem_shannon_peek_port_sit (self);
+    if (!port) {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_WRONG_STATE,
+                                 "SIT port not available");
+        g_object_unref (task);
+        return;
+    }
+    mm_port_sit_command (port, id, payload, payload_len, timeout_seconds,
+                         (GAsyncReadyCallback) command_ready, task);
+}
+
+GBytes *
+mm_broadband_modem_shannon_command_finish (MMBroadbandModemShannon  *self,
+                                           GAsyncResult             *res,
+                                           GError                  **error)
+{
+    return g_task_propagate_pointer (G_TASK (res), error);
+}
+
+#define SIT_CMD(self, id, data, len, timeout, cb, task) \
+    mm_broadband_modem_shannon_command (MM_BROADBAND_MODEM_SHANNON (self), id, data, len, timeout, (GAsyncReadyCallback) (cb), task)
+#define SIT_FINISH(self, res, error) \
+    mm_broadband_modem_shannon_command_finish (MM_BROADBAND_MODEM_SHANNON (self), res, error)
+
+GByteArray *
+mm_broadband_modem_shannon_build_apn_payload (guint16      frame_len,
+                                              guint8       cid,
+                                              const gchar *apn,
+                                              guint8       pdp_type)
+{
+    GByteArray *a;
+    gsize       len = frame_len - SIT_RSP_HDR_LEN;
+    gsize       apn_len;
+
+    /* Frame offsets (ProtocolPsBuilder::BuildSetupDataCall): 0x0c cid,
+     * 0x0d rat (14 = LTE), 0x0e 1, 0x0f apn type, 0x10 apn[101],
+     * 0xd9 auth, 0xda pdp type; the attach APN frame (0xfb) also carries
+     * the pdp type at 0xf8 */
+    a = g_byte_array_sized_new (len);
+    g_byte_array_set_size (a, len);
+    memset (a->data, 0, len);
+    a->data[0x0c - SIT_RSP_HDR_LEN] = cid;
+    a->data[0x0d - SIT_RSP_HDR_LEN] = 14;
+    a->data[0x0e - SIT_RSP_HDR_LEN] = 1;
+    apn_len = apn ? MIN (strlen (apn), 100) : 0;
+    if (apn_len)
+        memcpy (a->data + 0x10 - SIT_RSP_HDR_LEN, apn, apn_len);
+    a->data[0xda - SIT_RSP_HDR_LEN] = pdp_type;
+    if (frame_len >= 0xf9)
+        a->data[0xf8 - SIT_RSP_HDR_LEN] = pdp_type;
+    return a;
+}
+
+/* SETUP_DATA_CALL v2 (0x27e B frame, request version 1 at 0xf5) with
+ * matchAllRuleAllowed and a DNN traffic descriptor: the v1 frame (0xf6 B)
+ * or matchAllRuleAllowed 0 fails with 2253 MATCH_ALL_RULE_NOT_ALLOWED on
+ * carrier configs that enforce URSP rules (Verizon; IMS on any carrier) */
+#define SIT_SETUP_DATA_CALL_V2_LEN 0x27e
+
+GByteArray *
+mm_broadband_modem_shannon_build_setup_data_call (guint8       cid,
+                                                  const gchar *apn,
+                                                  guint8       pdp_type,
+                                                  guint8       apn_type,
+                                                  guint8       pcscf_type)
+{
+    GByteArray *req;
+    guint8     *f;
+    gsize       apn_len = apn ? MIN (strlen (apn), 100) : 0;
+
+    req = mm_broadband_modem_shannon_build_apn_payload (SIT_SETUP_DATA_CALL_V2_LEN, cid, apn, pdp_type);
+    /* frame offsets below */
+    f = req->data - SIT_RSP_HDR_LEN;
+    f[0x0f] = apn_type;
+    f[0xdb] = pcscf_type;
+    f[0xf5] = 1;                         /* request version 1 = v2 */
+    memset (f + 0xf6, 0, 4);             /* (build_apn_payload puts the attach pdp at 0xf8) */
+    memset (f + 0xfc, 0xff, 4);          /* no slice SD */
+    memset (f + 0x101, 0xff, 4);
+    f[0x105] = 1;                        /* matchAllRuleAllowed */
+    f[0x106] = 2;                        /* traffic descriptor: DNN */
+    if (apn_len)
+        memcpy (f + 0x10a, apn, apn_len);
+    return req;
+}
+
+guint8
+mm_broadband_modem_shannon_pdp_type_from_ip_family (MMBearerIpFamily family)
+{
+    if (family == MM_BEARER_IP_FAMILY_IPV4)
+        return SIT_PDP_IP;
+    if (family == MM_BEARER_IP_FAMILY_IPV6)
+        return SIT_PDP_IPV6;
+    return SIT_PDP_IPV4V6;
+}
+
+static MMBearerIpFamily
+ip_family_from_pdp_type (guint8 pdp)
+{
+    switch (pdp) {
+    case SIT_PDP_IP:   return MM_BEARER_IP_FAMILY_IPV4;
+    case SIT_PDP_IPV6: return MM_BEARER_IP_FAMILY_IPV6;
+    default:           return MM_BEARER_IP_FAMILY_IPV4V6;
+    }
+}
+
+static gboolean
+set_carrier_manifest (MMBroadbandModemShannon *self,
+                      const gchar             *hex)
+{
+    gsize   bin_len = 0;
+    guint8 *bin;
+
+    bin = mm_utils_hexstr2bin (hex, -1, &bin_len, NULL);
+    if (!bin || bin_len == 0 || bin_len > 256) {
+        g_free (bin);
+        return FALSE;
+    }
+    g_clear_pointer (&self->priv->carrier_manifest, g_byte_array_unref);
+    self->priv->carrier_manifest = g_byte_array_new_take (bin, bin_len);
+    return TRUE;
+}
+
+static void
+load_settings (MMBroadbandModemShannon *self)
+{
+    g_autoptr(GKeyFile)  kf = NULL;
+    g_autofree gchar    *ip_type = NULL;
+    g_autofree gchar    *manifest = NULL;
+
+    self->priv->attach_pdp = SIT_PDP_IPV4V6;
+    g_clear_pointer (&self->priv->ims, mm_shannon_ims_free);
+    g_free (self->priv->ims_apn);
+    self->priv->ims_apn = g_strdup ("ims");
+    kf = g_key_file_new ();
+    if (!g_key_file_load_from_file (kf, SHANNON_CONF, G_KEY_FILE_NONE, NULL)) {
+        self->priv->ims = mm_shannon_ims_new (self, NULL);
+        return;
+    }
+    self->priv->ims = mm_shannon_ims_new (self, kf);
+    if (g_key_file_has_key (kf, "ims", "apn", NULL)) {
+        g_free (self->priv->ims_apn);
+        self->priv->ims_apn = g_key_file_get_string (kf, "ims", "apn", NULL);
+    }
+    g_free (self->priv->attach_apn);
+    self->priv->attach_apn = g_key_file_get_string (kf, "attach", "apn", NULL);
+    ip_type = g_key_file_get_string (kf, "attach", "ip-type", NULL);
+    if (!g_strcmp0 (ip_type, "ipv4"))
+        self->priv->attach_pdp = SIT_PDP_IP;
+    else if (!g_strcmp0 (ip_type, "ipv6"))
+        self->priv->attach_pdp = SIT_PDP_IPV6;
+
+    g_clear_pointer (&self->priv->carrier_manifest, g_byte_array_unref);
+    g_free (self->priv->carrier_path);
+    self->priv->carrier_path = g_key_file_get_string (kf, "carrier", "path", NULL);
+    g_free (self->priv->carrier_db);
+    self->priv->carrier_db = g_key_file_get_string (kf, "carrier", "db", NULL);
+    manifest = g_key_file_get_string (kf, "carrier", "manifest", NULL);
+    if (manifest && !set_carrier_manifest (self, manifest))
+        mm_obj_warn (self, "invalid [carrier] manifest in %s", SHANNON_CONF);
+    mm_obj_info (self, "attach APN from %s: '%s' (pdp type %u)", SHANNON_CONF,
+                 self->priv->attach_apn ? self->priv->attach_apn : "", self->priv->attach_pdp);
+}
+
+/* [carrier:<confpack entry name>] overrides for the carrier picked from the
+ * SIM (only what differs from the defaults, e.g. Verizon's IMS APN, which
+ * its carrier config requires in the APN table before it attaches) */
+static void
+apply_carrier_settings (MMBroadbandModemShannon *self)
+{
+    g_autoptr(GKeyFile)  kf = NULL;
+    g_autofree gchar    *group = NULL;
+    g_autofree gchar    *apn = NULL;
+
+    if (!self->priv->carrier_name || !self->priv->carrier_name[0])
+        return;
+    kf = g_key_file_new ();
+    if (!g_key_file_load_from_file (kf, SHANNON_CONF, G_KEY_FILE_NONE, NULL))
+        return;
+    group = g_strdup_printf ("carrier:%s", self->priv->carrier_name);
+    apn = g_key_file_get_string (kf, group, "ims-apn", NULL);
+    if (apn) {
+        mm_obj_info (self, "[%s] IMS APN '%s'", group, apn);
+        g_free (self->priv->ims_apn);
+        self->priv->ims_apn = g_steal_pointer (&apn);
+    }
+}
+
+/* read per message, so the value can be changed without a restart */
+guint8
+mm_broadband_modem_shannon_get_sms_domain (MMBroadbandModemShannon *self)
+{
+    g_autoptr(GKeyFile) kf = NULL;
+    gint                domain = 0;
+
+    /* 0-3 all behave the same over SGs (tested 2026-10-10) */
+    kf = g_key_file_new ();
+    if (g_key_file_load_from_file (kf, SHANNON_CONF, G_KEY_FILE_NONE, NULL))
+        domain = g_key_file_get_integer (kf, "sms", "domain", NULL);
+    if (domain < 0 || domain > 3)
+        domain = 0;
+    mm_obj_dbg (self, "SMS domain %d", domain);
+    return domain;
+}
+
+/*****************************************************************************/
+/* Indications */
+
+static void
+registration_check_ready (MMIfaceModem3gpp *self,
+                          GAsyncResult     *res)
+{
+    g_autoptr(GError) error = NULL;
+
+    if (!mm_iface_modem_3gpp_run_registration_checks_finish (self, res, &error))
+        mm_obj_dbg (self, "registration check failed: %s", error->message);
+}
+
+static gboolean
+registration_check_cb (MMBroadbandModemShannon *self)
+{
+    self->priv->registration_check_id = 0;
+    mm_iface_modem_3gpp_run_registration_checks (MM_IFACE_MODEM_3GPP (self),
+                                                 (GAsyncReadyCallback) registration_check_ready,
+                                                 NULL);
+    return G_SOURCE_REMOVE;
+}
+
+static void
+schedule_registration_check (MMBroadbandModemShannon *self)
+{
+    if (!self->priv->registration_events_enabled || self->priv->registration_check_id)
+        return;
+    /* INDs come in bursts: coalesce them */
+    self->priv->registration_check_id =
+        g_timeout_add (500, (GSourceFunc) registration_check_cb, self);
+}
+
+static void sms_received (MMBroadbandModemShannon *self,
+                          guint                    id,
+                          GBytes                  *payload);
+
+static void
+indication_cb (MMPortSit               *port,
+               guint                    id,
+               GBytes                  *payload,
+               MMBroadbandModemShannon *self)
+{
+    if (self->priv->ims && mm_shannon_ims_handle_indication (self->priv->ims, id, payload))
+        return;
+
+    switch (id) {
+    case SIT_IND_NTW_STATE_CHANGED:
+    case SIT_IND_REGISTRATION_FAILED:
+    case SIT_IND_RADIO_STATE_CHANGED:
+        schedule_registration_check (self);
+        break;
+    case SIT_IND_SIGNAL_STRENGTH: {
+        MMSitSignal sig;
+        guint       quality;
+
+        if (!mm_sit_parse_signal (payload, &sig))
+            break;
+        quality = mm_sit_signal_quality (&sig);
+        if (quality != self->priv->last_signal_quality) {
+            mm_obj_dbg (self, "LTE signal: rsrp %d dBm, rsrq %d dB, rssnr %d.%d dB -> %u%%",
+                        sig.rsrp, sig.rsrq, sig.rssnr / 10, ABS (sig.rssnr % 10), quality);
+            self->priv->last_signal_quality = quality;
+            mm_iface_modem_update_signal_quality (MM_IFACE_MODEM (self), quality);
+        }
+        break;
+    }
+    case SIT_IND_CP_CARRIER_SIM_INFO: {
+        /* the stock RIL picks the carrier from this; we read the SIM
+         * ourselves (layout per ProtocolMiscCarrierConfigSimInfoIndAdapter:
+         * strings from 0x00, not decoded yet) */
+        g_autofree gchar *hex = NULL;
+        gsize             len;
+        const guint8     *d = g_bytes_get_data (payload, &len);
+
+        hex = mm_utils_bin2hexstr (d, len);
+        mm_obj_dbg (self, "carrier SIM info: %s", hex);
+        break;
+    }
+    case SIT_IND_CP_CARRIER_CONFIG_STATUS:
+        if (self->priv->carrier_task) {
+            GTask            *task;
+            g_autofree gchar *hex = NULL;
+            gsize             len;
+            const guint8     *d = g_bytes_get_data (payload, &len);
+
+            /* "00 00 00 00 02 .." = still loading (the CP reads the confseqs
+             * over RFS next); only "01 .." means done. PS service requested
+             * before that fails with 0x20000 and the CP never registers. */
+            /* "00 00 00 00 02 .." = loading; all zeros = nothing to do (the
+             * same config was already loaded on this CP boot) */
+            if (len >= 5 && d[0] == 0 && d[4] == 2) {
+                hex = mm_utils_bin2hexstr (d, len);
+                mm_obj_dbg (self, "carrier config loading (%s)", hex);
+                break;
+            }
+            task = g_steal_pointer (&self->priv->carrier_task);
+
+            if (self->priv->carrier_timeout_id) {
+                g_source_remove (self->priv->carrier_timeout_id);
+                self->priv->carrier_timeout_id = 0;
+            }
+            hex = mm_utils_bin2hexstr (d, len);
+            if (len >= 1 && d[0] == 1)
+                mm_obj_info (self, "carrier config loaded (%s)", hex);
+            else
+                mm_obj_warn (self, "carrier config status %s", hex);
+            /* right after "01" the CP still rejects PS requests: settle */
+            g_timeout_add_seconds (5, (GSourceFunc) carrier_settled_cb, task);
+        }
+        break;
+    case SIT_IND_NEW_SMS:
+    case SIT_IND_NEW_SMS_STATUS_REPORT:
+    case SIT_IND_AIMS_NEW_SMS:
+    case SIT_IND_AIMS_NEW_SMS_STATUS_REPORT:
+        sms_received (self, id, payload);
+        break;
+    case SIT_IND_NEW_SMS_ON_SIM:
+    case SIT_IND_SIM_SMS_STORAGE_FULL:
+        mm_obj_dbg (self, "ignoring SIM SMS storage IND 0x%04x", id);
+        break;
+    case SIT_IND_CALL_STATE_CHANGED:
+    case SIT_IND_CALL_RING:
+    case SIT_IND_CALL_PRESENT_IND: {
+        gsize             len;
+        const guint8     *d = g_bytes_get_data (payload, &len);
+        g_autofree gchar *hex = len ? mm_utils_bin2hexstr (d, len) : NULL;
+
+        mm_obj_dbg (self, "call IND 0x%04x%s%s", id, hex ? ": " : "", hex ? hex : "");
+        if (self->priv->voice_events_enabled)
+            mm_iface_modem_voice_reload_all_calls (MM_IFACE_MODEM_VOICE (self), NULL, NULL);
+        break;
+    }
+    case SIT_IND_MODEM_RESTART:
+    case SIT_IND_PHONE_RESET:
+        mm_obj_warn (self, "CP reports reset/restart (IND 0x%04x)", id);
+        break;
+    default:
+        break;
+    }
+}
+
+static void
+port_failed_cb (MMPortSit               *port,
+                MMBroadbandModemShannon *self)
+{
+    mm_obj_warn (self, "SIT port failed (CP gone?): invalidating modem");
+    mm_base_modem_set_valid (MM_BASE_MODEM (self), FALSE);
+}
+
+/*****************************************************************************/
+/* Initialization / enabling: open the SIT port, no AT port */
+
+static gboolean
+open_sit_port (MMBroadbandModemShannon  *self,
+               GError                  **error)
+{
+    GList *ports;
+
+    if (self->priv->sit && mm_port_sit_is_open (self->priv->sit))
+        return TRUE;
+
+    if (!self->priv->sit) {
+        ports = mm_base_modem_find_ports (MM_BASE_MODEM (self), MM_PORT_SUBSYS_CPIF, MM_PORT_TYPE_SIT);
+        if (!ports) {
+            g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_NOT_FOUND, "No SIT port found");
+            return FALSE;
+        }
+        self->priv->sit = mm_port_sit_new (mm_port_get_device (MM_PORT (ports->data)));
+        g_list_free_full (ports, g_object_unref);
+        self->priv->indication_id = g_signal_connect (self->priv->sit, MM_PORT_SIT_SIGNAL_INDICATION,
+                                                      G_CALLBACK (indication_cb), self);
+        self->priv->failed_id = g_signal_connect (self->priv->sit, MM_PORT_SIT_SIGNAL_FAILED,
+                                                  G_CALLBACK (port_failed_cb), self);
+    }
+    if (!mm_port_sit_open (self->priv->sit, error))
+        return FALSE;
+    return TRUE;
+}
+
+static gpointer
+initialization_started_finish (MMBroadbandModem  *self,
+                               GAsyncResult      *res,
+                               GError           **error)
+{
+    g_task_propagate_boolean (G_TASK (res), error);
+    return NULL;
+}
+
+static gboolean radio_power_is_on (GBytes *payload);
+
+static gboolean
+carrier_settled_cb (GTask *task)
+{
+    mark_cp_provisioned (g_task_get_source_object (task));
+    g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+    return G_SOURCE_REMOVE;
+}
+
+static gboolean
+carrier_timeout_cb (MMBroadbandModemShannon *self)
+{
+    GTask *task = g_steal_pointer (&self->priv->carrier_task);
+
+    self->priv->carrier_timeout_id = 0;
+    mm_obj_warn (self, "no carrier config status from the CP");
+    if (task) {
+        g_task_return_boolean (task, TRUE);
+        g_object_unref (task);
+    }
+    return G_SOURCE_REMOVE;
+}
+
+static void
+carrier_config_ready (MMBroadbandModemShannon *self,
+                      GAsyncResult            *res,
+                      GTask                   *task)
+{
+    g_autoptr(GBytes) payload = NULL;
+    g_autoptr(GError) error = NULL;
+
+    payload = SIT_FINISH (self, res, &error);
+    if (!payload) {
+        mm_obj_warn (self, "SET_CP_CARRIER_CONFIG failed: %s", error->message);
+        g_task_return_boolean (task, TRUE);
+        g_object_unref (task);
+        return;
+    }
+    /* wait for IND 0x4601 (the CP reads the confpack over RFS first) */
+    self->priv->carrier_task = task;
+    self->priv->carrier_timeout_id = g_timeout_add_seconds (40, (GSourceFunc) carrier_timeout_cb, self);
+}
+
+static void slot_map_ready (MMBroadbandModemShannon *self,
+                            GAsyncResult            *res,
+                            GTask                   *task);
+static void carrier_sim_status_ready (MMBroadbandModemShannon *self,
+                                      GAsyncResult            *res,
+                                      GTask                   *task);
+static void send_carrier_config (MMBroadbandModemShannon *self,
+                                 GTask                   *task);
+
+/* provisioned for the current CP boot? (stamp newer than the online flag) */
+static gboolean
+cp_provisioned (void)
+{
+    struct stat online, done;
+
+    if (stat (SHANNON_CP_PROVISIONED, &done) != 0)
+        return FALSE;
+    if (stat (SHANNON_CP_ONLINE, &online) != 0)
+        return FALSE;
+    return (done.st_mtim.tv_sec > online.st_mtim.tv_sec ||
+            (done.st_mtim.tv_sec == online.st_mtim.tv_sec &&
+             done.st_mtim.tv_nsec >= online.st_mtim.tv_nsec));
+}
+
+/* the stamp holds the confpack entry name picked for this CP boot, so a
+ * restarted ModemManager applies the same per-carrier settings */
+static void
+mark_cp_provisioned (MMBroadbandModemShannon *self)
+{
+    g_autoptr(GError) error = NULL;
+    const gchar      *name = self->priv->carrier_name ? self->priv->carrier_name : "";
+
+    if (!g_file_set_contents (SHANNON_CP_PROVISIONED, name, -1, &error))
+        mm_obj_warn (self, "couldn't write %s: %s", SHANNON_CP_PROVISIONED, error->message);
+}
+
+static void
+start_provisioning (MMBroadbandModemShannon *self,
+                    GTask                   *task)
+{
+    /* Map the tray SIM (physical slot 0) to logical slot 0 = umts_ipc0;
+     * without it the card never reports its applications. SET_LOGICAL_TO_
+     * PHYSICAL_SLOT_MAPPING: u8 count + phys[4]. On a cold CP it answers
+     * late or never, but takes effect: don't wait long, ignore errors. */
+    static const guint8 map[5] = { 2, 0, 1, 0, 0 };
+
+    self->priv->fresh_cp = TRUE;
+    g_clear_pointer (&self->priv->carrier_name, g_free);
+    mm_obj_info (self, "mapping the tray SIM to logical slot 0");
+    SIT_CMD (self, SIT_SET_LOGICAL_TO_PHYSICAL_SLOT_MAPPING, map, sizeof (map), 10,
+             slot_map_ready, task);
+}
+
+static void
+init_radio_state_ready (MMBroadbandModemShannon *self,
+                        GAsyncResult            *res,
+                        GTask                   *task)
+{
+    g_autoptr(GBytes)     payload = NULL;
+    g_autoptr(GError)     error = NULL;
+
+    payload = SIT_FINISH (self, res, &error);
+    if (!payload || radio_power_is_on (payload)) {
+        /* radio on: this CP was provisioned already (MM restart) */
+        mm_obj_dbg (self, "skipping CP provisioning: %s",
+                    payload ? "radio already on" : error->message);
+        g_task_return_boolean (task, TRUE);
+        g_object_unref (task);
+        return;
+    }
+
+    start_provisioning (self, task);
+}
+
+static void
+slot_map_ready (MMBroadbandModemShannon *self,
+                GAsyncResult            *res,
+                GTask                   *task)
+{
+    g_autoptr(GBytes) payload = NULL;
+    g_autoptr(GError) error = NULL;
+
+    payload = SIT_FINISH (self, res, &error);
+    if (!payload)
+        mm_obj_dbg (self, "slot mapping: %s (expected on a cold CP)", error->message);
+
+    if (self->priv->carrier_manifest) {
+        mm_obj_info (self, "carrier config from %s", SHANNON_CONF);
+        send_carrier_config (self, task);
+        return;
+    }
+    self->priv->carrier_sim_attempts = 0;
+    SIT_CMD (self, SIT_GET_SIM_STATUS, NULL, 0, 10, carrier_sim_status_ready, task);
+}
+
+static void
+skip_carrier_config (MMBroadbandModemShannon *self,
+                     GTask                   *task,
+                     const gchar             *reason)
+{
+    mm_obj_warn (self, "no carrier config sent (%s): the CP keeps its default", reason);
+    mark_cp_provisioned (self);
+    g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+carrier_identity_ready (MMBroadbandModemShannon *self,
+                        GAsyncResult            *res,
+                        GTask                   *task)
+{
+    g_autoptr(MMShannonCarrier) carrier = NULL;
+    g_autoptr(GError)           error = NULL;
+    g_autofree gchar           *imsi = NULL;
+    g_autofree gchar           *gid1 = NULL;
+    g_autofree gchar           *iccid = NULL;
+
+    if (!mm_sim_shannon_read_identity_finish (self, res, &imsi, &gid1, &iccid, &error)) {
+        skip_carrier_config (self, task, error->message);
+        return;
+    }
+    carrier = mm_shannon_carrier_lookup (self->priv->carrier_db ? self->priv->carrier_db
+                                                                : SHANNON_DEFAULT_CARRIER_DB,
+                                         imsi, gid1, NULL, iccid, &error);
+    if (!carrier) {
+        skip_carrier_config (self, task, error->message);
+        return;
+    }
+    mm_obj_info (self, "SIM %.6s (GID1 %s): carrier %d '%s', confpack entry %d '%s'",
+                 imsi, gid1 ? gid1 : "none", carrier->carrier_id,
+                 carrier->name ? carrier->name : "?", carrier->config_id,
+                 carrier->config_name ? carrier->config_name : "?");
+    g_free (self->priv->carrier_name);
+    self->priv->carrier_name = g_strdup (carrier->config_name);
+    apply_carrier_settings (self);
+    if (!set_carrier_manifest (self, carrier->manifest)) {
+        skip_carrier_config (self, task, "invalid manifest in cfg.db");
+        return;
+    }
+    send_carrier_config (self, task);
+}
+
+static gboolean
+carrier_sim_status_retry_cb (GTask *task)
+{
+    SIT_CMD (g_task_get_source_object (task), SIT_GET_SIM_STATUS, NULL, 0, 10,
+             carrier_sim_status_ready, task);
+    return G_SOURCE_REMOVE;
+}
+
+/* the IMSI is readable once the USIM application is ready (state 5); right
+ * after the slot map the card reads as absent for a while */
+static void
+carrier_sim_status_ready (MMBroadbandModemShannon *self,
+                          GAsyncResult            *res,
+                          GTask                   *task)
+{
+    g_autoptr(GBytes) payload = NULL;
+    g_autoptr(GError) error = NULL;
+    MMSitSimStatus    st = { 0 };
+    gboolean          parsed;
+
+    payload = SIT_FINISH (self, res, &error);
+    parsed = payload && mm_sit_parse_sim_status (payload, &st);
+    if (parsed && st.card_state == 1 && st.n_apps && st.app_state == 5) {
+        mm_sim_shannon_read_identity (self, (GAsyncReadyCallback) carrier_identity_ready, task);
+        return;
+    }
+    if (parsed && st.card_state == 1 && (st.app_state == 2 || st.app_state == 3)) {
+        skip_carrier_config (self, task, "SIM locked");
+        return;
+    }
+    if (++self->priv->carrier_sim_attempts >= CARRIER_SIM_WAIT_ATTEMPTS) {
+        skip_carrier_config (self, task, parsed && st.card_state == 1 ? "SIM not ready" : "no SIM");
+        return;
+    }
+    g_timeout_add_seconds (1, (GSourceFunc) carrier_sim_status_retry_cb, task);
+}
+
+static void
+send_carrier_config (MMBroadbandModemShannon *self,
+                     GTask                   *task)
+{
+    g_autoptr(GByteArray) req = NULL;
+    const gchar          *path;
+    guint32               v;
+    gsize                 plen;
+
+    /* ProtocolMiscBuilder::BuildSetCpCarrierConfig: u32 len, path[256],
+     * u32 len, manifest[256] */
+    path = self->priv->carrier_path ? self->priv->carrier_path : SHANNON_DEFAULT_CONFPACK;
+    req = g_byte_array_sized_new (2 * (4 + 256));
+    g_byte_array_set_size (req, 2 * (4 + 256));
+    memset (req->data, 0, req->len);
+    plen = MIN (strlen (path), 255);
+    v = GUINT32_TO_LE ((guint32) plen);
+    memcpy (req->data, &v, 4);
+    memcpy (req->data + 4, path, plen);
+    v = GUINT32_TO_LE (self->priv->carrier_manifest->len);
+    memcpy (req->data + 260, &v, 4);
+    memcpy (req->data + 264, self->priv->carrier_manifest->data, self->priv->carrier_manifest->len);
+
+    mm_obj_info (self, "sending carrier config (%s)", path);
+    SIT_CMD (self, SIT_SET_CP_CARRIER_CONFIG, req->data, req->len, 40, carrier_config_ready, task);
+}
+
+static void
+initialization_started (MMBroadbandModem    *self,
+                        GAsyncReadyCallback  callback,
+                        gpointer             user_data)
+{
+    MMBroadbandModemShannon *shannon = MM_BROADBAND_MODEM_SHANNON (self);
+    GTask                   *task;
+    GError                  *error = NULL;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    load_settings (shannon);
+    if (!open_sit_port (shannon, &error)) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+    if (cp_provisioned ()) {
+        mm_obj_dbg (self, "CP already provisioned for this boot");
+        g_free (shannon->priv->carrier_name);
+        shannon->priv->carrier_name = NULL;
+        if (g_file_get_contents (SHANNON_CP_PROVISIONED, &shannon->priv->carrier_name, NULL, NULL))
+            apply_carrier_settings (shannon);
+        g_task_return_boolean (task, TRUE);
+        g_object_unref (task);
+        return;
+    }
+    if (!g_file_test (SHANNON_CP_ONLINE, G_FILE_TEST_EXISTS)) {
+        /* not started by modem-cp.service (manual bring-up): fall back to
+         * the radio state, off = fresh CP */
+        SIT_CMD (self, SIT_GET_RADIO_POWER, NULL, 0, 10, init_radio_state_ready, task);
+        return;
+    }
+    start_provisioning (shannon, task);
+}
+
+static gboolean
+enabling_started_finish (MMBroadbandModem  *self,
+                         GAsyncResult      *res,
+                         GError           **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void
+enabling_started (MMBroadbandModem    *self,
+                  GAsyncReadyCallback  callback,
+                  gpointer             user_data)
+{
+    GTask  *task;
+    GError *error = NULL;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    if (!open_sit_port (MM_BROADBAND_MODEM_SHANNON (self), &error))
+        g_task_return_error (task, error);
+    else
+        g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+/*****************************************************************************/
+/* Generic "query and decode" plumbing */
+
+typedef gpointer (*DecodeFn) (MMBroadbandModemShannon *self, GBytes *payload, GError **error);
+
+static void
+query_ready (MMBroadbandModemShannon *self,
+             GAsyncResult            *res,
+             GTask                   *task)
+{
+    g_autoptr(GBytes) payload = NULL;
+    GError           *error = NULL;
+    DecodeFn          decode = g_task_get_task_data (task);
+    gpointer          out;
+
+    payload = SIT_FINISH (self, res, &error);
+    if (!payload) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+    out = decode (self, payload, &error);
+    if (error)
+        g_task_return_error (task, error);
+    else
+        g_task_return_pointer (task, out, g_free);
+    g_object_unref (task);
+}
+
+static void
+query (gpointer             self,
+       guint16              id,
+       const guint8        *data,
+       gsize                len,
+       DecodeFn             decode,
+       GAsyncReadyCallback  callback,
+       gpointer             user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    g_task_set_task_data (task, decode, NULL);
+    SIT_CMD (self, id, data, len, 10, query_ready, task);
+}
+
+static gchar *
+query_string_finish (gpointer       self,
+                     GAsyncResult  *res,
+                     GError       **error)
+{
+    return g_task_propagate_pointer (G_TASK (res), error);
+}
+
+static gpointer
+decode_digits (MMBroadbandModemShannon *self, GBytes *payload, GError **error)
+{
+    gchar *s = mm_sit_parse_digits (payload);
+
+    if (!s)
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_FAILED, "Couldn't parse digits");
+    return s;
+}
+
+static gpointer
+decode_baseband (MMBroadbandModemShannon *self, GBytes *payload, GError **error)
+{
+    gchar *s = mm_sit_parse_baseband_sw (payload);
+
+    if (!s)
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_FAILED, "Couldn't parse baseband version");
+    return s;
+}
+
+static gpointer
+decode_imei_checksum (MMBroadbandModemShannon *self, GBytes *payload, GError **error)
+{
+    g_autofree gchar *imei = mm_sit_parse_digits (payload);
+
+    return g_compute_checksum_for_string (G_CHECKSUM_SHA1, imei ? imei : "shannon", -1);
+}
