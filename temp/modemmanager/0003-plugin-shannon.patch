+}
+
+/* Power up: if the radio is off, send the configuration the CP needs before
+ * it registers on LTE, then radio on. Each step is logged; only radio on is
+ * fatal. */
+
+typedef struct {
+    guint16  id;
+    GBytes  *payload;
+    guint    timeout;
+    gboolean fatal;
+    const gchar *name;
+    guint    retries;   /* extra attempts, 3 s apart */
+} PowerStep;
+
+typedef struct {
+    GArray *steps;
+    guint   i;
+} PowerContext;
+
+static void
+power_step_clear (PowerStep *s)
+{
+    g_clear_pointer (&s->payload, g_bytes_unref);
+}
+
+static void
+power_context_free (PowerContext *ctx)
+{
+    g_array_unref (ctx->steps);
+    g_slice_free (PowerContext, ctx);
+}
+
+/* SET_DATA_PROFILE (ProtocolPsBuilder::BuildSetDataProfile, 0xf6 B frame):
+ * 0x0c u32 profile id, 0x10 apn[101], 0x75 pdp, 0x76 roaming pdp, 0x77
+ * auth, 0x78 user[50], 0xaa password[49], 0xdd u32 max conns time, 0xe1 u32
+ * max conns, 0xe5 u32 wait time, 0xe9 u8 enabled, 0xea u32 APN types
+ * (Android ApnTypes bitmap), 0xee u32 bearer bitmap. Some carrier configs
+ * (Verizon) keep the CP from attaching until the APN table holds an IMS
+ * profile: the CP attaches on it, as with Android's setDataProfile. */
+#define SIT_DATA_PROFILE_LEN        0xf6
+#define DATA_PROFILE_ID_IMS         2
+#define APN_TYPE_IMS                0x40
+#define APN_TYPE_IA                 0x100
+
+static GByteArray *
+build_ims_data_profile (const gchar *apn)
+{
+    GByteArray *a;
+    gsize       len = SIT_DATA_PROFILE_LEN - SIT_RSP_HDR_LEN;
+    gsize       apn_len = MIN (strlen (apn), 100);
+    guint32     v;
+
+    a = g_byte_array_sized_new (len);
+    g_byte_array_set_size (a, len);
+    memset (a->data, 0, len);
+    v = GUINT32_TO_LE (DATA_PROFILE_ID_IMS);
+    memcpy (a->data + 0x0c - SIT_RSP_HDR_LEN, &v, 4);
+    memcpy (a->data + 0x10 - SIT_RSP_HDR_LEN, apn, apn_len);
+    a->data[0x75 - SIT_RSP_HDR_LEN] = SIT_PDP_IPV4V6;
+    a->data[0x76 - SIT_RSP_HDR_LEN] = SIT_PDP_IPV4V6;
+    a->data[0xe9 - SIT_RSP_HDR_LEN] = 1;
+    v = GUINT32_TO_LE (APN_TYPE_IMS | APN_TYPE_IA);
+    memcpy (a->data + 0xea - SIT_RSP_HDR_LEN, &v, 4);
+    return a;
+}
+
+static void
+add_step (GArray       *steps,
+          const gchar  *name,
+          guint16       id,
+          const guint8 *data,
+          gsize         len,
+          guint         timeout,
+          gboolean      fatal)
+{
+    PowerStep s = { id, g_bytes_new (data, len), timeout, fatal, name, 0 };
+
+    g_array_append_val (steps, s);
+}
+
+static void power_step_run (GTask *task);
+
+static void
+add_ims_profile_step (MMBroadbandModemShannon *self,
+                      GArray                  *steps)
+{
+    g_autoptr(GByteArray) profile = NULL;
+
+    if (!self->priv->ims_apn || !self->priv->ims_apn[0])
+        return;
+    profile = build_ims_data_profile (self->priv->ims_apn);
+    add_step (steps, "IMS data profile", SIT_SET_DATA_PROFILE, profile->data, profile->len, 10, FALSE);
+}
+
+static gboolean
+power_step_retry_cb (GTask *task)
+{
+    power_step_run (task);
+    return G_SOURCE_REMOVE;
+}
+
+static void
+power_step_ready (MMBroadbandModemShannon *self,
+                  GAsyncResult            *res,
+                  GTask                   *task)
+{
+    g_autoptr(GBytes)  payload = NULL;
+    g_autoptr(GError)  error = NULL;
+    PowerContext      *ctx = g_task_get_task_data (task);
+    PowerStep         *s = &g_array_index (ctx->steps, PowerStep, ctx->i);
+
+    payload = SIT_FINISH (self, res, &error);
+    if (!payload && s->retries > 0) {
+        s->retries--;
+        mm_obj_dbg (self, "radio config step '%s' failed (%s), retrying", s->name, error->message);
+        g_timeout_add_seconds (3, (GSourceFunc) power_step_retry_cb, task);
+        return;
+    }
+    if (!payload) {
+        if (s->fatal) {
+            g_task_return_error (task, g_steal_pointer (&error));
+            g_object_unref (task);
+            return;
+        }
+        mm_obj_warn (self, "radio config step '%s' failed: %s", s->name, error->message);
+    } else
+        mm_obj_dbg (self, "radio config step '%s' done", s->name);
+    ctx->i++;
+    power_step_run (task);
+}
+
+static void
+power_step_run (GTask *task)
+{
+    PowerContext *ctx = g_task_get_task_data (task);
+    PowerStep    *s;
+    gsize         len;
+    const guint8 *d;
+
+    if (ctx->i >= ctx->steps->len) {
+        g_task_return_boolean (task, TRUE);
+        g_object_unref (task);
+        return;
+    }
+    s = &g_array_index (ctx->steps, PowerStep, ctx->i);
+    d = g_bytes_get_data (s->payload, &len);
+    SIT_CMD (g_task_get_source_object (task), s->id, d, len, s->timeout, power_step_ready, task);
+}
+
+static void
+run_steps (gpointer             self,
+           GArray              *steps,
+           GAsyncReadyCallback  callback,
+           gpointer             user_data)
+{
+    GTask        *task;
+    PowerContext *ctx;
+
+    ctx = g_slice_new0 (PowerContext);
+    ctx->steps = steps;
+    task = g_task_new (self, NULL, callback, user_data);
+    g_task_set_task_data (task, ctx, (GDestroyNotify) power_context_free);
+    power_step_run (task);
+}
+
+static GArray *
+new_steps (void)
+{
+    GArray *steps;
+
+    steps = g_array_new (FALSE, FALSE, sizeof (PowerStep));
+    g_array_set_clear_func (steps, (GDestroyNotify) power_step_clear);
+    return steps;
+}
+
+static void
+add_radio_power_step (GArray   *steps,
+                      gboolean  on)
+{
+    guint8 rp[6] = { on ? SIT_RADIO_POWER_ON : SIT_RADIO_POWER_OFF, 0, 0, 0, 0, 0 };
+
+    add_step (steps, on ? "radio on" : "radio off", SIT_SET_RADIO_POWER, rp, sizeof (rp), 20, TRUE);
+}
+
+static gboolean
+modem_power_finish (MMIfaceModem  *self,
+                    GAsyncResult  *res,
+                    GError       **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+typedef struct {
+    GAsyncReadyCallback callback;
+    gpointer            user_data;
+} PowerUpForward;
+
+static void
+modem_power_up_state_ready (MMBroadbandModemShannon *self,
+                            GAsyncResult            *res,
+                            PowerUpForward          *fwd);
+
+static void
+modem_power_up (MMIfaceModem        *self,
+                GAsyncReadyCallback  callback,
+                gpointer             user_data)
+{
+    PowerUpForward *fwd;
+
+    fwd = g_slice_new (PowerUpForward);
+    fwd->callback = callback;
+    fwd->user_data = user_data;
+    mm_broadband_modem_shannon_command (MM_BROADBAND_MODEM_SHANNON (self), SIT_GET_RADIO_POWER, NULL, 0, 10,
+                                        (GAsyncReadyCallback) modem_power_up_state_ready, fwd);
+}
+
+static void
+modem_power_up_state_ready (MMBroadbandModemShannon *self,
+                            GAsyncResult            *res,
+                            PowerUpForward          *fwd)
+{
+    g_autoptr(GBytes)     payload = NULL;
+    g_autoptr(GByteArray) apn = NULL;
+    g_autoptr(GError)     error = NULL;
+    GArray               *steps;
+    static const guint8   filter[4]  = { 0xff, 0xff, 0xff, 0xff };
+    static const guint8   nr_mode    = SHANNON_NR_MODE;
+    static const guint8   pref[4]    = { SHANNON_PREF_NTW_TYPE, 0, 0, 0 };
+    static const guint8   allow_data = 1;
+
+    steps = new_steps ();
+    payload = SIT_FINISH (self, res, &error);
+    if (payload && radio_power_is_on (payload) && !self->priv->fresh_cp) {
+        mm_obj_dbg (self, "radio already on: skipping radio configuration");
+    } else {
+        if (!payload)
+            mm_obj_warn (self, "couldn't read radio power: %s", error->message);
+        if (self->priv->fresh_cp) {
+            self->priv->fresh_cp = FALSE;
+            add_radio_power_step (steps, FALSE);
+        }
+        add_step (steps, "IND filter", SIT_SET_IND_FILTER, filter, sizeof (filter), 10, FALSE);
+        add_step (steps, "NR mode", SIT_SET_NR_MODE, &nr_mode, 1, 10, FALSE);
+        add_step (steps, "preferred network type", SIT_SET_PREFERRED_NTW_TYPE, pref, sizeof (pref), 10, FALSE);
+        add_ims_profile_step (self, steps);
+        apn = mm_broadband_modem_shannon_build_apn_payload (0xfb, SHANNON_DEFAULT_CID,
+                                                           self->priv->attach_apn, self->priv->attach_pdp);
+        add_step (steps, "attach APN", SIT_SET_INITIAL_ATTACH_APN, apn->data, apn->len, 15, FALSE);
+        add_step (steps, "allow data", SIT_SET_PS_SERVICE, &allow_data, 1, 30, FALSE);
+        g_array_index (steps, PowerStep, steps->len - 1).retries = 5;
+        add_radio_power_step (steps, TRUE);
+    }
+    run_steps (self, steps, fwd->callback, fwd->user_data);
+    g_slice_free (PowerUpForward, fwd);
+}
+
+static void
+modem_power_down (MMIfaceModem        *self,
+                  GAsyncReadyCallback  callback,
+                  gpointer             user_data)
+{
+    GArray *steps = new_steps ();
+
+    add_radio_power_step (steps, FALSE);
+    run_steps (self, steps, callback, user_data);
+}
+
+/*****************************************************************************/
+/* After the first radio on that follows a carrier config the CP can stay
+ * "not registered, not searching" (it ignored the attach APN or allow data
+ * while busy); a radio cycle with both re-sent fixes it (2026-10-09). */
+
+static void
+recycle_ready (MMBroadbandModemShannon *self,
+               GAsyncResult            *res)
+{
+    g_autoptr(GError) error = NULL;
+
+    if (!g_task_propagate_boolean (G_TASK (res), &error))
+        mm_obj_warn (self, "radio cycle failed: %s", error->message);
+    self->priv->recycling = FALSE;
+    self->priv->ps_idle_since = 0;
+    schedule_registration_check (self);
+}
+
+static void
+ps_idle_watchdog (MMBroadbandModemShannon *self)
+{
+    g_autoptr(GByteArray) apn = NULL;
+    GArray               *steps;
+    static const guint8   allow_data = 1;
+
+    MMModemState          state = MM_MODEM_STATE_UNKNOWN;
+
+    if (!self->priv->ps_idle_since || self->priv->recycling ||
+        g_get_monotonic_time () - self->priv->ps_idle_since < 45 * G_USEC_PER_SEC)
+        return;
+    /* never bring the radio back up behind a user's disable/low power */
+    g_object_get (self, MM_IFACE_MODEM_STATE, &state, NULL);
+    if (state < MM_MODEM_STATE_ENABLED || !self->priv->registration_events_enabled) {
+        self->priv->ps_idle_since = 0;
+        return;
+    }
+
+    mm_obj_info (self, "PS not searching for 45 s: radio cycle");
+    self->priv->recycling = TRUE;
+    steps = new_steps ();
+    add_radio_power_step (steps, FALSE);
+    /* on a fresh CP the first radio on may still drop the APN table (the
+     * Verizon config then idles until this cycle): send it again */
+    add_ims_profile_step (self, steps);
+    apn = mm_broadband_modem_shannon_build_apn_payload (0xfb, SHANNON_DEFAULT_CID,
+                                                       self->priv->attach_apn, self->priv->attach_pdp);
+    add_step (steps, "attach APN", SIT_SET_INITIAL_ATTACH_APN, apn->data, apn->len, 15, FALSE);
+    add_step (steps, "allow data", SIT_SET_PS_SERVICE, &allow_data, 1, 30, FALSE);
+    g_array_index (steps, PowerStep, steps->len - 1).retries = 5;
+    add_radio_power_step (steps, TRUE);
+    run_steps (self, steps, (GAsyncReadyCallback) recycle_ready, NULL);
+}
+
+/*****************************************************************************/
+/* Registration */
+
+typedef struct {
+    MMSitRegState cs;
+    MMSitRegState ps;
+    gboolean      have_cs;
+    gboolean      have_ps;
+} RegContext;
+
+static gboolean
+rat_is_lte (guint8 rat)
+{
+    return rat == 14 || rat == 20;
+}
+
+static void
+reg_apply (MMBroadbandModemShannon *self,
+           RegContext              *ctx)
+{
+    MMIfaceModem3gpp            *iface = MM_IFACE_MODEM_3GPP (self);
+    MMModem3gppRegistrationState cs = MM_MODEM_3GPP_REGISTRATION_STATE_UNKNOWN;
+    MMModem3gppRegistrationState ps = MM_MODEM_3GPP_REGISTRATION_STATE_UNKNOWN;
+    MMModem3gppRegistrationState eps = MM_MODEM_3GPP_REGISTRATION_STATE_UNKNOWN;
+    MMModem3gppRegistrationState nr = MM_MODEM_3GPP_REGISTRATION_STATE_UNKNOWN;
+    MMModemAccessTechnology      act = MM_MODEM_ACCESS_TECHNOLOGY_UNKNOWN;
+
+    if (ctx->have_cs)
+        cs = mm_sit_reg_state_to_mm (ctx->cs.state);
+    if (ctx->have_ps) {
+        MMModem3gppRegistrationState st = mm_sit_reg_state_to_mm (ctx->ps.state);
+
+        if (rat_is_lte (ctx->ps.rat))
+            eps = st;
+        else if (ctx->ps.rat == 21)
+            nr = st;
+        else
+            ps = st;
+        act = mm_sit_rat_to_access_tech (ctx->ps.rat);
+    }
+    if (act == MM_MODEM_ACCESS_TECHNOLOGY_UNKNOWN && ctx->have_cs)
+        act = mm_sit_rat_to_access_tech (ctx->cs.rat);
+
+    mm_obj_dbg (self, "registration: CS state %u rat %u cause %u, PS state %u rat %u cause %u",
+                ctx->cs.state, ctx->cs.rat, ctx->cs.reject_cause,
+                ctx->ps.state, ctx->ps.rat, ctx->ps.reject_cause);
+
+    /* not registered, not searching: with no RAT (provisioning lost) or
+     * camped on a cell (Verizon config without a usable APN table) */
+    if (ctx->have_ps && ctx->ps.state == 0) {
+        if (!self->priv->ps_idle_since)
+            self->priv->ps_idle_since = g_get_monotonic_time ();
+    } else
+        self->priv->ps_idle_since = 0;
+
+    mm_iface_modem_3gpp_update_cs_registration_state  (iface, cs,  TRUE);
+    mm_iface_modem_3gpp_update_ps_registration_state  (iface, ps,  TRUE);
+    mm_iface_modem_3gpp_update_eps_registration_state (iface, eps, TRUE);
+    mm_iface_modem_3gpp_update_5gs_registration_state (iface, nr,  TRUE);
+    mm_iface_modem_3gpp_apply_deferred_registration_state (iface);
+    mm_iface_modem_3gpp_update_access_technologies (iface, act);
+    if (ctx->have_ps && (eps == MM_MODEM_3GPP_REGISTRATION_STATE_HOME ||
+                         eps == MM_MODEM_3GPP_REGISTRATION_STATE_ROAMING))
+        mm_iface_modem_3gpp_update_location (iface, 0, ctx->ps.tac, ctx->ps.eci);
+    else if (ctx->have_cs && rat_is_lte (ctx->cs.rat))
+        mm_iface_modem_3gpp_update_location (iface, 0, ctx->cs.tac, ctx->cs.eci);
+    else if (ctx->have_cs)
+        mm_iface_modem_3gpp_update_location (iface, ctx->cs.lac, 0, ctx->cs.cell_id);
+
+    if (self->priv->ims)
+        mm_shannon_ims_network_update (self->priv->ims,
+                                       eps == MM_MODEM_3GPP_REGISTRATION_STATE_HOME ||
+                                       eps == MM_MODEM_3GPP_REGISTRATION_STATE_ROAMING ||
+                                       nr == MM_MODEM_3GPP_REGISTRATION_STATE_HOME ||
+                                       nr == MM_MODEM_3GPP_REGISTRATION_STATE_ROAMING);
+}
+
+static void
+ps_reg_ready (MMBroadbandModemShannon *self,
+              GAsyncResult            *res,
+              GTask                   *task)
+{
+    g_autoptr(GBytes)  payload = NULL;
+    g_autoptr(GError)  error = NULL;
+    RegContext        *ctx = g_task_get_task_data (task);
+
+    payload = SIT_FINISH (self, res, &error);
+    if (payload)
+        ctx->have_ps = mm_sit_parse_reg_state (payload, TRUE, &ctx->ps);
+    else
+        mm_obj_dbg (self, "PS registration query failed: %s", error->message);
+
+    if (!ctx->have_cs && !ctx->have_ps) {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                 "Couldn't query registration state");
+        g_object_unref (task);
+        return;
+    }
+    reg_apply (self, ctx);
+    g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+cs_reg_ready (MMBroadbandModemShannon *self,
+              GAsyncResult            *res,
+              GTask                   *task)
+{
+    g_autoptr(GBytes)  payload = NULL;
+    g_autoptr(GError)  error = NULL;
+    RegContext        *ctx = g_task_get_task_data (task);
+
+    payload = SIT_FINISH (self, res, &error);
+    if (payload)
+        ctx->have_cs = mm_sit_parse_reg_state (payload, FALSE, &ctx->cs);
+    else
+        mm_obj_dbg (self, "CS registration query failed: %s", error->message);
+    SIT_CMD (self, SIT_GET_PS_REG_STATE, NULL, 0, 10, ps_reg_ready, task);
+}
+
+static gboolean
+modem_3gpp_run_registration_checks_finish (MMIfaceModem3gpp  *self,
+                                           GAsyncResult      *res,
+                                           GError           **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void
+modem_3gpp_run_registration_checks (MMIfaceModem3gpp    *self,
+                                    gboolean             is_cs_supported,
+                                    gboolean             is_ps_supported,
+                                    gboolean             is_eps_supported,
+                                    gboolean             is_5gs_supported,
+                                    GAsyncReadyCallback  callback,
+                                    gpointer             user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    g_task_set_task_data (task, g_new0 (RegContext, 1), g_free);
+    SIT_CMD (self, SIT_GET_CS_REG_STATE, NULL, 0, 10, cs_reg_ready, task);
+}
+
+/* Registration is automatic on this CP; only make sure the selection mode
+ * is automatic. Manual selection is not implemented yet. */
+
+static void
+ntw_mode_auto_ready (MMBroadbandModemShannon *self,
+                     GAsyncResult            *res,
+                     GTask                   *task)
+{
+    g_autoptr(GBytes) payload = NULL;
+    GError           *error = NULL;
+
+    payload = SIT_FINISH (self, res, &error);
+    if (!payload)
+        g_task_return_error (task, error);
+    else
+        g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+ntw_mode_ready (MMBroadbandModemShannon *self,
+                GAsyncResult            *res,
+                GTask                   *task)
+{
+    g_autoptr(GBytes) payload = NULL;
+    g_autoptr(GError) error = NULL;
+    gsize             len = 0;
+    const guint8     *d = NULL;
+
+    payload = SIT_FINISH (self, res, &error);
+    if (payload)
+        d = g_bytes_get_data (payload, &len);
+    if (d && len >= 1 && d[0] == 0) {
+        g_task_return_boolean (task, TRUE);
+        g_object_unref (task);
+        return;
+    }
+    mm_obj_dbg (self, "network selection not automatic: switching to automatic");
+    SIT_CMD (self, SIT_SET_NTW_MODE_AUTO, NULL, 0, 60, ntw_mode_auto_ready, task);
+}
+
+static gboolean
+modem_3gpp_register_in_network_finish (MMIfaceModem3gpp  *self,
+                                       GAsyncResult      *res,
+                                       GError           **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void
+modem_3gpp_register_in_network (MMIfaceModem3gpp    *self,
+                                const gchar         *operator_id,
+                                GCancellable        *cancellable,
+                                GAsyncReadyCallback  callback,
+                                gpointer             user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, cancellable, callback, user_data);
+    if (operator_id && operator_id[0]) {
+        /* SET_NTW_MODE_MANUAL: u32 rat (0 = any) + plmn[6], '#'-padded */
+        guint8 req[10] = { 0, 0, 0, 0, '#', '#', '#', '#', '#', '#' };
+        gsize  n = MIN (strlen (operator_id), 6);
+
+        memcpy (req + 4, operator_id, n);
+        mm_obj_info (self, "manual network selection: %s", operator_id);
+        SIT_CMD (self, SIT_SET_NTW_MODE_MANUAL, req, sizeof (req), 120, ntw_mode_auto_ready, task);
+        return;
+    }
+    SIT_CMD (self, SIT_GET_NTW_MODE, NULL, 0, 10, ntw_mode_ready, task);
+}
+
+/* Network scan: GET_AVAILABLE_NETWORKS answers u32 count + 14-byte entries
+ * (u32 SIT rat, plmn[6], u32 status: 1 available, 2 current, 3 forbidden).
+ * A full scan takes ~1.5 min. */
+
+static GList *
+modem_3gpp_scan_networks_finish (MMIfaceModem3gpp  *self,
+                                 GAsyncResult      *res,
+                                 GError           **error)
+{
+    return g_task_propagate_pointer (G_TASK (res), error);
+}
+
+static void
+scan_ready (MMBroadbandModemShannon *self,
+            GAsyncResult            *res,
+            GTask                   *task)
+{
+    g_autoptr(GBytes) payload = NULL;
+    GError           *error = NULL;
+    const guint8     *d;
+    gsize             len;
+    guint32           count, i;
+    GList            *list = NULL;
+
+    payload = SIT_FINISH (self, res, &error);
+    if (!payload) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+    d = g_bytes_get_data (payload, &len);
+    count = len >= 4 ? (d[0] | (d[1] << 8) | (d[2] << 16) | ((guint32) d[3] << 24)) : 0;
+    for (i = 0; i < count && 4 + (gsize) (i + 1) * 14 <= len; i++) {
+        const guint8      *e = d + 4 + (gsize) i * 14;
+        MM3gppNetworkInfo *info;
+        guint32            status = e[10] | (e[11] << 8);
+
+        info = g_new0 (MM3gppNetworkInfo, 1);
+        info->operator_code = mm_sit_string_field (e + 4, 6);
+        if (!info->operator_code) {
+            g_free (info);
+            continue;
+        }
+        info->access_tech = mm_sit_rat_to_access_tech (e[0]);
+        info->status = (status == 2 ? MM_MODEM_3GPP_NETWORK_AVAILABILITY_CURRENT :
+                        status == 3 ? MM_MODEM_3GPP_NETWORK_AVAILABILITY_FORBIDDEN :
+                        status == 1 ? MM_MODEM_3GPP_NETWORK_AVAILABILITY_AVAILABLE :
+                                      MM_MODEM_3GPP_NETWORK_AVAILABILITY_UNKNOWN);
+        list = g_list_append (list, info);
+    }
+    g_task_return_pointer (task, list, (GDestroyNotify) mm_3gpp_network_info_list_free);
+    g_object_unref (task);
+}
+
+static void
+modem_3gpp_scan_networks (MMIfaceModem3gpp    *self,
+                          GAsyncReadyCallback  callback,
+                          gpointer             user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    SIT_CMD (self, SIT_GET_AVAILABLE_NETWORKS, NULL, 0, 300, scan_ready, task);
+}
+
+/* Operator */
+
+static gpointer
+decode_operator_code (MMBroadbandModemShannon *self, GBytes *payload, GError **error)
+{
+    gchar *plmn = NULL;
+
+    if (!mm_sit_parse_operator (payload, &plmn, NULL, NULL) || !plmn)
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_FAILED, "No operator code");
+    return plmn;
+}
+
+static gpointer
+decode_operator_name (MMBroadbandModemShannon *self, GBytes *payload, GError **error)
+{
+    gchar *short_name = NULL;
+    gchar *long_name = NULL;
+
+    if (!mm_sit_parse_operator (payload, NULL, &short_name, &long_name) || (!short_name && !long_name)) {
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_FAILED, "No operator name");
+        return NULL;
+    }
+    if (long_name) {
+        g_free (short_name);
+        return long_name;
+    }
+    return short_name;
+}
+
+static void
+modem_3gpp_load_operator_code (MMIfaceModem3gpp    *self,
+                               GAsyncReadyCallback  callback,
+                               gpointer             user_data)
+{
+    query (self, SIT_GET_OPERATOR, NULL, 0, decode_operator_code, callback, user_data);
+}
+
+static void
+modem_3gpp_load_operator_name (MMIfaceModem3gpp    *self,
+                               GAsyncReadyCallback  callback,
+                               gpointer             user_data)
+{
+    query (self, SIT_GET_OPERATOR, NULL, 0, decode_operator_name, callback, user_data);
+}
