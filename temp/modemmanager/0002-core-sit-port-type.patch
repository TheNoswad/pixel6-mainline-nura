             port_info.type = MM_MODEM_PORT_TYPE_IGNORED;
             break;
@@ -1522,6 +1551,7 @@ mm_base_modem_organize_ports (MMBaseModem *self,
     MMPortSerial *audio = NULL;
     MMPortSerialAt *data_at_primary = NULL;
     MMPort *xmmrpc = NULL;
+    MMPort *sit = NULL;
