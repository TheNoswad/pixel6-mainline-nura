@@ -1626,6 +1656,11 @@ mm_base_modem_organize_ports (MMBaseModem *self,
             if (!xmmrpc)
                 xmmrpc = MM_PORT (candidate);
             break;
+        case MM_PORT_TYPE_SIT:
+            g_assert (MM_IS_PORT (candidate));
+            if (!sit)
