@@ -240,6 +240,17 @@
  */
 #define ID_MM_PORT_TYPE_XMMRPC "ID_MM_PORT_TYPE_XMMRPC"
 
+/**
+ * ID_MM_PORT_TYPE_SIT:
+ *
+ * This is a port-specific tag applied to cpif character devices that we know
+ * in advance are SIT control ports of Samsung Shannon modems (local).
+ *
+ * This tag will also prevent other types of probing (e.g. AT, QMI) on the
+ * port.
+ */
+#define ID_MM_PORT_TYPE_SIT "ID_MM_PORT_TYPE_SIT"
+
 /**
  * ID_MM_TTY_BAUDRATE:
  *
