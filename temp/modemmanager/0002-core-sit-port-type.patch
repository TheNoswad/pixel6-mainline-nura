     if (!port) {
         g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_UNSUPPORTED,
@@ -1123,6 +1141,14 @@ mm_base_modem_get_port_primary (MMBaseModem *self)
     return (self->priv->primary ? g_object_ref (self->priv->primary) : NULL);
 }
 
