     vendor = mm_device_get_vendor (device);
     product = mm_device_get_product (device);
@@ -811,6 +817,15 @@ mm_plugin_supports_port (MMPlugin            *self,
         return;
     }
 
+    /* SIT ports are never probed: the udev tag says what they are */
