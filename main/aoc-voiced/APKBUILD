# Maintainer: Noswad <64293615+TheNoswad@users.noreply.github.com>
pkgname=aoc-voiced
pkgver=0.1
pkgrel=1
pkgdesc="Voice call PCMs for the Google AoC sound card during ModemManager calls"
url="https://postmarketos.org"
arch="aarch64"
license="GPL-3.0-or-later"
makedepends="alsa-lib-dev glib-dev"
subpackages="$pkgname-doc $pkgname-systemd"
source="
	aoc-voiced.c
	aoc-voiced.service
	README.md
	"
builddir="$srcdir"
options="!check" # no test suite

build() {
	${CC:-cc} $CFLAGS -Wall -Wextra -Wno-unused-parameter \
		-o aoc-voiced aoc-voiced.c \
		$(pkg-config --cflags --libs gio-2.0 gio-unix-2.0 alsa) $LDFLAGS
}

package() {
	install -Dm755 aoc-voiced -t "$pkgdir"/usr/bin/
	install -Dm644 README.md -t "$pkgdir"/usr/share/doc/$pkgname/
	install -Dm644 aoc-voiced.service -t "$pkgdir"/usr/lib/systemd/system/
}

systemd() {
	pkgdesc="$pkgdesc (systemd unit)"
	install_if="$pkgname=$pkgver-r$pkgrel systemd"
	amove usr/lib/systemd/system
}
