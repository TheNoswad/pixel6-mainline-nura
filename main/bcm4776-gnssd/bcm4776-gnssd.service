[Unit]
Description=GNSS for the Broadcom BCM4776 (on-chip fixes as NMEA)
Documentation=file:///usr/share/doc/bcm4776-gnssd/README.md
Requires=bcm4776-gnssd.socket
After=bcm4776-gnssd.socket
# same socket path
Conflicts=gnss-share.service

[Service]
ExecStart=/usr/bin/bcm4776-gnssd
Restart=on-failure
RestartSec=5
# root for /dev/ttyBCM, /dev/bbd_control (0600) and the nstandby sysfs
# attribute; no capabilities needed beyond file ownership
CapabilityBoundingSet=
NoNewPrivileges=yes
DevicePolicy=closed
DeviceAllow=/dev/ttyBCM rw
DeviceAllow=/dev/bbd_control w
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
Also=bcm4776-gnssd.socket
