# Maintainer: Noswad <64293615+TheNoswad@users.noreply.github.com>
pkgname=bcm4776-gnssd
pkgver=0.1
pkgrel=4
pkgdesc="GNSS daemon for the Broadcom BCM4776 (Pixel 6) without Broadcom userspace"
url="https://postmarketos.org"
arch="aarch64"
license="GPL-3.0-or-later"
# the socket is group geoclue, geoclue is the consumer
depends="geoclue"
subpackages="$pkgname-doc $pkgname-systemd $pkgname-waydroid:waydroid:noarch
	$pkgname-fwcut:fwcut:noarch"
source="
	bcm4776-gnssd.c
	bcm4776-gnssd.service
	bcm4776-gnssd.socket
	bcm4776-gnssd-waydroid.socket
	bcm4776-gnssd-waydroid.sysusers
	bcm4776-fwcut
	geoclue-bcm4776-gnssd.conf
	README.md
	"
builddir="$srcdir"
options="!check" # no test suite

build() {
	${CC:-cc} $CFLAGS -Wall -Wextra -Wno-unused-parameter \
		-o bcm4776-gnssd bcm4776-gnssd.c -lm $LDFLAGS
}

package() {
	install -Dm755 bcm4776-gnssd -t "$pkgdir"/usr/bin/
	install -Dm644 geoclue-bcm4776-gnssd.conf \
		"$pkgdir"/etc/geoclue/conf.d/90-bcm4776-gnssd.conf
	install -Dm644 README.md -t "$pkgdir"/usr/share/doc/$pkgname/
	install -Dm644 bcm4776-gnssd.service bcm4776-gnssd.socket \
		bcm4776-gnssd-waydroid.socket -t "$pkgdir"/usr/lib/systemd/system/
	install -Dm644 bcm4776-gnssd-waydroid.sysusers \
		"$pkgdir"/usr/lib/sysusers.d/bcm4776-gnssd-waydroid.conf
	install -Dm755 bcm4776-fwcut -t "$pkgdir"/usr/bin/
}

systemd() {
	pkgdesc="$pkgdesc (systemd units)"
	install_if="$pkgname=$pkgver-r$pkgrel systemd"
	amove usr/lib/systemd/system/bcm4776-gnssd.service \
		usr/lib/systemd/system/bcm4776-gnssd.socket
}

waydroid() {
	pkgdesc="$pkgdesc (NMEA socket for the Waydroid GNSS HAL)"
	install_if="$pkgname-systemd=$pkgver-r$pkgrel waydroid"
	# the HAL inside the container is built separately (android/gnss-hal)
	depends="$pkgname-systemd=$pkgver-r$pkgrel"
	amove usr/lib/systemd/system/bcm4776-gnssd-waydroid.socket \
		usr/lib/sysusers.d/bcm4776-gnssd-waydroid.conf
}

fwcut() {
	pkgdesc="Collect the BCM4776 firmware from a stock Pixel 6 vendor partition"
	depends="python3"
	amove usr/bin/bcm4776-fwcut
}
