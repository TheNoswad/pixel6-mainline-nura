[Unit]
Description=Pixel 6 sensor proxy (net.hadess.SensorProxy over the AoC sensor hub)
Wants=oriole-usf.service
After=oriole-usf.service dbus.service
Conflicts=iio-sensor-proxy.service

[Service]
Type=dbus
BusName=net.hadess.SensorProxy
ExecStart=/usr/libexec/oriole-sensorproxy
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
