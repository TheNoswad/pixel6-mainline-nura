# Pixel 6 (oriole) sensors: the AoC sensor hub (Google's USF framework)
# brought up from Linux, an iio-sensor-proxy compatible D-Bus service
# (light, accelerometer orientation, proximity, compass) and optional
# auto-brightness. Own implementation of the USF client protocol, see
# README.md. The sensor registry is the factory image's
# (firmware-google-oriole-sensors) plus this phone's factory calibration
# from its persist partition (/run/oriole/persist, device-google-oriole).
pkgname=oriole-sensors
pkgver=0.1
pkgrel=0
pkgdesc="Google Pixel 6 sensors (AoC USF) and auto-brightness"
url="https://postmarketos.org"
arch="noarch"
license="GPL-3.0-or-later"
depends="firmware-google-oriole-sensors python3 py3-gobject3"
options="!check"
source="
	oriole_usf.py
	oriole-usf-setup
	oriole-sensorproxy
	oriole-autobrightness
	reg-order
	oriole-usf.service
	oriole-sensorproxy.service
	oriole-autobrightness.service
	oriole-sensorproxy.dbus.conf
	iio-sensor-proxy.dropin.conf
	"

package() {
	install -Dm644 "$srcdir"/oriole_usf.py -t "$pkgdir"/usr/lib/oriole-sensors
	install -Dm755 -t "$pkgdir"/usr/libexec \
		"$srcdir"/oriole-usf-setup \
		"$srcdir"/oriole-sensorproxy \
		"$srcdir"/oriole-autobrightness
	install -Dm644 "$srcdir"/reg-order -t "$pkgdir"/usr/share/oriole-sensors
	install -Dm644 -t "$pkgdir"/usr/lib/systemd/system \
		"$srcdir"/oriole-usf.service \
		"$srcdir"/oriole-sensorproxy.service \
		"$srcdir"/oriole-autobrightness.service
	# sensors on by default, auto-brightness is opt-in:
	# systemctl enable --now oriole-autobrightness
	install -d "$pkgdir"/usr/lib/systemd/system/multi-user.target.wants
	ln -s ../oriole-usf.service ../oriole-sensorproxy.service \
		"$pkgdir"/usr/lib/systemd/system/multi-user.target.wants/
	install -Dm644 "$srcdir"/oriole-sensorproxy.dbus.conf \
		"$pkgdir"/usr/share/dbus-1/system.d/oriole-sensorproxy.conf
	install -Dm644 "$srcdir"/iio-sensor-proxy.dropin.conf \
		"$pkgdir"/usr/lib/systemd/system/iio-sensor-proxy.service.d/oriole-sensors.conf
}

