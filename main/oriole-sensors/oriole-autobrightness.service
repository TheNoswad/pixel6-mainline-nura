[Unit]
Description=Pixel 6 auto-brightness (ambient light from net.hadess.SensorProxy)
Wants=oriole-sensorproxy.service
After=oriole-sensorproxy.service

[Service]
ExecStart=/usr/libexec/oriole-autobrightness
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
