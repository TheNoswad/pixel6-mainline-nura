[Unit]
Description=Pixel 6 AoC sensor hub (USF): sensor rails, channel device, registry
After=systemd-udevd.service local-fs.target
RequiresMountsFor=/run/oriole/persist

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/oriole-usf-setup

[Install]
WantedBy=multi-user.target
