# SPDX-License-Identifier: GPL-3.0-or-later
# Pixel 6 efs partition, read-only (never written from Linux, see
# 61-oriole-stock-ro.rules in device-google-oriole).
[Unit]
Description=Pixel 6 efs partition (read-only)

[Mount]
What=/dev/disk/by-partlabel/efs
Where=/run/oriole/efs
Type=ext4
Options=ro,noload,nodev,nosuid,noexec
