# Pixel 6 (oriole) modem bring-up: boots the Shannon CP with tinycbd and
# serves its remote file system (rfsd). Everything the CP needs comes from
# the phone's own partitions, mounted read-only: modem_a (firmware,
# confpack), efs + modem_userdata (NV), persist (cpsha).
#
# tinycbd (github.com/m8l8th814n-eng/tinycbd) has no licence, so it is not
# copied here: it is fetched at build time and only our patch is in this
# repository. Do not redistribute the built package.
pkgname=oriole-modem
pkgver=0.1
pkgrel=0
_tinycbd=4040055106680fd695816c8a1b88e2c447309278
pkgdesc="Google Pixel 6 modem bring-up (tinycbd, rfsd)"
url="https://github.com/m8l8th814n-eng/tinycbd"
arch="aarch64"
license="GPL-3.0-or-later AND LicenseRef-tinycbd-no-licence"
depends="kmod modemmanager python3"
options="!check"
source="
	tinycbd-$_tinycbd.tar.gz::https://github.com/m8l8th814n-eng/tinycbd/archive/$_tinycbd.tar.gz
	0001-handover-imei-and-cpsha.patch
	oriole-rfsd
	oriole-modem-rfsd.service
	oriole-modem-cp.service
	oriole-modem.tmpfiles
	run-oriole-efs.mount
	run-oriole-modem.mount
	run-oriole-modem_userdata.mount
	shannon.conf
	"
builddir="$srcdir/tinycbd-$_tinycbd"

build() {
	make CC="${CC:-cc}" CFLAGS="$CFLAGS -Wall -Wextra" tinycbd
}

package() {
	install -Dm755 tinycbd -t "$pkgdir"/usr/bin
	install -Dm755 "$srcdir"/oriole-rfsd -t "$pkgdir"/usr/libexec
	install -Dm644 -t "$pkgdir"/usr/lib/systemd/system \
		"$srcdir"/oriole-modem-rfsd.service \
		"$srcdir"/oriole-modem-cp.service \
		"$srcdir"/run-oriole-efs.mount \
		"$srcdir"/run-oriole-modem.mount \
		"$srcdir"/run-oriole-modem_userdata.mount
	install -d "$pkgdir"/usr/lib/systemd/system/multi-user.target.wants
	ln -s ../oriole-modem-cp.service \
		"$pkgdir"/usr/lib/systemd/system/multi-user.target.wants/
	install -Dm644 "$srcdir"/oriole-modem.tmpfiles \
		"$pkgdir"/usr/lib/tmpfiles.d/oriole-modem.conf
	install -Dm644 "$srcdir"/shannon.conf -t "$pkgdir"/etc/ModemManager
}

