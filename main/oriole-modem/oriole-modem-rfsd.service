[Unit]
Description=Pixel 6 modem remote file system server (rfsd)
After=local-fs.target
RequiresMountsFor=/run/oriole/modem /run/oriole/efs

[Service]
# The GPU fails to power up (panfrost shader/L2 transition timeouts, no UI)
# if the CP is powered or powering up while panfrost first initialises, and
# loading cpif starts that. So: wait for panfrost to bind, let it settle,
# then load cpif and wait for its RFS device. (The underlying cause was
# fixed in linux-postmarketos-gs101 r22; this wait can go once that has
# enough clean boots.)
ExecStartPre=/bin/sh -c 'for i in $$(seq 60); do [ -e /sys/bus/platform/drivers/panfrost/1c500000.gpu ] && break; sleep 1; done; sleep 10'
ExecStartPre=modprobe cpif
ExecStartPre=/bin/sh -c 'for i in $$(seq 30); do [ -e /dev/umts_rfs0 ] && exit 0; sleep 1; done; exit 1'
ExecStart=/usr/libexec/oriole-rfsd
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
