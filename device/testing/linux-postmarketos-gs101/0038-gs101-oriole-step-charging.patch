From: Noswad <64293615+TheNoswad@users.noreply.github.com>
Subject: [PATCH] arm64: dts: exynos: gs101-oriole: battery info and step charging

Describe the oriole battery (4520 mAh, charge at most 3.0 A to 4.30 V)
as the charger's monitored battery, and add Google's temperature step
charging table from gs101-raviole-battery.dtsi.
---
diff --git a/arch/arm64/boot/dts/exynos/google/gs101-oriole-battery.dtsi b/arch/arm64/boot/dts/exynos/google/gs101-oriole-battery.dtsi
index f4926e3..a7bce94 100644
--- a/arch/arm64/boot/dts/exynos/google/gs101-oriole-battery.dtsi
+++ b/arch/arm64/boot/dts/exynos/google/gs101-oriole-battery.dtsi
@@ -6,6 +6,36 @@
  * Copyright 2020 Google LLC
  */
 
+/ {
+	battery: battery {
+		compatible = "simple-battery";
+		device-chemistry = "lithium-ion-polymer";
+		charge-full-design-microamp-hours = <4520000>;
+		constant-charge-current-max-microamp = <3000000>;
+		constant-charge-voltage-max-microvolt = <4300000>;
+	};
+};
+
+&max77759_pmic {
+	monitored-battery = <&battery>;
+
+	/*
+	 * Step charging by battery temperature, from Google's
+	 * gs101-raviole-battery.dtsi: bands in 0.1 C, tier float voltages,
+	 * and per band the current of each tier in % of capacity.
+	 */
+	google,chg-temp-limits = <0 100 200 420 460 480 550>;
+	google,chg-cv-limits = <4200000 4300000 4450000>;
+	google,chg-cc-limits = <
+		 30  10   0
+		 50  30  30
+		100  70  50
+		 80  50  50
+		 50  50   0
+		 30   0   0
+	>;
+};
+
 &fuel_gauge {
 	/* 06_p1_gen.ini, 2021-01-05, b/174788070, generic model */
 	model-generic {
