From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Noswad <64293615+TheNoswad@users.noreply.github.com>
Date: Mon, 12 Oct 2026 13:02:21 -0500
Subject: [PATCH] bcmdhd: restart the interface on HANG, dump RC MSI state

With WL_CFGVENDOR_SEND_HANG_EVENT the HANG only goes up as an Android
vendor event; without the Wi-Fi HAL nothing restarts Wi-Fi, so wlan0 stayed
"connected" on a dead dongle until a manual toggle. Under the new
DHD_HANG_IFACE_RESTART, dhd_hang_process() closes and reopens the primary
netdev itself (dhd_stop powers off, dhd_open reloads firmware; cfg80211
reports the disconnect, so NM/wpa_supplicant reconnect).

dhd_plat_pcie_register_dump() (memdump path) now prints the root complex
MSI receiver state via exynos_pcie_rc_print_msi_register().
---
 bcmdhd/Kbuild              |  2 ++
 bcmdhd/dhd_custom_google.c |  4 ++++
 bcmdhd/dhd_linux.c         | 22 ++++++++++++++++++++++
 3 files changed, 28 insertions(+)

diff --git a/bcmdhd/Kbuild b/bcmdhd/Kbuild
index 4d5333062..08aa0e720 100644
--- a/bcmdhd/Kbuild
+++ b/bcmdhd/Kbuild
@@ -435,6 +435,8 @@ DHDCFLAGS += -DRSSI_MONITOR_SUPPORT
 DHDCFLAGS += -DSET_SSID_FAIL_CUSTOM_RC=100
 DHDCFLAGS += -DDHD_EVENT_LOG_FILTER
 DHDCFLAGS += -DWL_CFGVENDOR_SEND_HANG_EVENT
+# No Android Wi-Fi HAL: restart the interface on HANG in the driver
+DHDCFLAGS += -DDHD_HANG_IFACE_RESTART
 # Packet
 DHDCFLAGS += -DBLOCK_IPV6_PACKET
 #DHDCFLAGS += -DDHD_DONOT_FORWARD_BCMEVENT_AS_NETWORK_PKT # NAN test failure
diff --git a/bcmdhd/dhd_custom_google.c b/bcmdhd/dhd_custom_google.c
index 29f42c26f..9323d7b43 100644
--- a/bcmdhd/dhd_custom_google.c
+++ b/bcmdhd/dhd_custom_google.c
@@ -1019,8 +1019,12 @@ void dhd_plat_pin_dbg_show(void *plat_info)
 #endif /* PRINT_WAKEUP_GPIO_STATUS */
 }
 
+/* pcie-gs101: root complex MSI receiver state (lost MSI debugging) */
+extern void exynos_pcie_rc_print_msi_register(int ch_num);
+
 void dhd_plat_pcie_register_dump(void *plat_info)
 {
+	exynos_pcie_rc_print_msi_register(pcie_ch_num);
 #ifdef EXYNOS_PCIE_DEBUG
 	exynos_pcie_register_dump(1);
 #endif /* EXYNOS_PCIE_DEBUG */
diff --git a/bcmdhd/dhd_linux.c b/bcmdhd/dhd_linux.c
index d69637002..4a4cf03d4 100644
--- a/bcmdhd/dhd_linux.c
+++ b/bcmdhd/dhd_linux.c
@@ -17488,6 +17488,28 @@ static void dhd_hang_process(struct work_struct *work_data)
 	wl_cfg80211_hang(dev, WLAN_REASON_UNSPECIFIED);
 #endif
 
+#ifdef DHD_HANG_IFACE_RESTART
+	/*
+	 * The HANG goes up as an Android vendor event that only the Wi-Fi HAL
+	 * acts on; on a regular Linux system nobody listens and the interface
+	 * stays "connected" on a dead dongle. Restart it here as the HAL would:
+	 * dhd_stop() powers the dongle off (the HANG set force_reg_on), and
+	 * dhd_open() reloads the firmware. cfg80211 reports the disconnect on
+	 * the way down, so wpa_supplicant and NetworkManager reconnect.
+	 */
+	rtnl_lock();
+	if (dev->flags & IFF_UP) {
+		int err;
+
+		DHD_ERROR(("%s: restarting %s after HANG\n", __FUNCTION__, dev->name));
+		dev_close(dev);
+		err = dev_open(dev, NULL);
+		if (err)
+			DHD_ERROR(("%s: %s reopen failed: %d\n", __FUNCTION__, dev->name, err));
+	}
+	rtnl_unlock();
+#endif /* DHD_HANG_IFACE_RESTART */
+
 #ifdef IFACE_HANG_FORCE_DEV_CLOSE
 	/*
 	 * In case of wif scan only mode, upper layer doesn't handle hang
