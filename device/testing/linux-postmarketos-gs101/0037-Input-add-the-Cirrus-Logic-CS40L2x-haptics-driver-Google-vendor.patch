+	ret = of_property_read_u32(np, "cirrus,f0-default", &out_val);
+	if (!ret)
+		pdata->f0_default = out_val;
+
+	ret = of_property_read_u32(np, "cirrus,f0-min", &out_val);
+	if (!ret)
+		pdata->f0_min = out_val;
+
+	ret = of_property_read_u32(np, "cirrus,f0-max", &out_val);
