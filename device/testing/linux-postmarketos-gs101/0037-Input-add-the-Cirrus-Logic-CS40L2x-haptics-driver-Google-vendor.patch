diff --git a/drivers/input/misc/cs40l2x/Kconfig b/drivers/input/misc/cs40l2x/Kconfig
new file mode 100644
index 000000000..e99335cfd
--- /dev/null
+++ b/drivers/input/misc/cs40l2x/Kconfig
@@ -0,0 +1,15 @@
+# SPDX-License-Identifier: GPL-2.0-only
+config INPUT_CS40L2X
+	tristate "Cirrus Logic CS40L2x haptics (Google Pixel vendor driver)"
+	depends on I2C && OF
+	select REGMAP_I2C
+	help
+	  Haptics driver for the Cirrus Logic CS40L20/25 found in the Google
+	  Pixel 6, from Google's amplifiers kernel module (android-gs-raviole
+	  6.1), ported to this kernel. It provides an input force-feedback
+	  device (FF_RUMBLE/FF_PERIODIC) and the calibration attributes
+	  (f0_stored, redc_stored, q_stored) the factory calibration is
+	  loaded through.
+
+	  To compile this driver as a module, choose M here: the module will
+	  be called haptics-cs40l2x.
diff --git a/drivers/input/misc/cs40l2x/Makefile b/drivers/input/misc/cs40l2x/Makefile
new file mode 100644
index 000000000..48ad17984
--- /dev/null
+++ b/drivers/input/misc/cs40l2x/Makefile
@@ -0,0 +1,4 @@
+# SPDX-License-Identifier: GPL-2.0-only
+obj-$(CONFIG_INPUT_CS40L2X) += haptics-cs40l2x.o
+haptics-cs40l2x-y := cs40l2x.o cs40l2x-tables.o
+ccflags-y += -I$(src)/include -DCONFIG_HAPTICS_CS40L2X_INPUT
