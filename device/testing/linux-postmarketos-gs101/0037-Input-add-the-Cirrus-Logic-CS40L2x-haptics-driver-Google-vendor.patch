+	pdata->boost_ipk = out_val;
+
+	ret = of_property_read_u32(np, "cirrus,boost-ctl-millivolt", &out_val);
+	if (!ret)
+		pdata->boost_ctl = out_val | CS40L2X_PDATA_PRESENT;
