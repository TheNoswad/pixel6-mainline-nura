+	int ret;
+	unsigned int dig_scale;
+
+	ret = kstrtou32(buf, 10, &dig_scale);
+	if (ret)
+		return -EINVAL;
+
+	if (dig_scale > CS40L2X_DIG_SCALE_MAX)
+		return -EINVAL;
+
+	pm_runtime_get_sync(cs40l2x->dev);
