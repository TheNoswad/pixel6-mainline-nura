+	cs40l2x->wt_ym_size = (CS40L2X_WT_YM_PRE_HDR_BYTES +
+		CS40L2X_WT_DBLK_LENGTH_SIZE +
+		(CS40L2X_WT_HEADER_ENTRY_SIZE *
+		CS40L2X_WT_NUM_VIRT_SLOTS) +
+		CS40L2X_WT_TERMINATOR_BYTES +
+		cs40l2x->comp_bytes);
+}
