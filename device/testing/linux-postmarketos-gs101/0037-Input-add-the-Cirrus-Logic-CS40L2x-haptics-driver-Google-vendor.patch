+	/*
+	 * this operation calls cs40l2x_wseq_replace which checks the variable
+	 * firmware ID and must therefore be performed within mutex protection
+	 */
+	ret = cs40l2x_dig_scale_set(cs40l2x, dig_scale);
+	if (ret)
+		goto err_mutex;
+
+	ret = count;
