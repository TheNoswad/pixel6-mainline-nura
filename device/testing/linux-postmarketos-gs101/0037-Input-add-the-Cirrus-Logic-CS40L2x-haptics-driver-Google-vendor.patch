+	int ret = 0, i, index;
+
+	mutex_lock(&cs40l2x->lock);
+
+	index = cs40l2x->dynamic_f0_index;
+
+	for (i = 0; i < CS40l2X_F0_MAX_ENTRIES; i++)
+		if (index == cs40l2x->dynamic_f0[i].index)
+			break;
+
+	if (i == CS40l2X_F0_MAX_ENTRIES) {
+		dev_err(dev, "Cannot find f0 index %d\n", index);
+		ret = -EINVAL;
+		goto err_mutex;
+	}
