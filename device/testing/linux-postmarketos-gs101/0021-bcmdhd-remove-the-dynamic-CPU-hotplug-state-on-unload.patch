From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Noswad <64293615+TheNoswad@users.noreply.github.com>
Date: Fri, 9 Oct 2026 14:18:35 -0500
Subject: [PATCH] bcmdhd: remove the dynamic CPU hotplug state on unload

dhd_register_cpuhp_callback() gets a dynamic state number back from
cpuhp_setup_state(CPUHP_AP_ONLINE_DYN, "dhd", ...) but dropped it, and
dhd_unregister_cpuhp_callback() then removed CPUHP_AP_ONLINE_DYN itself,
which removes nothing. Every rmmod (the oriole sleep hook unloads bcmdhd)
left the "dhd" callbacks pointing into freed module memory: the next CPU
offline/online, e.g. freeze_secondary_cpus() in deep suspend, oopsed in
cpuhp/N and the suspend hung waiting for it.
---
 bcmdhd/dhd_linux_lb.c | 17 ++++++++++++++++-
 1 file changed, 16 insertions(+), 1 deletion(-)

diff --git a/bcmdhd/dhd_linux_lb.c b/bcmdhd/dhd_linux_lb.c
index 04d2c5573..01458c1ad 100644
--- a/bcmdhd/dhd_linux_lb.c
+++ b/bcmdhd/dhd_linux_lb.c
@@ -323,6 +323,16 @@ dhd_cpu_callback(struct notifier_block *nfb, unsigned long action, void *hcpu)
 }
 #endif /* LINUX_VERSION_CODE < 4.10.0 */
 
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(4, 10, 0))
+/*
+ * Local: CPUHP_AP_ONLINE_DYN hands out a dynamic state number. Remember it:
+ * removing CPUHP_AP_ONLINE_DYN itself removes nothing, so every rmmod left
+ * the "dhd" hotplug callbacks pointing into the freed module and the next
+ * CPU offline/online (e.g. system suspend) oopsed in cpuhp/N.
+ */
+static int dhd_cpuhp_state = -1;
+#endif
+
 int dhd_register_cpuhp_callback(dhd_info_t *dhd)
 {
 	int cpuhp_ret = 0;
@@ -333,6 +343,8 @@ int dhd_register_cpuhp_callback(dhd_info_t *dhd)
 	if (cpuhp_ret < 0) {
 		DHD_ERROR(("%s(): cpuhp_setup_state failed %d RX LB won't happen \r\n",
 			__FUNCTION__, cpuhp_ret));
+	} else {
+		dhd_cpuhp_state = cpuhp_ret;
 	}
 #else
 	/*
@@ -351,7 +363,10 @@ int dhd_unregister_cpuhp_callback(dhd_info_t *dhd)
 	int ret = 0;
 #if (LINUX_VERSION_CODE >= KERNEL_VERSION(4, 10, 0))
 	/* Don't want to call tear down while unregistering */
-	cpuhp_remove_state_nocalls(CPUHP_AP_ONLINE_DYN);
+	if (dhd_cpuhp_state >= 0) {
+		cpuhp_remove_state_nocalls(dhd_cpuhp_state);
+		dhd_cpuhp_state = -1;
+	}
 #else
 	if (dhd->cpu_notifier.notifier_call != NULL) {
 		unregister_cpu_notifier(&dhd->cpu_notifier);
