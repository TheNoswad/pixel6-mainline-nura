From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Noswad <64293615+TheNoswad@users.noreply.github.com>
Date: Sun, 11 Oct 2026 17:40:01 -0500
Subject: [PATCH] gps: bcm47765: fix unbind and probe-failure teardown

bcm_spi_remove() passed the SPI device to bbd_exit(), which took its
drvdata as the bbd_device. That is the bcm_spi_priv, so unbinding
destroyed a garbage class pointer and kvfree()d devm memory. It also
left /dev/ttyBCM registered with the module's fops, never dropped the
bbd PM notifier, unregistered the bbd chrdev region one minor at a time
with minors outside the block allocated in bbd_init(), and never freed
the four legacy GPIOs, so a second probe failed.

Pass the bbd_device itself, unregister the PM notifier and the whole
chrdev region, deregister the misc device, take the GPIOs with
devm_gpio_request_one(), and unwind misc/sscd/bbd on probe failure.
bbd_init() also tested the parent device instead of device_create()'s
result. rmmod/insmod cycles cleanly now.
---
 gps/bbd.c         | 21 +++++++++++++--------
 gps/bbd.h         |  2 +-
 gps/bcm_gps_spi.c | 25 +++++++++++++++++--------
 3 files changed, 31 insertions(+), 17 deletions(-)

diff --git a/gps/bbd.c b/gps/bbd.c
index 5f89cb254..90f11e78c 100644
--- a/gps/bbd.c
+++ b/gps/bbd.c
@@ -745,7 +745,7 @@ struct bbd_device *bbd_init(struct device *dev, bool legacy_patch)
 	bbd->class = class_create("bbd");
 	if (IS_ERR(bbd->class)) {
 		pr_err("failed to create class bbd\n");
-		goto exit;
+		goto free_region;
 	}
 
 	/* Create BBD char devices */
@@ -781,17 +781,16 @@ struct bbd_device *bbd_init(struct device *dev, bool legacy_patch)
 		if (ret) {
 			pr_err("failed to cdev_add() \"%s\", ret=%d",
 					 bbd_dev_name[minor], ret);
-			unregister_chrdev_region(bbd_cdev->devno, 1);
 			goto free_class;
 		}
 
 		/* Let it show in FS */
 		bbd_cdev->dev = device_create(bbd->class, NULL,
 				bbd_cdev->devno, bbd, "%s", bbd_dev_name[minor]);
-		if (IS_ERR_OR_NULL(dev)) {
+		if (IS_ERR(bbd_cdev->dev)) {
+			ret = PTR_ERR(bbd_cdev->dev);
 			pr_err("failed to device_create() \"%s\", ret = %d",
 					bbd_dev_name[minor], ret);
-			unregister_chrdev_region(bbd_cdev->devno, 1);
 			cdev_del(&bbd_cdev->cdev);
 			goto free_class;
 		}
@@ -838,9 +837,10 @@ struct bbd_device *bbd_init(struct device *dev, bool legacy_patch)
 
 		device_destroy(bbd->class, devno);
 		cdev_del(cdev);
-		unregister_chrdev_region(devno, 1);
 	}
 	class_destroy(bbd->class);
+free_region:
+	unregister_chrdev_region(bbd->dev_num, BBD_DEVICE_INDEX);
 exit:
 	kvfree(bbd);
 	return NULL;
@@ -848,27 +848,32 @@ struct bbd_device *bbd_init(struct device *dev, bool legacy_patch)
 
 EXPORT_SYMBOL_GPL(bbd_init);
 
-void bbd_exit(struct device *dev)
+void bbd_exit(struct bbd_device *bbd)
 {
-	struct bbd_device *bbd = dev_get_drvdata(dev);
 	int minor;
 
+	if (!bbd)
+		return;
+
 #if IS_ENABLED(CONFIG_SENSORS_SSP)
 	/* Shutdown SSP first*/
 	pssp_driver->shutdown(&dummy_spi);
 #endif
 
+	unregister_pm_notifier(&bbd->notifier);
+
 	/* Remove BBD char devices */
 	for (minor = BBD_MINOR_SENSOR; minor < BBD_DEVICE_INDEX; minor++) {
 		struct bbd_cdev_priv *bbd_cdev = &bbd->priv[minor];
 
 		device_destroy(bbd->class, bbd_cdev->devno);
 		cdev_del(&bbd_cdev->cdev);
-		unregister_chrdev_region(bbd_cdev->devno, 1);
 
 		pr_info("(%d,%d) unregistered /dev/%s\n",
 				MAJOR(bbd->dev_num), minor, bbd_dev_name[minor]);
 	}
+	/* One region, allocated as a block in bbd_init() */
+	unregister_chrdev_region(bbd->dev_num, BBD_DEVICE_INDEX);
 
 #ifdef DEBUG_1HZ_STAT
 	bbd_exit_stat(bbd);
diff --git a/gps/bbd.h b/gps/bbd.h
index f0ffed63e..706935510 100644
--- a/gps/bbd.h
+++ b/gps/bbd.h
@@ -197,7 +197,7 @@ struct bbd_callbacks {
 extern void	bbd_register(void *ext_data, struct bbd_callbacks *pcallbacks);
 extern int	bbd_mcu_reset(void);
 extern struct bbd_device *bbd_init(struct device *dev, bool legacy_patch);
-extern void bbd_exit(struct device *dev);
+extern void bbd_exit(struct bbd_device *bbd);
 extern void bcm_ssi_debug(struct device *dev, int type, bool value);
 
 #endif /* __BBD_H__ */
diff --git a/gps/bcm_gps_spi.c b/gps/bcm_gps_spi.c
index 39c54fa1e..371832f50 100644
--- a/gps/bcm_gps_spi.c
+++ b/gps/bcm_gps_spi.c
@@ -1377,7 +1377,7 @@ static int bcm_spi_probe(struct spi_device *spi)
 	}
 
 	/* Check IRQ# */
-	ret = gpio_request(host_req, "HOST REQ");
+	ret = devm_gpio_request_one(&spi->dev, host_req, GPIOF_IN, "HOST REQ");
 	if (ret) {
 		dev_err(&spi->dev, "failed to request HOST REQ, ret:%d", ret);
 		goto err_exit;
@@ -1390,7 +1390,7 @@ static int bcm_spi_probe(struct spi_device *spi)
 	}
 
 	/* Config GPIO */
-	ret = gpio_request(mcu_req, "MCU REQ");
+	ret = devm_gpio_request_one(&spi->dev, mcu_req, GPIOF_IN, "MCU REQ");
 	if (ret) {
 		dev_err(&spi->dev, "failed to request MCU REQ, ret:%d", ret);
 		goto err_exit;
@@ -1401,7 +1401,7 @@ static int bcm_spi_probe(struct spi_device *spi)
 				ret);
 		goto err_exit;
 	}
-	ret = gpio_request(mcu_resp, "MCU RESP");
+	ret = devm_gpio_request_one(&spi->dev, mcu_resp, GPIOF_IN, "MCU RESP");
 	if (ret) {
 		dev_err(&spi->dev, "failed to request MCU RESP, ret:%d", ret);
 		goto err_exit;
@@ -1413,7 +1413,7 @@ static int bcm_spi_probe(struct spi_device *spi)
 		goto err_exit;
 	}
 
-	ret = gpio_request(nstandby, "GPS NSTANDBY");
+	ret = devm_gpio_request_one(&spi->dev, nstandby, GPIOF_IN, "GPS NSTANDBY");
 	if (ret) {
 		dev_err(&spi->dev, "failed to request GPS NSTANDBY, ret:%d", ret);
 		goto err_exit;
@@ -1428,7 +1428,7 @@ static int bcm_spi_probe(struct spi_device *spi)
 	/* enable gps_power */
 	gps_power = of_get_named_gpio(spi->dev.of_node, "gps-power-enable", 0);
 	if (gps_power >= 0) {
-		ret = gpio_request(gps_power, "GPS POWER");
+		ret = devm_gpio_request_one(&spi->dev, gps_power, GPIOF_IN, "GPS POWER");
 		if (ret) {
 			dev_err(&spi->dev, "failed to request GPS POWER, ret:%d", ret);
 			goto err_exit;
@@ -1525,7 +1525,7 @@ static int bcm_spi_probe(struct spi_device *spi)
 	/* Init BBD & SSP */
 	priv->bbd = bbd_init(&spi->dev, legacy_patch);
 	if (priv->bbd == NULL)
-		goto free_wq;
+		goto free_misc;
 
 	if (device_create_file(&priv->spi->dev, &dev_attr_nstandby))
 		dev_err(&spi->dev, "Unable to create sysfs 4775 nstandby entry");
@@ -1539,7 +1539,7 @@ static int bcm_spi_probe(struct spi_device *spi)
 	if (ret) {
 		dev_err(&spi->dev, "Failed to register BCM477x SPI TTY IRQ %d.\n",
 				spi->irq);
-		goto free_wq;
+		goto free_bbd;
 	}
 
 	dev_info(&spi->dev, "Probe OK. ssp-host-req=%d, irq=%d, priv=0x%pK\n",
@@ -1547,6 +1547,14 @@ static int bcm_spi_probe(struct spi_device *spi)
 
 	return 0;
 
+free_bbd:
+	device_remove_file(&spi->dev, &dev_attr_nstandby);
+	device_remove_file(&spi->dev, &dev_attr_sspmcureq);
+	bbd_exit(priv->bbd);
+free_misc:
+	device_remove_file(&spi->dev, &dev_attr_coredump);
+	platform_device_unregister(&priv->sscd_dev);
+	misc_deregister(&priv->misc);
 free_wq:
 	if (priv->serial_wq)
 		destroy_workqueue(priv->serial_wq);
@@ -1578,7 +1586,8 @@ static void bcm_spi_remove(struct spi_device *spi)
 	}
 
 	/* Free everything */
-	bbd_exit(&spi->dev);
+	misc_deregister(&priv->misc);
+	bbd_exit(priv->bbd);
 
 	/* Clean ssr dump driver */
 	platform_device_unregister(&priv->sscd_dev);
