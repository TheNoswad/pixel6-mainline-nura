From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Noswad <64293615+TheNoswad@users.noreply.github.com>
Date: Thu, 8 Oct 2026 15:31:59 -0500
Subject: [PATCH] soc: samsung: exynos-pmu: keep C2 hint in suspend-to-idle

suspend_noirq set sys_insuspend for every system sleep, so the CPU PM
notifier skipped the ACPM C2 hint during s2idle too. CPU_SUSPEND then
returned immediately: ~1.5M s2idle entries per CPU in 30 s with no
interrupts. Only skip the hint for deep suspend.
---
 drivers/soc/samsung/exynos-pmu.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/drivers/soc/samsung/exynos-pmu.c b/drivers/soc/samsung/exynos-pmu.c
index d58376c38..3a91b0b04 100644
--- a/drivers/soc/samsung/exynos-pmu.c
+++ b/drivers/soc/samsung/exynos-pmu.c
@@ -18,6 +18,7 @@
 #include <linux/delay.h>
 #include <linux/reboot.h>
 #include <linux/regmap.h>
+#include <linux/suspend.h>
 
 #include <linux/soc/samsung/exynos-regs-pmu.h>
 #include <linux/soc/samsung/exynos-pmu.h>
@@ -556,6 +557,14 @@ static int exynos_pmu_probe(struct platform_device *pdev)
 
 static int exynos_cpupm_suspend_noirq(struct device *dev)
 {
+	/*
+	 * In suspend-to-idle the CPUs still sleep through cpuidle, so keep
+	 * doing the ACPM C2 hint. Without it CPU_SUSPEND returns at once
+	 * and the s2idle loop spins.
+	 */
+	if (pm_suspend_target_state == PM_SUSPEND_TO_IDLE)
+		return 0;
+
 	raw_spin_lock(&pmu_context->cpupm_lock);
 	pmu_context->sys_insuspend = true;
 	raw_spin_unlock(&pmu_context->cpupm_lock);
