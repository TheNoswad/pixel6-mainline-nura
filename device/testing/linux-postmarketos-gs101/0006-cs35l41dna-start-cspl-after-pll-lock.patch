From: Noswad <64293615+TheNoswad@users.noreply.github.com>
Subject: [PATCH] cs35l41dna: start CSPL after the PLL locks

The halo DSP is clocked from the TDM SCLK through the PLL. On gs101 the AoC
starts TDM_0 only at PCM trigger, after DAPM power-up, so the CSPL
REINIT/RESUME sent from the DSP widget's POST_PMU event reached an
unclocked DSP: it was not acknowledged within the driver's 5 ms, the
algorithm did not start, and after a few streams the CSPL mailbox read
back 0xffffffff and the amp stayed muted.

Queue the start command on the driver workqueue instead, wait up to
200 ms for PLL_LOCK in IRQ1_RAW_STATUS3, then send it. Cancel a pending
start at Main AMP POST_PMD. Allow REINIT up to 100 ms to be acknowledged
and log commands that needed longer than 5 ms.

Local only, not for upstream submission.
---
diff -ru a/cs35l41dna/cs35l41.c b/cs35l41dna/cs35l41.c
--- a/cs35l41dna/cs35l41.c	2026-10-08 19:29:21.428553582 -0500
+++ b/cs35l41dna/cs35l41.c	2026-10-08 19:29:21.429402406 -0500
@@ -262,6 +262,59 @@
 	return 0;
 }
 
+/*
+ * Local (oriole): the halo DSP is clocked from the TDM SCLK via the PLL. On
+ * gs101 the AoC starts TDM_0 only at PCM trigger, after DAPM power-up, so a
+ * CSPL command sent from the POST_PMU event reaches an unclocked DSP: REINIT
+ * (which applies the calibration) is never acknowledged and the CSPL
+ * mailbox later reads back invalid. Wait for PLL lock in a work item and
+ * start CSPL from there.
+ */
+#define CS35L41_CSPL_PLL_WAIT_MS	200
+
+static void cs35l41_mbox_start_work(struct work_struct *work)
+{
+	struct cs35l41_private *cs35l41 =
+		container_of(work, struct cs35l41_private, mbox_start_work);
+	enum cs35l41_cspl_mbox_cmd mboxcmd;
+	unsigned int fw_status, raw = 0;
+	int i, ret;
+
+	for (i = 0; i < CS35L41_CSPL_PLL_WAIT_MS; i++) {
+		regmap_read(cs35l41->regmap, CS35L41_IRQ1_RAW_STATUS3, &raw);
+		if (raw & CS35L41_PLL_LOCK)
+			break;
+		usleep_range(1000, 1100);
+	}
+	if (!(raw & CS35L41_PLL_LOCK)) {
+		dev_warn(cs35l41->dev,
+			 "PLL not locked after %d ms (raw3 %#x), CSPL not started\n",
+			 CS35L41_CSPL_PLL_WAIT_MS, raw);
+		return;
+	}
+
+	regmap_read(cs35l41->regmap, CS35L41_DSP_MBOX_2, &fw_status);
+	switch (fw_status) {
+	case CSPL_MBOX_STS_RDY_FOR_REINIT:
+		mboxcmd = CSPL_MBOX_CMD_REINIT;
+		break;
+	case CSPL_MBOX_STS_PAUSED:
+	case CSPL_MBOX_STS_RUNNING:
+		/* RUNNING: first playback after the firmware booted */
+		mboxcmd = CSPL_MBOX_CMD_RESUME;
+		break;
+	default:
+		dev_err(cs35l41->dev, "Firmware status is invalid(%u)\n",
+			fw_status);
+		return;
+	}
+
+	ret = cs35l41_set_cspl_mbox_cmd(cs35l41, mboxcmd);
+	dev_info(cs35l41->dev,
+		 "CSPL start: PLL locked after %d ms, status %u, cmd %d, ret %d\n",
+		 i, fw_status, mboxcmd, ret);
+}
+
 static int cs35l41_dsp_load_ev(struct snd_soc_dapm_widget *w,
 		       struct snd_kcontrol *kcontrol, int event)
 {
@@ -269,9 +322,6 @@
 		snd_soc_dapm_to_component(w->dapm);
 	struct cs35l41_private *cs35l41 =
 		snd_soc_component_get_drvdata(component);
-	enum cs35l41_cspl_mbox_cmd mboxcmd = CSPL_MBOX_CMD_NONE;
-	enum cs35l41_cspl_mbox_status fw_status = CSPL_MBOX_STS_RUNNING;
-	int ret = 0;
 
 	switch (event) {
 	case SND_SOC_DAPM_POST_PMU:
@@ -280,33 +330,8 @@
 			cs35l41->halo_booted = true;
 		}
 
-		if (cs35l41->dsp.cs_dsp.running) {
-			regmap_read(cs35l41->regmap, CS35L41_DSP_MBOX_2,
-				    (unsigned int *)&fw_status);
-			switch (fw_status) {
-			case CSPL_MBOX_STS_RDY_FOR_REINIT:
-				mboxcmd = CSPL_MBOX_CMD_REINIT;
-				break;
-			case CSPL_MBOX_STS_PAUSED:
-				mboxcmd = CSPL_MBOX_CMD_RESUME;
-				break;
-			case CSPL_MBOX_STS_RUNNING:
-				/*
-				 * First time playing audio
-				 * means fw_status is running
-				 */
-				mboxcmd = CSPL_MBOX_CMD_RESUME;
-				break;
-			default:
-				dev_err(cs35l41->dev,
-					"Firmware status is invalid(%u)\n",
-					fw_status);
-				break;
-			}
-			ret = cs35l41_set_cspl_mbox_cmd(cs35l41, mboxcmd);
-			dev_dbg(cs35l41->dev, "Set MBOX command: %d ret: %d\n",
-				mboxcmd, ret);
-		}
+		if (cs35l41->dsp.cs_dsp.running)
+			queue_work(cs35l41->wq, &cs35l41->mbox_start_work);
 		cs35l41->enabled = true;
 		break;
 	default:
@@ -1023,14 +1048,21 @@
 				   enum cs35l41_cspl_mbox_cmd cmd)
 {
 	int ret = 0;
-	unsigned int sts, i;
+	unsigned int sts, i, tries;
 	bool status_ok = false;
 
 	// Set mailbox cmd
 	regmap_write(cs35l41->regmap, CS35L41_DSP_VIRT1_MBOX_1, cmd);
 
+	/*
+	 * Local (oriole): REINIT (applies new tuning/calibration) takes longer
+	 * than 5 ms to be acknowledged; it is sent from mbox_start_work, so
+	 * waiting is fine there.
+	 */
+	tries = (cmd == CSPL_MBOX_CMD_REINIT) ? 100 : 5;
+
 	// Read mailbox status and verify it is appropriate for the given cmd
-	for (i = 0; i < 5; i++) {
+	for (i = 0; i < tries; i++) {
 		usleep_range(1000, 1100);
 		ret = regmap_read(cs35l41->regmap, CS35L41_DSP_MBOX_2, &sts);
 		if (ret < 0) {
@@ -1051,6 +1083,10 @@
 		}
 	}
 
+	if (status_ok && i >= 5)
+		dev_info(cs35l41->dev, "mailbox cmd %u acked after %u ms\n",
+			 cmd, i + 1);
+
 	if (!status_ok) {
 		dev_err(cs35l41->dev,
 			"Failed to set mailbox cmd %u (status %u)\n",
@@ -2303,6 +2339,7 @@
 				   &cs35l41->vol_ctl.ramp_work);
 		break;
 	case SND_SOC_DAPM_POST_PMD:
+		cancel_work_sync(&cs35l41->mbox_start_work);
 		if (cs35l41->dsp.cs_dsp.running) {
 			if (cs35l41->reload_tuning) {
 				mboxcmd = CSPL_MBOX_CMD_STOP_PRE_REINIT;
@@ -4444,6 +4481,7 @@
 	}
 
 	INIT_DELAYED_WORK(&cs35l41->hb_work, cs35l41_hibernate_work);
+	INIT_WORK(&cs35l41->mbox_start_work, cs35l41_mbox_start_work);
 	mutex_init(&cs35l41->hb_lock);
 	mutex_init(&cs35l41->hb_forcewake_lock);
 	return 0;
@@ -4476,6 +4514,7 @@
 #if IS_ENABLED(CONFIG_SND_SOC_CODEC_DETECT)
 	cs35l41_misc_exit(cs35l41);
 #endif
+	cancel_work_sync(&cs35l41->mbox_start_work);
 	destroy_workqueue(cs35l41->wq);
 	mutex_destroy(&cs35l41->hb_lock);
 	mutex_destroy(&cs35l41->hb_forcewake_lock);
diff -ru a/cs35l41dna/include/sound/cs35l41-private.h b/cs35l41dna/include/sound/cs35l41-private.h
--- a/cs35l41dna/include/sound/cs35l41-private.h	2026-10-08 19:29:21.430214885 -0500
+++ b/cs35l41dna/include/sound/cs35l41-private.h	2026-10-08 19:29:21.430958755 -0500
@@ -124,6 +124,7 @@
 	struct soc_enum fast_switch_enum;
 	const char **fast_switch_names;
 	struct delayed_work hb_work;
+	struct work_struct mbox_start_work;
 	struct workqueue_struct *wq;
 	struct mutex hb_lock;
 	struct mutex hb_forcewake_lock;
