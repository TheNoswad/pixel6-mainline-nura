From: Noswad <64293615+TheNoswad@users.noreply.github.com>
Subject: [PATCH] gs101: GPU DVFS through the ACPM G3D/G3DL2 clocks

Local only (not for upstream). The GPU node used the 24.576 MHz
oscillator as its clock, but that was only a label: mainline has no
CMU_G3D driver, and the GPU really ran at the ACPM boot rate of
151 MHz with no frequency scaling. panfrost's devfreq stayed off because
gs101_data listed four supplies.

ACPM firmware sets the GPU voltages itself. Tested with a module
setting the ACPM clocks (2026-10-08): vdd_g3d_l2 600->731 mV and
vdd_g3d 600->663 mV followed the rate with no Linux consumer, and fps
went from 52 to 155 at 750/572 MHz with no hang. The vendor GPU node
(gs101-gpu.dtsi) has no regulators either, only gpu0/gpu1_cmu_cal_id.

- GPU clocks are now <ACPM G3D> ("core", shaders) and <ACPM G3DL2>
  ("bus", L2/tiler). There are no supplies (all GPU rails are
  always-on).
- The OPP table is single-clock on G3D: 151/302/455/572 MHz, the
  vendor gpu_dvfs_table_v1 shader rates capped at 572 MHz. devfreq
  can't use a two-clock OPP table (find_freq asserts a single clock).
- panfrost gets an optional opp_config_clks hook. gs101's sets the
  paired vendor L2 rate (302/434/603/750) and keeps L2 >= G3D: raise L2
  first, lower G3D first, as in pixel_gpu_dvfs.c.
- gpu-thermal zone on TMU probe 11 (there's no GPU sensor; GPU load
  warms all TMU_TOP probes alike, probe 11 the most): devfreq cooling
  from 75 C, lowest OPP from 85 C, critical at 110 C.
---
diff --git a/arch/arm64/boot/dts/exynos/google/gs101-pixel-common.dtsi b/arch/arm64/boot/dts/exynos/google/gs101-pixel-common.dtsi
index 633312d24..d001e2f5f 100644
--- a/arch/arm64/boot/dts/exynos/google/gs101-pixel-common.dtsi
+++ b/arch/arm64/boot/dts/exynos/google/gs101-pixel-common.dtsi
@@ -1105,13 +1105,6 @@ eeprom: eeprom@50 {
 	};
 };
 
-&gpu {
-     mali-supply = <&buck2s_reg>;
-     buck8s-supply = <&buck8s_reg>;
-     ldo1s-supply = <&ldo1s_reg>;
-     buck7m-supply = <&buck7m_reg>;
-};
-
 &hsi2c_12 {
 	status = "okay";
 	/* TODO: add the devices once drivers exist */
diff --git a/arch/arm64/boot/dts/exynos/google/gs101.dtsi b/arch/arm64/boot/dts/exynos/google/gs101.dtsi
index e6fbc285d..0cb0bd36a 100644
--- a/arch/arm64/boot/dts/exynos/google/gs101.dtsi
+++ b/arch/arm64/boot/dts/exynos/google/gs101.dtsi
@@ -475,6 +475,30 @@ opp-2802000000 {
 		};
 	};
 
+	/*
+	 * Shader (G3D) rates of the vendor gpu_dvfs_table_v1, capped at
+	 * 572 MHz for now (the vendor table goes to 670 MHz).
+	 */
+	gpu_opp_table: opp-table-gpu {
+		compatible = "operating-points-v2";
+
+		opp-151000000 {
+			opp-hz = /bits/ 64 <151000000>;
+		};
+
+		opp-302000000 {
+			opp-hz = /bits/ 64 <302000000>;
+		};
+
+		opp-455000000 {
+			opp-hz = /bits/ 64 <455000000>;
+		};
+
+		opp-572000000 {
+			opp-hz = /bits/ 64 <572000000>;
+		};
+	};
+
 	/* ect node is required to be present by bootloader */
 	ect {
 	};
@@ -2392,25 +2416,16 @@ gpu: gpu@1c500000 {
 			reg = <0x1c500000 0x5000>;
 
 			/*
-			 * The oscillator, deliberately, and it means the GPU
-			 * runs at 24.576 MHz. The real clock is an ACPM DVFS
-			 * one, <&acpm_ipc GS101_CLK_ACPM_DVFS_G3D>, which the
-			 * vendor selects through gpu1_cmu_cal_id rather than a
-			 * phandle; clk_summary shows g3d and g3dl2 sitting at
-			 * 151 MHz with an enable count of zero while oscclk has
-			 * 1c500000.gpu as its consumer.
-			 *
-			 * Switching to it was tried and reverted: the GPU then
-			 * runs at 151 MHz on whatever voltage the bootloader
-			 * left, because nothing couples frequency to the
-			 * regulator. panfrost's devfreq, which would do that,
-			 * bails out with "More than 1 supply is not supported
-			 * yet" -- gs101_data in its compatible table declares
-			 * several. The device dies under load as a result.
-			 *
-			 * So this line waits on GPU DVFS, not on the clock.
+			 * ACPM DVFS clocks: G3D drives the shader cores, G3DL2 the
+			 * L2/tiler ("bus"). ACPM firmware sets vdd_g3d/vdd_g3d_l2 for
+			 * each rate itself, so there is no supply here; panfrost's
+			 * gs101 hook sets the vendor L2 rate paired with each G3D OPP.
 			 */
-			clocks = <&ext_24_5m>;
+			clocks = <&acpm_ipc GS101_CLK_ACPM_DVFS_G3D>,
+				 <&acpm_ipc GS101_CLK_ACPM_DVFS_G3DL2>;
+			clock-names = "core", "bus";
+			operating-points-v2 = <&gpu_opp_table>;
+			#cooling-cells = <2>;
 			interrupt-names = "job", "mmu", "gpu";
 			interrupts = <GIC_SPI 420 IRQ_TYPE_LEVEL_HIGH 0>,
 				     <GIC_SPI 421 IRQ_TYPE_LEVEL_HIGH 0>,
@@ -2797,10 +2812,48 @@ tmu-probe10-thermal {
 			thermal-sensors = <&tmu_cpu 10>;
 		};
 
-		tmu-probe11-thermal {
-			polling-delay-passive = <0>;
-			polling-delay = <0>;
+		/*
+		 * No sensor sits on the GPU (that is TMU_SUB). GPU load warms
+		 * every TMU_TOP probe by about the same amount; probe 11 rises
+		 * the most (+12 C in 30 s at 572 MHz).
+		 */
+		gpu-thermal {
+			polling-delay-passive = <100>;
+			polling-delay = <250>;
 			thermal-sensors = <&tmu_cpu 11>;
+
+			trips {
+				gpu_warm: warm {
+					temperature = <75000>;
+					hysteresis = <5000>;
+					type = "passive";
+				};
+
+				gpu_hot: hot {
+					temperature = <85000>;
+					hysteresis = <5000>;
+					type = "passive";
+				};
+
+				gpu_crit: critical {
+					temperature = <110000>;
+					hysteresis = <0>;
+					type = "critical";
+				};
+			};
+
+			cooling-maps {
+				map0 {
+					trip = <&gpu_warm>;
+					cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+				};
+
+				/* Lowest OPP from 85 C. */
+				map1 {
+					trip = <&gpu_hot>;
+					cooling-device = <&gpu 3 3>;
+				};
+			};
 		};
 	};
 };
diff --git a/drivers/gpu/drm/panfrost/panfrost_devfreq.c b/drivers/gpu/drm/panfrost/panfrost_devfreq.c
index b51c30778..c355135c6 100644
--- a/drivers/gpu/drm/panfrost/panfrost_devfreq.c
+++ b/drivers/gpu/drm/panfrost/panfrost_devfreq.c
@@ -150,6 +150,21 @@ int panfrost_devfreq_init(struct panfrost_device *pfdev)
 		}
 	}
 
+	if (pfdev->comp->opp_config_clks) {
+		/* { NULL, NULL }: the device's single unnamed (first) clock */
+		static const char * const clk_names[] = { NULL, NULL };
+		struct dev_pm_opp_config config = {
+			.clk_names = clk_names,
+			.config_clks = pfdev->comp->opp_config_clks,
+		};
+
+		ret = devm_pm_opp_set_config(dev, &config);
+		if (ret) {
+			DRM_DEV_ERROR(dev, "Couldn't set OPP clock config\n");
+			return ret;
+		}
+	}
+
 	ret = devm_pm_opp_of_add_table(dev);
 	if (ret) {
 		/* Optional, continue without devfreq */
diff --git a/drivers/gpu/drm/panfrost/panfrost_device.h b/drivers/gpu/drm/panfrost/panfrost_device.h
index ec55c136b..18a9af810 100644
--- a/drivers/gpu/drm/panfrost/panfrost_device.h
+++ b/drivers/gpu/drm/panfrost/panfrost_device.h
@@ -8,6 +8,7 @@
 #include <linux/atomic.h>
 #include <linux/io-pgtable.h>
 #include <linux/pm.h>
+#include <linux/pm_opp.h>
 #include <linux/regulator/consumer.h>
 #include <linux/spinlock.h>
 #include <drm/drm_auth.h>
@@ -115,6 +116,9 @@ struct panfrost_compatible {
 
 	/* GPU configuration quirks */
 	u8 gpu_quirks;
+
+	/* Optional OPP clock callback, for SoCs that pair a second clock */
+	config_clks_t opp_config_clks;
 };
 
 /**
diff --git a/drivers/gpu/drm/panfrost/panfrost_drv.c b/drivers/gpu/drm/panfrost/panfrost_drv.c
index 3d57cc8d5..ab37603c3 100644
--- a/drivers/gpu/drm/panfrost/panfrost_drv.c
+++ b/drivers/gpu/drm/panfrost/panfrost_drv.c
@@ -7,6 +7,7 @@
 #include <asm/arch_timer.h>
 #endif
 
+#include <linux/clk.h>
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/pagemap.h>
@@ -1078,12 +1079,63 @@ static const struct panfrost_compatible default_data = {
 	.pm_domain_names = NULL,
 };
 
-static const char * const gs101_supplies[] = { "mali", "buck8s", "ldo1s", "buck7m", NULL };
+/*
+ * gs101 G3D (shaders, "core") and G3DL2 (L2/tiler, "bus") are ACPM DVFS
+ * clocks; the ACPM firmware sets the GPU voltages for each rate, so there
+ * are no supplies. Each G3D rate is paired with the vendor
+ * gpu_dvfs_table_v1 L2 rate, and L2 must never drop below G3D: raise L2
+ * first, lower G3D first.
+ */
+static const struct {
+	unsigned long g3d;
+	unsigned long l2;
+} gs101_l2_rates[] = {
+	{ 151000000, 302000000 },
+	{ 302000000, 434000000 },
+	{ 455000000, 603000000 },
+	{ 572000000, 750000000 },
+	{ 670000000, 996000000 },
+};
+
+static int gs101_opp_config_clks(struct device *dev, struct opp_table *opp_table,
+				 struct dev_pm_opp *opp, void *data, bool scaling_down)
+{
+	struct panfrost_device *pfdev = dev_get_drvdata(dev);
+	unsigned long *target = data;
+	unsigned long g3d, l2;
+	int i, ret;
+
+	g3d = target ? *target : dev_pm_opp_get_freq(opp);
+
+	l2 = gs101_l2_rates[ARRAY_SIZE(gs101_l2_rates) - 1].l2;
+	for (i = 0; i < ARRAY_SIZE(gs101_l2_rates); i++) {
+		if (g3d <= gs101_l2_rates[i].g3d) {
+			l2 = gs101_l2_rates[i].l2;
+			break;
+		}
+	}
+
+	if (scaling_down) {
+		ret = clk_set_rate(pfdev->clock, g3d);
+		if (!ret)
+			ret = clk_set_rate(pfdev->bus_clock, l2);
+	} else {
+		ret = clk_set_rate(pfdev->bus_clock, l2);
+		if (!ret)
+			ret = clk_set_rate(pfdev->clock, g3d);
+	}
+	if (ret)
+		dev_err(dev, "failed to set G3D %lu / L2 %lu: %d\n", g3d, l2, ret);
+
+	return ret;
+}
+
 static const struct panfrost_compatible gs101_data = {
-	.num_supplies = ARRAY_SIZE(gs101_supplies) - 1,
-	.supply_names = gs101_supplies,
+	.num_supplies = 0,
+	.supply_names = NULL,
 	.num_pm_domains = 1, /* optional */
 	.pm_domain_names = NULL,
+	.opp_config_clks = gs101_opp_config_clks,
 };
 
 
