# Samsung SysMMU v8. The DECON sits behind sysmmu_dpu0; without this driver
# gs101-drm only binds after the deferred-probe timeout and cannot allocate
# scanout buffers. Its Kconfig is not sourced from the main tree.
_iommu_config="
	CONFIG_SAMSUNG_IOMMU=m
	CONFIG_SAMSUNG_IOMMU_GROUP=m
"

# Speaker audio (see aoc/info.txt in the tree): the AoC DSP plays to the
# cs35l41 amps over TDM_0. AoC firmware is loaded through GSA and AoC talks
# to the Trusty hwmgr, so trusty and gsa build first and aoc links against
# their symbols. None of these Kconfigs are sourced from the main tree.
_audio_config="
	CONFIG_TRUSTY=m
	CONFIG_TRUSTY_IRQ=y
	CONFIG_TRUSTY_LOG=m
	CONFIG_TRUSTY_VIRTIO=m
	CONFIG_TRUSTY_VIRTIO_IPC=m
	CONFIG_GSA=m
	CONFIG_WC_MBOX=m
	CONFIG_AOC_DRIVER=m
	CONFIG_AOC_CHAR_DRIVER=m
	CONFIG_AOC_CHAN_DRIVER=m
	CONFIG_AOC_CONTROL_DRIVER=m
"
_audio_dirs="trusty gsa aoc cs35l41dna"

# Broadcom BCM4775 GNSS on spi10 (see gps/Kbuild in the tree): exposes
# /dev/ttyBCM and /dev/bbd_*, which the GNSS userspace talks to. The
# receiver's LDOs are kept on by patch 0029, its chip select is a GPIO
# (0030). Kconfig not sourced either.
_gps_config="
	CONFIG_BCM_GPS_SPI_DRIVER=m
	CONFIG_BCM_GPS_PPS_DRIVER=m
"

# Shannon s5123 modem on pcie0 (see modem/Kbuild in the tree): M8's trimmed
# cpif port. The CP itself is booted from userspace (tinycbd), so cpif is
# blacklisted below and loaded by hand while this is being brought up.
_modem_config="
	CONFIG_EXYNOS_MODEM_IF=m
	CONFIG_SHM_IPC=m
	CONFIG_BOOT_DEVICE_SPI=m
"

# v4l2loopback (out of tree): waydroid-camerad feeds the cameras to
# Waydroid's external camera HAL through loopback devices. Built here so it
# always matches the kernel. The .diff (not a kernel .patch) lets the writer
# set a smaller buffer size for MJPEG: Android rejects anything above w*h*2.

# modpost rejects KBUILD_EXTRA_SYMBOLS files that do not exist yet, so only
# aoc gets the trusty and gsa symbol tables.
_audio_extra_symbols() {
	[ "$1" = aoc ] || return 0
	echo "$builddir/trusty/Module.symvers $builddir/gsa/Module.symvers"
}

prepare() {
	default_prepare
	patch -d "$srcdir/v4l2loopback-$_v4l2loopback" -p1 \
		< "$srcdir"/v4l2loopback-compressed-sizeimage.diff
	cp "$srcdir/config-$_flavor.$CARCH" .config
	echo "$_extra_config" >> .config

	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 olddefconfig

	local opt
	for opt in DRM_GS101=m TENSOR_TMU=y BATTERY_MAX17042=m PCIE_GS101=y \
			NF_TABLES=m NF_TABLES_INET=y NFT_CT=m NFT_REJECT_INET=m \
			ZRAM=m ZRAM_BACKEND_ZSTD=y PM_SLEEP_DEBUG=y BOOT_CONFIG=y \
			IP_MULTIPLE_TABLES=y IPV6_MULTIPLE_TABLES=y NF_CONNTRACK_MARK=y \
			HARDLOCKUP_DETECTOR=y SOFTLOCKUP_DETECTOR=y PANIC_TIMEOUT=5 \
			UCLAMP_TASK_GROUP=y CPU_IDLE_GOV_TEO=y LRU_GEN_ENABLED=y \
			GPIO_S2MPG1X=m REGULATOR_SLG51000=m PHY_EXYNOS_MIPI_CSIS_GS101=m \
			VIDEO_GS101_MIPI_CSIS=m VIDEO_IMX355=m VIDEO_S5KGN1=m \
			VIDEO_IMX386=m VIDEO_LM3644=m VL53L1X_I2C=m INPUT_CS40L2X=m \
			HIDRAW=y INPUT_JOYDEV=m JOYSTICK_XPAD=m HID_PLAYSTATION=m \
			HID_SONY=m HID_STEAM=m HID_NINTENDO=m HID_MICROSOFT=m; do
		grep -q "^CONFIG_$opt\$" .config || { error "CONFIG_$opt dropped by olddefconfig"; return 1; }
	done
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-postmarketOS"

	# Google's bcmdhd for the BCM4389 Wi-Fi (brcmfmac is blacklisted).
	make -C "$builddir" M="$builddir/bcmdhd" \
		BCMDHD_ROOT="$builddir/bcmdhd" modules \
		ARCH="$_carch" LLVM=1

	make -C "$builddir" M="$builddir/samsung-iommu" modules \
		ARCH="$_carch" LLVM=1 \
		$_iommu_config

	make -C "$builddir" M="$builddir/modem" modules \
		ARCH="$_carch" LLVM=1 \
		$_modem_config

	make -C "$builddir" M="$builddir/gps" modules \
		ARCH="$_carch" LLVM=1 \
		$_gps_config

	local d
	for d in $_audio_dirs; do
		make -C "$builddir" M="$builddir/$d" modules \
			ARCH="$_carch" LLVM=1 \
			KBUILD_EXTRA_SYMBOLS="$(_audio_extra_symbols $d)" \
			$_audio_config
	done

	make -C "$builddir" M="$srcdir/v4l2loopback-$_v4l2loopback" modules \
		ARCH="$_carch" LLVM=1
}

package() {
	mkdir -p "$pkgdir"/boot

	make Image.lz4 modules_install dtbs_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_PATH="$pkgdir"/boot \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs

	make -C "$builddir" M="$builddir/bcmdhd" \
		BCMDHD_ROOT="$builddir/bcmdhd" modules_install \
		ARCH="$_carch" LLVM=1 \
		INSTALL_MOD_PATH="$pkgdir"/usr INSTALL_MOD_STRIP=1

	make -C "$builddir" M="$builddir/samsung-iommu" modules_install \
		ARCH="$_carch" LLVM=1 \
		$_iommu_config \
		INSTALL_MOD_PATH="$pkgdir"/usr INSTALL_MOD_STRIP=1

	make -C "$builddir" M="$builddir/modem" modules_install \
		ARCH="$_carch" LLVM=1 \
		$_modem_config \
		INSTALL_MOD_PATH="$pkgdir"/usr INSTALL_MOD_STRIP=1

	make -C "$builddir" M="$builddir/gps" modules_install \
		ARCH="$_carch" LLVM=1 \
		$_gps_config \
		INSTALL_MOD_PATH="$pkgdir"/usr INSTALL_MOD_STRIP=1

	local d
	for d in $_audio_dirs; do
		make -C "$builddir" M="$builddir/$d" modules_install \
			ARCH="$_carch" LLVM=1 \
			KBUILD_EXTRA_SYMBOLS="$(_audio_extra_symbols $d)" \
			$_audio_config \
			INSTALL_MOD_PATH="$pkgdir"/usr INSTALL_MOD_STRIP=1
	done

	make -C "$builddir" M="$srcdir/v4l2loopback-$_v4l2loopback" modules_install \
		ARCH="$_carch" LLVM=1 \
		INSTALL_MOD_PATH="$pkgdir"/usr INSTALL_MOD_STRIP=1

	rm -f "$pkgdir"/lib/modules/*/build "$pkgdir"/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release

	install -Dm644 "$builddir/arch/$_carch/boot/Image.lz4" \
		"$pkgdir/boot/vmlinuz"
	# EFI stub image for systemd-boot (U-Boot's EFI); vmlinuz stays for
	# boot.img and U-Boot's direct boot
	install -Dm644 "$builddir/arch/$_carch/boot/Image" \
		"$pkgdir/boot/vmlinuz.efi"

	mkdir -p "$pkgdir"/etc/modprobe.d
	echo "blacklist brcmfmac" > "$pkgdir"/etc/modprobe.d/gs101-blacklist-brcmfmac.conf
	echo "blacklist cpif" > "$pkgdir"/etc/modprobe.d/gs101-blacklist-cpif.conf
}

