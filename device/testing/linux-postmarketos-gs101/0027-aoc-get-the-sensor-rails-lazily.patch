From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Noswad <64293615+TheNoswad@users.noreply.github.com>
Date: Sat, 10 Oct 2026 17:40:00 -0500
Subject: [PATCH] aoc: get the sensor rails lazily

At aoc_core probe devm_regulator_get_exclusive() of sensor_1v8/sensor_3v3
(s2mpg11 ldo7s/ldo6s) fails on oriole ("failed to get sensor_1v8
regulator."), the same gets succeed later. The pointers stayed NULL, so
vdd_sensors was never enabled and the AoC sensor hub probed its I2C
sensors (TMD3719 ALS/prox, LSM6DSR, ...) unpowered.

Get missing rails in configure_sensor_regulator() on every enable and
log the error code. Writing 1 to the aoc sensor_power_enable attribute
retries (oriole-sensors does that before loading the USF registry).
---
 aoc/aoc.c | 39 +++++++++++++++++++++++++++++++--------
 1 file changed, 31 insertions(+), 8 deletions(-)

diff --git a/aoc/aoc.c b/aoc/aoc.c
index 3e98d4819..63992f9a8 100644
--- a/aoc/aoc.c
+++ b/aoc/aoc.c
@@ -1994,10 +1994,38 @@ static void aoc_did_become_online(struct work_struct *work)
 	mutex_unlock(&aoc_service_lock);
 }
 
+/*
+ * Get the sensor rails that are still missing. At aoc probe time the
+ * s2mpg11 LDOs are sometimes not ready, and without them the AoC sensor
+ * hub (USF) probes its I2C sensors unpowered. Retry on every enable.
+ */
+static void aoc_get_sensor_regulators(struct aoc_prvdata *prvdata)
+{
+	struct regulator *reg;
+	int i;
+
+	for (i = 0; i < prvdata->sensor_power_count; i++) {
+		if (prvdata->sensor_regulator[i])
+			continue;
+		reg = devm_regulator_get_exclusive(prvdata->dev,
+						   prvdata->sensor_power_list[i]);
+		if (IS_ERR_OR_NULL(reg)) {
+			pr_err("failed to get %s regulator: %ld\n",
+			       prvdata->sensor_power_list[i], PTR_ERR(reg));
+			continue;
+		}
+		prvdata->sensor_regulator[i] = reg;
+	}
+}
+
 static bool configure_sensor_regulator(struct aoc_prvdata *prvdata, bool enable)
 {
 	bool check_enabled;
 	int i;
+
+	if (enable)
+		aoc_get_sensor_regulators(prvdata);
+
 	if (enable) {
 		check_enabled = true;
 		for (i = 0; i < prvdata->sensor_power_count; i++) {
@@ -3617,14 +3645,9 @@ static int aoc_platform_probe(struct platform_device *pdev)
 					    (const char**)&prvdata->sensor_power_list,
 					    prvdata->sensor_power_count);
 
-	for (i = 0; i < prvdata->sensor_power_count; i++) {
-		prvdata->sensor_regulator[i] =
-				devm_regulator_get_exclusive(dev, prvdata->sensor_power_list[i]);
-		if (IS_ERR_OR_NULL(prvdata->sensor_regulator[i])) {
-			prvdata->sensor_regulator[i] = NULL;
-			pr_err("failed to get %s regulator.", prvdata->sensor_power_list[i]);
-		}
-	}
+	/* configure_sensor_regulator() gets the rails, and retries later. */
+	for (i = 0; i < prvdata->sensor_power_count; i++)
+		prvdata->sensor_regulator[i] = NULL;
 
 	reset_sensor_power(prvdata, true);
 
