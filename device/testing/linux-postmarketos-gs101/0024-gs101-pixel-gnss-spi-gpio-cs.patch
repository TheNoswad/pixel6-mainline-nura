From: Noswad <64293615+TheNoswad@users.noreply.github.com>
Subject: [PATCH] arm64: dts: gs101-pixel: GNSS SPI chip select as a GPIO

spi-s3c64xx runs the gs101 native chip select in auto mode. The BCM4775
never answers on it: every byte on MISO reads 0, the driver sees no room
in the receiver's ring buffer and never sends lhd's packets. With gpp10-3
driven as a GPIO and held for the whole transfer the receiver answers at
once (status 0x19), syncs and takes the 336 KB SensorHub patch with no
retries.

Mux gpp10-3 as a plain output and give spi_5 cs-gpios, so the SPI core
holds CS across each message.
---
--- a/arch/arm64/boot/dts/exynos/google/gs101-pixel-common.dtsi
+++ b/arch/arm64/boot/dts/exynos/google/gs101-pixel-common.dtsi
@@ -1913,6 +1913,11 @@
  * The vendor also sets dma-mode, a pdma0 channel pair and swap-mode on the
  * controller. Those are properties of its own SPI driver; mainline's
  * spi-s3c64xx has no equivalent, so the transfers run PIO here.
+ *
+ * Chip select is a GPIO: spi-s3c64xx drives the gs101 native CS in auto mode,
+ * which the BCM4775 never sees as a select (MISO stays low). The receiver
+ * needs CS held for the whole SSI frame, which the SPI core does with
+ * cs-gpios.
  */
 &usi5 {
 	samsung,mode = <USI_MODE_SPI>;
@@ -1923,7 +1928,8 @@
 	#address-cells = <1>;
 	#size-cells = <0>;
 	pinctrl-names = "default";
-	pinctrl-0 = <&spi5_bus>, <&spi5_cs_func>;
+	pinctrl-0 = <&spi5_bus>, <&gps_spi_cs>;
+	cs-gpios = <&gpp10 3 GPIO_ACTIVE_LOW>;
 	status = "okay";
 
 	gnss: bcm4775@0 {
@@ -1972,6 +1978,13 @@
 };
 
 &pinctrl_peric0 {
+	gps_spi_cs: gps-spi-cs-pins {
+		samsung,pins = "gpp10-3";
+		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
+		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
+	};
+
 	gps_mcu_req: gps-mcu-req-pins {
 		samsung,pins = "gpp1-1";
 		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
