From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Noswad <64293615+TheNoswad@users.noreply.github.com>
Date: Sun, 11 Oct 2026 01:18:13 -0500
Subject: [PATCH] panfrost: gs101: don't power the GPU up before cpufreq

About half of the boots on r17-r20 came up without a display: the
first GPU power-up at probe fails ("error powering up gpu shader",
"shader/l2 power transition timeout") and every later soft and hard
reset times out until a cold boot. The journal (58 boots) ties it to
probe order: panfrost and cpufreq-dt both defer on the ACPM clocks and
race when clk-acpm loads. With panfrost first, 20 of 27 boots were bad;
with cpufreq first, 4 of 31, and all 4 had cpufreq finishing less than
21 ms earlier. The cause inside ACPM is unknown. Skipping the boot-time
G3DL2 rate change (r21) did not help.

On gs101, defer the probe until every CPU has a cpufreq policy
(cpufreq-dt binding retries deferred probes), then wait 100 ms more
before the first GPU access.
---
 drivers/gpu/drm/panfrost/panfrost_device.h |  3 ++
 drivers/gpu/drm/panfrost/panfrost_drv.c    | 36 ++++++++++++++++++++++
 2 files changed, 39 insertions(+)

diff --git a/drivers/gpu/drm/panfrost/panfrost_device.h b/drivers/gpu/drm/panfrost/panfrost_device.h
index 18a9af810..928b81f13 100644
--- a/drivers/gpu/drm/panfrost/panfrost_device.h
+++ b/drivers/gpu/drm/panfrost/panfrost_device.h
@@ -119,6 +119,9 @@ struct panfrost_compatible {
 
 	/* Optional OPP clock callback, for SoCs that pair a second clock */
 	config_clks_t opp_config_clks;
+
+	/* Don't power the GPU up before cpufreq runs on every CPU */
+	bool wait_for_cpufreq;
 };
 
 /**
diff --git a/drivers/gpu/drm/panfrost/panfrost_drv.c b/drivers/gpu/drm/panfrost/panfrost_drv.c
index ab37603c3..30f4dfcdc 100644
--- a/drivers/gpu/drm/panfrost/panfrost_drv.c
+++ b/drivers/gpu/drm/panfrost/panfrost_drv.c
@@ -8,6 +8,8 @@
 #endif
 
 #include <linux/clk.h>
+#include <linux/cpufreq.h>
+#include <linux/delay.h>
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/pagemap.h>
@@ -961,6 +963,33 @@ module_param_named(transparent_hugepage, panfrost_transparent_hugepage, bool, 04
 MODULE_PARM_DESC(transparent_hugepage, "Use a dedicated tmpfs mount point with Transparent Hugepage enabled (true = default)");
 #endif
 
+/*
+ * gs101: the GPU's first power-up must come after cpufreq has started on
+ * all clusters. When panfrost probed first (both wait for the ACPM
+ * clocks), 20 of 27 boots wedged the GPU at its first power-up ("error
+ * powering up gpu shader", soft and hard reset time out, no display until
+ * a cold boot). Only 4 of 31 boots with cpufreq first did, all with
+ * cpufreq finishing less than 21 ms before panfrost. Wait for every CPU's
+ * policy (cpufreq-dt binding retries the deferred probe), then let the
+ * first ACPM CPU DVFS requests settle.
+ */
+static int panfrost_wait_for_cpufreq(struct device *dev)
+{
+	struct cpufreq_policy *policy;
+	unsigned int cpu;
+
+	for_each_possible_cpu(cpu) {
+		policy = cpufreq_cpu_get(cpu);
+		if (!policy)
+			return dev_err_probe(dev, -EPROBE_DEFER,
+					     "waiting for cpufreq on CPU%u\n", cpu);
+		cpufreq_cpu_put(policy);
+	}
+
+	msleep(100);
+	return 0;
+}
+
 static int panfrost_probe(struct platform_device *pdev)
 {
 	struct panfrost_device *pfdev;
@@ -977,6 +1006,12 @@ static int panfrost_probe(struct platform_device *pdev)
 	if (!pfdev->comp)
 		return -ENODEV;
 
+	if (pfdev->comp->wait_for_cpufreq) {
+		err = panfrost_wait_for_cpufreq(&pdev->dev);
+		if (err)
+			return err;
+	}
+
 	pfdev->coherent = device_get_dma_attr(&pdev->dev) == DEV_DMA_COHERENT;
 
 	mutex_init(&pfdev->shrinker_lock);
@@ -1136,6 +1171,7 @@ static const struct panfrost_compatible gs101_data = {
 	.num_pm_domains = 1, /* optional */
 	.pm_domain_names = NULL,
 	.opp_config_clks = gs101_opp_config_clks,
+	.wait_for_cpufreq = true,
 };
 
 
