# SPDX-License-Identifier: MIT
# Local (oriole): the rear main sensor is not usable yet, and apps tend to
# open the first back camera by default.
# - S5KGN1 (main): the C-PHY link never delivers a clean frame (CSIS
#   ERR_FS/ERR_FE, all-zero buffers).
# Keep it from binding so that only the working cameras (front IMX355,
# ultra-wide IMX386) are offered. `modprobe s5kgn1` still loads it by hand.
blacklist s5kgn1
