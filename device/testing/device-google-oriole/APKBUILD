build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm644 "$srcdir"/90-s2idle.conf \
		"$pkgdir"/usr/lib/systemd/sleep.conf.d/90-s2idle.conf
	install -Dm644 "$srcdir"/oriole-s2idle.tmpfiles \
		"$pkgdir"/usr/lib/tmpfiles.d/oriole-s2idle.conf
	install -Dm644 "$srcdir"/90-bcmdhd-unmanaged.conf \
		"$pkgdir"/usr/lib/NetworkManager/conf.d/90-bcmdhd-unmanaged.conf
	install -Dm644 "$srcdir"/90-oriole-flatpak-gl.conf \
		"$pkgdir"/usr/lib/environment.d/90-oriole-flatpak-gl.conf
	install -Dm644 "$srcdir"/90-oriole-sched.conf \
		"$pkgdir"/usr/lib/sysctl.d/90-oriole-sched.conf
	install -Dm644 "$srcdir"/90-oriole-lockup.conf \
		"$pkgdir"/usr/lib/sysctl.d/90-oriole-lockup.conf
	# legacy iptables for Android's netd in Waydroid (the container cannot
	# load modules)
	install -Dm644 "$srcdir"/oriole-waydroid-netfilter.conf \
		"$pkgdir"/usr/lib/modules-load.d/oriole-waydroid-netfilter.conf
	install -Dm755 "$srcdir"/oriole-ui-uclamp \
		"$pkgdir"/usr/libexec/oriole-ui-uclamp
	install -Dm644 "$srcdir"/oriole-ui-uclamp.service \
		"$pkgdir"/usr/lib/systemd/user/oriole-ui-uclamp.service
	local w
	for w in mobi.phosh.Shell mobi.phosh.Phrog; do
		mkdir -p "$pkgdir"/usr/lib/systemd/user/$w.service.wants
		ln -s ../oriole-ui-uclamp.service \
			"$pkgdir"/usr/lib/systemd/user/$w.service.wants/
	done
	install -Dm644 -t "$pkgdir"/usr/lib/systemd/system \
		"$srcdir"/oriole-charger.target "$srcdir"/oriole-charger.service \
		"$srcdir"/oriole-charger-detect.service \
		"$srcdir"/oriole-reboot-mark.service
	install -d "$pkgdir"/usr/lib/systemd/system/sysinit.target.wants
	ln -s ../oriole-reboot-mark.service \
		"$pkgdir"/usr/lib/systemd/system/sysinit.target.wants/
	install -Dm644 -t "$pkgdir"/usr/lib/systemd/system \
		"$srcdir"/oriole-cpufreq-ratelimit.service
	install -d "$pkgdir"/usr/lib/systemd/system/multi-user.target.wants
	ln -s ../oriole-cpufreq-ratelimit.service \
		"$pkgdir"/usr/lib/systemd/system/multi-user.target.wants/
	install -d "$pkgdir"/usr/lib/systemd/system/graphical.target.wants
	ln -s ../oriole-charger-detect.service \
		"$pkgdir"/usr/lib/systemd/system/graphical.target.wants/
	install -Dm755 "$srcdir"/oriole-bcmdhd-sleep \
		"$pkgdir"/usr/lib/systemd/system-sleep/oriole-bcmdhd
	install -Dm755 -t "$pkgdir"/usr/libexec \
		"$srcdir"/oriole-charger-monitor "$srcdir"/oriole-charger-detect

	# cameras: dma-buf heap for libcamera's software ISP, the raw CSIS
	# nodes hidden from PipeWire, the not yet working rear sensors unbound
	install -Dm644 "$srcdir"/oriole-camera.modules-load \
		"$pkgdir"/usr/lib/modules-load.d/oriole-camera.conf
	install -Dm644 "$srcdir"/90-oriole-camera.rules \
		"$pkgdir"/usr/lib/udev/rules.d/90-oriole-camera.rules
	install -Dm644 "$srcdir"/90-oriole-camera.wireplumber.conf \
		"$pkgdir"/usr/share/wireplumber/wireplumber.conf.d/90-oriole-camera.conf
	install -Dm644 "$srcdir"/oriole-camera.modprobe \
		"$pkgdir"/usr/lib/modprobe.d/oriole-camera.conf

	# stock partitions: read-only at the block layer, persist mounted ro
	install -Dm644 "$srcdir"/61-oriole-stock-ro.rules \
		"$pkgdir"/usr/lib/udev/rules.d/61-oriole-stock-ro.rules
	install -Dm644 "$srcdir"/run-oriole-persist.mount \
		"$pkgdir"/usr/lib/systemd/system/run-oriole-persist.mount

	# haptics: feedbackd vibra device, factory calibration from persist
	install -Dm644 "$srcdir"/71-oriole-haptics.rules \
		"$pkgdir"/usr/lib/udev/rules.d/71-oriole-haptics.rules
	install -Dm755 "$srcdir"/oriole-haptics-cal \
		"$pkgdir"/usr/libexec/oriole-haptics-cal
	install -Dm644 "$srcdir"/oriole-haptics-cal.service \
		"$pkgdir"/usr/lib/systemd/system/oriole-haptics-cal.service

	# speakers
	install -Dm755 "$srcdir"/oriole-speaker-setup \
		"$pkgdir"/usr/libexec/oriole-speaker-setup
	install -Dm644 "$srcdir"/oriole-speaker-setup.service \
		"$pkgdir"/usr/lib/systemd/system/oriole-speaker-setup.service
	install -d "$pkgdir"/usr/lib/systemd/system/sound.target.wants
	ln -s ../oriole-speaker-setup.service \
		"$pkgdir"/usr/lib/systemd/system/sound.target.wants/
	install -Dm644 "$srcdir"/oriole-audio.modprobe \
		"$pkgdir"/usr/lib/modprobe.d/oriole-audio.conf
	install -Dm644 "$srcdir"/90-oriole-audio.rules \
		"$pkgdir"/usr/lib/udev/rules.d/90-oriole-audio.rules
	install -Dm644 "$srcdir"/google-oriole-aoc.conf \
		"$pkgdir"/usr/share/pulseaudio/alsa-mixer/profile-sets/google-oriole-aoc.conf
	install -Dm644 "$srcdir"/google-oriole-aoc.conf \
		"$pkgdir"/usr/share/alsa-card-profile/mixer/profile-sets/google-oriole-aoc.conf
	install -Dm644 "$srcdir"/oriole-speaker-path.conf \
		"$pkgdir"/usr/share/pulseaudio/alsa-mixer/paths/oriole-speaker.conf
	install -Dm644 "$srcdir"/oriole-speaker-path.conf \
		"$pkgdir"/usr/share/alsa-card-profile/mixer/paths/oriole-speaker.conf
	install -Dm644 "$srcdir"/oriole-speaker.pa \
		"$pkgdir"/etc/pulse/default.pa.d/oriole-speaker.pa
	install -Dm755 "$srcdir"/oriole-pulse-speaker \
		"$pkgdir"/usr/libexec/oriole-pulse-speaker
	install -Dm644 "$srcdir"/oriole-pulse-speaker.service \
		"$pkgdir"/usr/lib/systemd/user/oriole-pulse-speaker.service
	install -d "$pkgdir"/usr/lib/systemd/user/default.target.wants
	ln -s ../oriole-pulse-speaker.service \
		"$pkgdir"/usr/lib/systemd/user/default.target.wants/
	install -Dm644 "$srcdir"/90-oriole-aoc.wireplumber.conf \
		"$pkgdir"/usr/share/wireplumber/wireplumber.conf.d/90-oriole-aoc.conf
	install -Dm644 "$srcdir"/90-oriole-bluetooth.wireplumber.conf \
		"$pkgdir"/usr/share/wireplumber/wireplumber.conf.d/90-oriole-bluetooth.conf
	install -Dm644 "$srcdir"/90-oriole-echo-cancel.conf \
		"$pkgdir"/usr/share/pipewire/pipewire.conf.d/90-oriole-echo-cancel.conf
	# ALSA UCM: media (HiFi) and calls (Voice Call, switched by callaudiod);
	# PipeWire prefers it over the ACP profile set above, which stays as the
	# fallback
	install -Dm644 "$srcdir"/ucm2-aoc-snd-card.conf \
		"$pkgdir"/usr/share/alsa/ucm2/conf.d/aoc-snd-card/aoc-snd-card.conf
	install -Dm644 "$srcdir"/ucm2-oriole-HiFi.conf \
		"$pkgdir"/usr/share/alsa/ucm2/Google/oriole/HiFi.conf
	install -Dm644 "$srcdir"/ucm2-oriole-VoiceCall.conf \
		"$pkgdir"/usr/share/alsa/ucm2/Google/oriole/VoiceCall.conf
	install -Dm644 "$srcdir"/80-device-google-oriole.preset \
		-t "$pkgdir"/usr/lib/systemd/system-preset/
	local u
	for u in alsa-restore alsa-state; do
		install -Dm644 "$srcdir"/oriole-alsa-restore.conf \
			"$pkgdir"/usr/lib/systemd/system/$u.service.d/oriole.conf
	done
}

